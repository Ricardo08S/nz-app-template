{
  "name": "nz-app-template",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "dev": "pnpm run --no-bail \"/^dev:.*/\"",
    "prod": "pnpm run --no-bail \"/^prod:.*/\"",
    "dev:server": "pnpm -F server dev",
    "dev:studio": "pnpm -F server db:studio",
    "dev:web": "pnpm -F web dev",
    "prod:server": "pnpm -F server dev:prod",
    "prod:studio": "pnpm -F server db:studio:prod",
    "prod:web": "pnpm -F web dev:prod"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.8.1",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "2.21.0",
    "typescript": "catalog:",
    "zod": "catalog:"
  }
}
