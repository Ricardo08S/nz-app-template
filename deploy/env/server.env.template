# Keys the server reads (see src/env.ts). Real values live SOPS-encrypted in
# deploy/env/<env>.server.env.enc — generate them with scripts/bootstrap.sh <env>,
# never by hand-filling this file.
APP_NAME="nz-app-template"
APP_ENV="localdev"
DATABASE_URL="postgresql://<user>:<password>@localhost:5432/$APP_NAME-$APP_ENV"
JWT_ACCESS_KEY="<32+ random chars>"
JWT_REFRESH_KEY="<32+ random chars>"
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="<silo access key>"
AWS_SECRET_ACCESS_KEY="<silo secret key>"
AWS_S3_BUCKET="$APP_NAME-$APP_ENV"
AWS_S3_ENDPOINT="http://127.0.0.1:9000"
OIDC_ISSUER="https://auth.example.com/application/o/$APP_NAME-$APP_ENV/"
OIDC_CLIENT_ID="<OIDC_CLIENT_ID>"
OIDC_CLIENT_SECRET="<OIDC_CLIENT_SECRET>"
OIDC_REDIRECT_URI="http://localhost:5173/auth/callback"
LOKI_URL="http://localhost:3100"
