# Plaintext, ikut di-git — tidak ada rahasia di sini.
# Satu file ini dibaca oleh .github/workflows/deploy-server.yml dan deploy-web.yml.

APP_NAME=nz-app-template
APP_ENV=production

# Placeholder — ganti ke domain nyata sebelum deploy pertama.
BASE_DOMAIN=nafkhan.id

# Perlu diisi alamat asli sebelum Caddy/certbot bisa minta sertifikat Let's Encrypt.
ACME_EMAIL=<FILL_WITH_REAL_EMAIL>

# Paths on the self-hosted runner host (also the deploy target — no separate
# VPS, no image registry: the runner builds the image and runs it in place).
CADDYFILE=/home/runner/kode/Caddyfile
CADDY_BIN=/usr/bin/caddy
STATE_DIR=/home/runner/kode/running-prod/nz-app-template-production-deploy-state

# Ports each blue/green slot binds to on 127.0.0.1 (must not collide with
# another app's slots on the same host — pick free ports per app).
SERVER_BLUE_PORT=40555
SERVER_GREEN_PORT=40556
WEB_BLUE_PORT=40557
WEB_GREEN_PORT=40558

# Centrally-hosted S3 (Garage) domain, shared across apps — web's .env has no
# secrets, so this (unlike DATABASE_URL/AWS_S3_ENDPOINT/OIDC_ISSUER, which
# live in apps/server/.env.production.enc) can sit here in plaintext.
CENTRAL_S3_DOMAIN=s3.your-domain.com

