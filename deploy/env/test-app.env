# Plaintext, ikut di-git — tidak ada rahasia di sini.
# Satu file ini dibaca oleh .github/workflows/deploy-server.yml dan deploy-web.yml.
# Sama seperti production.env, tapi buat branch `test-app` (uji coba manual/on-demand
# di VPS yang sama) — port dan STATE_DIR beda biar gak bentrok kalau production juga
# lagi jalan.

APP_NAME=nz-app-template
APP_ENV=test-app

BASE_DOMAIN=kizunara.com

CADDYFILE=/etc/caddy/Caddyfile
CADDY_APPS_DIR=/etc/caddy/apps
CADDY_BIN=/usr/bin/caddy
STATE_DIR=/home/ubuntu/kode/running-prod/nz-app-template-test-app-deploy-state

SERVER_BLUE_PORT=40575
SERVER_GREEN_PORT=40576
WEB_BLUE_PORT=40577
WEB_GREEN_PORT=40578

CENTRAL_S3_DOMAIN=s3.kizunara.com
