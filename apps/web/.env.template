APP_NAME="nz-app-template"
APP_ENV="development"
PUBLIC_ENVIRONMENT="$APP_ENV"
PUBLIC_LOCALE="en-US"
PUBLIC_BACKEND_URL="http://localhost:3001"
# Garage web endpoint: the bucket is the first label of the host, not a path.
PUBLIC_S3_ENDPOINT="http://$APP_NAME-$APP_ENV.web.localhost:3902"
PUBLIC_ENABLE_LOGGING=true
