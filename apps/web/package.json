{
  "name": "web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:production": "vite build --mode production",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "lint": "prettier --check .",
    "typecheck": "pnpm check",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:codegen": "playwright codegen",
    "test:record": "playwright codegen http://localhost:5173 --output tests/recorded.spec.ts",
    "test:record:user1": "playwright codegen http://localhost:5173 --output tests/_temp-user1.spec.ts",
    "test:record:user2": "playwright codegen http://localhost:5173 --output tests/_temp-user2.spec.ts",
    "test:report": "playwright show-report",
    "test:unit": "vitest run tests/unit",
    "test:unit:watch": "vitest tests/unit"
  },
  "devDependencies": {
    "@iconify/svelte": "5.2.2",
    "@playwright/test": "1.61.1",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.69.1",
    "@sveltejs/vite-plugin-svelte": "7.2.0",
    "@tailwindcss/forms": "0.5.11",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.2",
    "@tanstack/svelte-query": "6.1.36",
    "@tanstack/svelte-query-devtools": "6.1.36",
    "@trpc/client": "11.18.0",
    "@trpc/server": "11.18.0",
    "@zenstackhq/orm": "3.9.1",
    "@zenstackhq/tanstack-query": "3.9.1",
    "buffer": "6.0.3",
    "daisyui": "5.6.14",
    "nanoid": "5.1.16",
    "prettier": "3.9.4",
    "prettier-plugin-svelte": "4.1.1",
    "prettier-plugin-tailwindcss": "0.8.0",
    "server": "link:../server",
    "superjson": "2.2.6",
    "svelte": "5.56.4",
    "svelte-check": "4.7.2",
    "svelte-french-toast": "1.2.0",
    "tailwindcss": "4.3.2",
    "typescript": "6.0.3",
    "vite": "8.1.3",
    "vite-plugin-node-polyfills": "0.28.0",
    "vitest": "^4.1.10",
    "yaml": "2.9.0",
    "zenstack-trpc": "0.2.5",
    "zod": "4.4.3"
  }
}
