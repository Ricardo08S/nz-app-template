:80 {
	root * /srv
	encode zstd gzip

	respond /health/live 200

	# Rewritten by docker-entrypoint.sh at container start; never cache it.
	header /_app/env.js Cache-Control "no-store"

	# SvelteKit hashes these, so they can be cached forever.
	@immutable path /_app/immutable/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# SPA fallback.
	try_files {path} /index.html
	file_server {
		precompressed br gzip
	}
}
