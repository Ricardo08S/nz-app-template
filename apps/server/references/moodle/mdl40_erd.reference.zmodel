  UserEnrolmentsByUser UserEnrolments[] @relation(name: "user_enrolments_userid")
  UserEnrolmentsByModifier UserEnrolments[] @relation(name: "user_enrolments_modifierid")
  UserInfoData UserInfoData[]
  UserLastaccess UserLastaccess[]
  UserPasswordHistory UserPasswordHistory[]
  UserPasswordResets UserPasswordResets[]
  UserPreferences UserPreferences[]
  UserPrivateKey UserPrivateKey[]
  WikiLocks WikiLocks[]
  WikiPages WikiPages[]
  WikiSubwikis WikiSubwikis[]
  WikiVersions WikiVersions[]
  WorkshopAggregations WorkshopAggregations[]
  WorkshopAssessmentsByReviewer WorkshopAssessments[] @relation(name: "workshop_assessments_reviewerid")
  WorkshopAssessmentsByGradinggradeoverby WorkshopAssessments[] @relation(name: "workshop_assessments_gradinggradeoverby")
  WorkshopSubmissionsByAuthor WorkshopSubmissions[] @relation(name: "workshop_submissions_authorid")
  WorkshopSubmissionsByGradeoverby WorkshopSubmissions[] @relation(name: "workshop_submissions_gradeoverby")

  @@map("user")
}

// This table stores user's mobile devices information in order
model UserDevices {
  id BigInt @id @default(autoincrement())
  userid BigInt @default(0)
  appid String @default("") // the app id, usually something like com.moodle.moodlemobile
  name String @default("") // the device name, occam or iPhone etc..
  model String @default("") // the device model, Nexus 4 or iPad 1,1
  platform String @default("") // the device platform, Android or iOS etc
  version String @default("") // The device version, 6.1.2, 4.2.2 etc..
  pushid String @default("") // the device PUSH token/key/identifier/registration id
  uuid String @default("") // The device vendor UUID
  timecreated BigInt
  timemodified BigInt

  User User @relation(fields: [userid], references: [id])

  MessageAirnotifierDevices MessageAirnotifierDevices[]

  @@map("user_devices")
}

// Users participating in courses (aka enrolled users) - everyb
model UserEnrolments {
  id BigInt @id @default(autoincrement())
  status BigInt @default(0) // 0..9 are system constants, 0 means active participation, see ENROL_PARTICIPATION_* constants, plugins may define own status greater than 10
  enrolid BigInt
  userid BigInt
  timestart BigInt @default(0)
  timeend BigInt @default(2147483647)
  modifierid BigInt @default(0)
  timecreated BigInt @default(0)
  timemodified BigInt @default(0)

  Enrol Enrol @relation(fields: [enrolid], references: [id])
  User User @relation(name: "user_enrolments_userid", fields: [userid], references: [id])
  Modifier User @relation(name: "user_enrolments_modifierid", fields: [modifierid], references: [id])

  @@map("user_enrolments")
}

// Customisable fields categories
model UserInfoCategory {
  id BigInt @id @default(autoincrement())
  name String @default("") // Category name
  sortorder BigInt @default(0) // Display order

  UserInfoField UserInfoField[]

  @@map("user_info_category")
}

// Data for the customisable user fields
model UserInfoData {
  id BigInt @id @default(autoincrement())
  userid BigInt @default(0) // id from the user table
  fieldid BigInt @default(0) // id from the field table
  data String // Field data
  dataformat Int @default(0)

  User User @relation(fields: [userid], references: [id])

  @@map("user_info_data")
}

// Customisable user profile fields
model UserInfoField {
  id BigInt @id @default(autoincrement())
  shortname String @default("shortname") // short name for each field
  name String // field name
  datatype String @default("") // Type of data held in this field
  description String? // Description of field
  descriptionformat Int @default(0)
  categoryid BigInt @default(0) // id from category table
  sortorder BigInt @default(0) // order within the category
  required Int @default(0) // Field required
  locked Int @default(0) // Field locked
  visible Int @default(0) // Visibility: private, public, hidden
  forceunique Int @default(0) // should the field contain unique data
  signup Int @default(0) // display field on signup page
  defaultdata String? // Default value for this field
  defaultdataformat Int @default(0)
  param1 String? // General parameter field
  param2 String? // General parameter field
  param3 String? // General parameter field
  param4 String? // General parameter field
  param5 String? // General parameter field

  Category UserInfoCategory @relation(fields: [categoryid], references: [id])

  @@map("user_info_field")
}

// To keep track of course page access times, used in online pa
model UserLastaccess {
  id BigInt @id @default(autoincrement())
  userid BigInt @default(0)
  courseid BigInt @default(0)
  timeaccess BigInt @default(0)

  User User @relation(fields: [userid], references: [id])
  Course Course @relation(fields: [courseid], references: [id])

  @@map("user_lastaccess")
}

// A rotating log of hashes of previously used passwords for ea
model UserPasswordHistory {
  id BigInt @id @default(autoincrement())
  userid BigInt
  hash String @default("")
  timecreated BigInt

  User User @relation(fields: [userid], references: [id])

  @@map("user_password_history")
}

// table tracking password reset confirmation tokens
model UserPasswordResets {
  id BigInt @id @default(autoincrement())
  userid BigInt // id of the user account which requester claimed to be
  timerequested BigInt // The time that the user first requested this password reset
  timererequested BigInt @default(0) // The time the user re-requested the password reset.
  token String @default("") // secret set and emailed to user

  User User @relation(fields: [userid], references: [id])

  @@map("user_password_resets")
}

// Allows modules to store arbitrary user preferences
model UserPreferences {
  id BigInt @id @default(autoincrement())
  userid BigInt @default(0)
  name String @default("")
  value String @default("")

  User User @relation(fields: [userid], references: [id])

  @@map("user_preferences")
}

// access keys used in cookieless scripts - rss, etc.
model UserPrivateKey {
  id BigInt @id @default(autoincrement())
  script String @default("") // plugin, module - unique identifier
  value String @default("") // private access key value
  userid BigInt // owner
  instance BigInt? // optional instance id
  iprestriction String? // ip restriction
  validuntil BigInt? // timestampt - valid until data
  timecreated BigInt? // created timestamp

  User User @relation(fields: [userid], references: [id])

  @@map("user_private_key")
}

// Stores Wiki activity configuration
model Wiki {
  id BigInt @id @default(autoincrement())
  course BigInt @default(0) // Course wiki activity belongs to
  name String @default("Wiki") // name field for moodle instances
  intro String? // General introduction of the wiki activity
  introformat Int @default(0) // Format of the intro field (MOODLE, HTML, MARKDOWN...)
  timecreated BigInt @default(0)
  timemodified BigInt @default(0)
  firstpagetitle String @default("First Page") // Wiki first page's name
  wikimode String @default("collaborative") // Wiki mode (individual, collaborative)
  defaultformat String @default("creole") // Wiki's default editor
  forceformat Boolean @default(true) // Forces the default editor
  editbegin BigInt @default(0) // editbegin
  editend BigInt? @default(0) // editend

  WikiSubwikis WikiSubwikis[]

  @@map("wiki")
}

// Page wiki links
model WikiLinks {
  id BigInt @id @default(autoincrement())
  subwikiid BigInt @default(0) // Subwiki instance
  frompageid BigInt @default(0) // Page id with a link
  topageid BigInt @default(0) // Page id that recives a link
  tomissingpage String? // link to a nonexistent page

  Subwiki WikiSubwikis @relation(fields: [subwikiid], references: [id])
  Frompage WikiPages @relation(fields: [frompageid], references: [id])

  @@map("wiki_links")
}

// Manages page locks
model WikiLocks {
  id BigInt @id @default(autoincrement())
  pageid BigInt @default(0) // Locked page
  sectionname String? // locked page section
  userid BigInt @default(0) // Locking user
  lockedat BigInt @default(0) // timestamp

  Page WikiPages @relation(fields: [pageid], references: [id])
  User User @relation(fields: [userid], references: [id])

  @@map("wiki_locks")
}

// Stores wiki pages
model WikiPages {
  id BigInt @id @default(autoincrement())
  subwikiid BigInt @default(0) // Subwiki instance of this page
  title String @default("title") // Page name
  cachedcontent String // Cache wiki content
  timecreated BigInt @default(0) // Wiki page creation timestamp
  timemodified BigInt @default(0) // page edition timestamp
  timerendered BigInt @default(0) // Last render timestamp
  userid BigInt @default(0) // Edition author
  pageviews BigInt @default(0) // Number of page views
  readonly Boolean @default(false) // Read only flag

  Subwiki WikiSubwikis @relation(fields: [subwikiid], references: [id])
  User User @relation(fields: [userid], references: [id])

  WikiLinks WikiLinks[]
  WikiLocks WikiLocks[]
  WikiSynonyms WikiSynonyms[]
  WikiVersions WikiVersions[]

  @@map("wiki_pages")
}

// Stores subwiki instances
model WikiSubwikis {
  id BigInt @id @default(autoincrement())
  wikiid BigInt @default(0) // Wiki activity
  groupid BigInt @default(0) // Group that owns this wiki
  userid BigInt @default(0) // Owner of that subwiki

  Wiki Wiki @relation(fields: [wikiid], references: [id])
  User User @relation(fields: [userid], references: [id])

  WikiLinks WikiLinks[]
  WikiPages WikiPages[]
  WikiSynonyms WikiSynonyms[]

  @@map("wiki_subwikis")
}

// Stores wiki pages synonyms
model WikiSynonyms {
  id BigInt @id @default(autoincrement())
  subwikiid BigInt @default(0) // Subwiki instance
  pageid BigInt @default(0) // Original page
  pagesynonym String @default("Pagesynonym") // Page name synonym

  Subwiki WikiSubwikis @relation(fields: [subwikiid], references: [id])
  Page WikiPages @relation(fields: [pageid], references: [id])

  @@map("wiki_synonyms")
}

// Stores wiki page history
model WikiVersions {
  id BigInt @id @default(autoincrement())
  pageid BigInt @default(0) // Page id
  content String // Not parsed wiki content
  contentformat String @default("creole") // Markup used to write content
  version Int @default(0) // Wiki page version
  timecreated BigInt @default(0) // Page edition timestamp
  userid BigInt @default(0) // Edition autor

  Page WikiPages @relation(fields: [pageid], references: [id])
  User User @relation(fields: [userid], references: [id])

  @@map("wiki_versions")
}

// This table keeps information about the module instances and
model Workshop {
  id BigInt @id @default(autoincrement())
  course BigInt // ID of the parent course
  name String @default("") // Name of the activity
  intro String? // The introduction or description of the activity
  introformat Int @default(0) // The format of the intro field
  instructauthors String? // Instructions for the submission phase
  instructauthorsformat Int @default(0)
  instructreviewers String? // Instructions for the assessment phase
  instructreviewersformat Int @default(0)
  timemodified BigInt // The timestamp when the module was modified
  phase Int? @default(0) // The current phase of workshop (0 = not available, 1 = submission, 2 = assessment, 3 = closed)
  useexamples Int? @default(0) // optional feature: students practise evaluating on example submissions from teacher
  usepeerassessment Int? @default(0) // optional feature: students perform peer assessment of others' work
  useselfassessment Int? @default(0) // optional feature: students perform self assessment of their own work
  grade Decimal? @default(80.0) // The maximum grade for submission
  gradinggrade Decimal? @default(20.0) // The maximum grade for assessment
  strategy String @default("") // The type of the current grading strategy used in this workshop
  evaluation String @default("") // The recently used grading evaluation method
  gradedecimals Int? @default(0) // Number of digits that should be shown after the decimal point when displaying grades
  submissiontypetext Boolean @default(true) // Can students enter text for their submissions? 0 for no, 1 for optional, 2 for required.
  submissiontypefile Boolean @default(true) // Can students attach files for their submissions? 0 for no, 1 for optional, 2 for required.
  nattachments Int? @default(1) // Maximum number of submission attachments
  submissionfiletypes String? // comma separated list of file extensions
  latesubmissions Int? @default(0) // Allow submitting the work after the deadline
  maxbytes BigInt? @default(100000) // Maximum size of the one attached file
  examplesmode Int? @default(0) // 0 = example assessments are voluntary, 1 = examples must be assessed before submission, 2 = examples are available after own submission and must be assessed before peer/self assessment phase
  submissionstart BigInt? @default(0) // 0 = will be started manually, greater than 0 the timestamp of the start of the submission phase
  submissionend BigInt? @default(0) // 0 = will be closed manually, greater than 0 the timestamp of the end of the submission phase
  assessmentstart BigInt? @default(0) // 0 = will be started manually, greater than 0 the timestamp of the start of the assessment phase
  assessmentend BigInt? @default(0) // 0 = will be closed manually, greater than 0 the timestamp of the end of the assessment phase
  phaseswitchassessment Int @default(0) // Automatically switch to the assessment phase after the submissions deadline
  conclusion String? // A text to be displayed at the end of the workshop.
  conclusionformat Int @default(1) // The format of the conclusion field content.
  overallfeedbackmode Int? @default(1) // Mode of the overall feedback support.
  overallfeedbackfiles Int? @default(0) // Number of allowed attachments to the overall feedback.
  overallfeedbackfiletypes String? // comma separated list of file extensions
  overallfeedbackmaxbytes BigInt? @default(100000) // Maximum size of one file attached to the overall feedback.

  Course Course @relation(fields: [course], references: [id])

  WorkshopAggregations WorkshopAggregations[]
  WorkshopSubmissions WorkshopSubmissions[]
  WorkshopallocationScheduled WorkshopallocationScheduled[]
  WorkshopevalBestSettings WorkshopevalBestSettings[]
  WorkshopformAccumulative WorkshopformAccumulative[]
  WorkshopformComments WorkshopformComments[]
  WorkshopformNumerrors WorkshopformNumerrors[]
  WorkshopformNumerrorsMap WorkshopformNumerrorsMap[]
  WorkshopformRubric WorkshopformRubric[]
  WorkshopformRubricConfig WorkshopformRubricConfig[]

  @@map("workshop")
}

// Aggregated grades for assessment are stored here. The aggreg
model WorkshopAggregations {
  id BigInt @id @default(autoincrement())
  workshopid BigInt // the id of the workshop instance
  userid BigInt // The id of the user which aggregated grades are calculated for
  gradinggrade Decimal? // The aggregated grade for all assessments made by this reviewer. The grade is a number from interval 0..100. If NULL then the grade for assessments has not been aggregated yet.
  timegraded BigInt? // The timestamp of when the participant's gradinggrade was recently aggregated.

  Workshop Workshop @relation(fields: [workshopid], references: [id])
  User User @relation(fields: [userid], references: [id])

  @@map("workshop_aggregations")
}

// Info about the made assessment and automatically calculated
model WorkshopAssessments {
  id BigInt @id @default(autoincrement())
  submissionid BigInt // The id of the assessed submission
  reviewerid BigInt // The id of the reviewer who makes this assessment
  weight BigInt @default(1) // The weight of the assessment for the purposes of aggregation
  timecreated BigInt? @default(0) // If 0 then the assessment was allocated but the reviewer has not assessed yet. If greater than 0 then the timestamp of when the reviewer assessed for the first time
  timemodified BigInt? @default(0) // If 0 then the assessment was allocated but the reviewer has not assessed yet. If greater than 0 then the timestamp of when the reviewer assessed for the last time
  grade Decimal? // The aggregated grade for submission suggested by the reviewer. The grade 0..100 is computed from the values assigned to the assessment dimensions fields. If NULL then it has not been aggregated yet.
  gradinggrade Decimal? // The computed grade 0..100 for this assessment. If NULL then it has not been computed yet.
  gradinggradeover Decimal? // Grade for the assessment manually overridden by a teacher. Grade is always from interval 0..100. If NULL then the grade is not overriden.
  gradinggradeoverby BigInt? // The id of the user who has overridden the grade for submission.
  feedbackauthor String? // The comment/feedback from the reviewer for the author.
  feedbackauthorformat Int? @default(0)
  feedbackauthorattachment Int? @default(0) // Are there some files attached to the feedbackauthor field? Sets to 1 by file_postupdate_standard_filemanager().
  feedbackreviewer String? // The comment/feedback from the teacher for the reviewer. For example the reason why the grade for assessment was overridden
  feedbackreviewerformat Int? @default(0)

  Submission WorkshopSubmissions @relation(fields: [submissionid], references: [id])
  Reviewer User @relation(name: "workshop_assessments_reviewerid", fields: [reviewerid], references: [id])
  Gradinggradeoverby User? @relation(name: "workshop_assessments_gradinggradeoverby", fields: [gradinggradeoverby], references: [id])

  WorkshopGrades WorkshopGrades[]

  @@map("workshop_assessments")
}

// How the reviewers filled-up the grading forms, given grades
model WorkshopGrades {
  id BigInt @id @default(autoincrement())
  assessmentid BigInt // Part of which assessment this grade is of
  strategy String @default("")
  dimensionid BigInt // Foreign key. References dimension id in one of the grading strategy tables.
  grade Decimal? // Given grade in the referenced assessment dimension.
  peercomment String? // Reviewer's comment to the grade value.
  peercommentformat Int? @default(0) // The format of peercomment field

  Assessment WorkshopAssessments @relation(fields: [assessmentid], references: [id])

  @@map("workshop_grades")
}

// Info about the submission and the aggregation of the grade f
model WorkshopSubmissions {
  id BigInt @id @default(autoincrement())
  workshopid BigInt // the id of the workshop instance
  example Int? @default(0) // Is this submission an example from teacher
  authorid BigInt // The author of the submission
  timecreated BigInt // Timestamp when the work was submitted for the first time
  timemodified BigInt // Timestamp when the submission has been updated
  title String @default("") // The submission title
  content String? // Submission text
  contentformat Int @default(0) // The format of submission text
  contenttrust Int @default(0) // The trust mode of the data
  attachment Int? @default(0) // Used by File API file_postupdate_standard_filemanager
  grade Decimal? // Aggregated grade for the submission. The grade is a decimal number from interval 0..100. If NULL then the grade for submission has not been aggregated yet.
  gradeover Decimal? // Grade for the submission manually overridden by a teacher. Grade is always from interval 0..100. If NULL then the grade is not overriden.
  gradeoverby BigInt? // The id of the user who has overridden the grade for submission.
  feedbackauthor String? // Teacher comment/feedback for the author of the submission, for example describing the reasons for the grade overriding
  feedbackauthorformat Int? @default(0)
  timegraded BigInt? // The timestamp when grade or gradeover was recently modified
  published Int? @default(0) // Shall the submission be available to other when the workshop is closed
  late Int @default(0) // Has this submission been submitted after the deadline or during the assessment phase?

  Workshop Workshop @relation(fields: [workshopid], references: [id])
  Author User @relation(name: "workshop_submissions_authorid", fields: [authorid], references: [id])
  Gradeoverby User? @relation(name: "workshop_submissions_gradeoverby", fields: [gradeoverby], references: [id])

  WorkshopAssessments WorkshopAssessments[]

  @@map("workshop_submissions")
}

// Stores the allocation settings for the scheduled allocator
model WorkshopallocationScheduled {
  id BigInt @id @default(autoincrement())
  workshopid BigInt // workshop id we are part of
  enabled Int @default(0) // Is the scheduled allocation enabled
  submissionend BigInt // What was the workshop's submissionend when this record was created or modified
  timeallocated BigInt? // When was the last scheduled allocation executed
  settings String? // The pre-defined settings for the underlying random allocation to run it with
  resultstatus BigInt? // The resulting status of the most recent execution
  resultmessage String? // Optional short message describing the resulting status
  resultlog String? // The log of the most recent execution

  Workshop Workshop @relation(fields: [workshopid], references: [id])

  @@map("workshopallocation_scheduled")
}

// Settings for the grading evaluation subplugin Comparison wit
model WorkshopevalBestSettings {
  id BigInt @id @default(autoincrement())
  workshopid BigInt
  comparison Int? @default(5) // Here we store the recently set factor of comparison of assessment in the given workshop. Reasonable values are from 1 to 10 or so. Default to 5.

  Workshop Workshop @relation(fields: [workshopid], references: [id])

  @@map("workshopeval_best_settings")
}

// The assessment dimensions definitions of Accumulative gradin
model WorkshopformAccumulative {
  id BigInt @id @default(autoincrement())
  workshopid BigInt // Workshop ID
  sort BigInt? @default(0) // Defines the dimension order within the assessment form
  description String? // The description of the dimension
  descriptionformat Int? @default(0) // The format of the description field
  grade BigInt // If greater than 0, then the value is maximum grade on a scale 0..grade. If lesser than 0, then its absolute value is the id of a record in scale table. If equals 0, then no grading is possible for this dimension, just commenting.
  weight Int? @default(1) // The weigh of the dimension

  Workshop Workshop @relation(fields: [workshopid], references: [id])

  @@map("workshopform_accumulative")
}

// The assessment dimensions definitions of Comments strategy f
model WorkshopformComments {
  id BigInt @id @default(autoincrement())
  workshopid BigInt // Workshop ID
  sort BigInt? @default(0) // Defines the dimension order within the assessment form
  description String? // The description of the dimension
  descriptionformat Int? @default(0) // The format of the description field

  Workshop Workshop @relation(fields: [workshopid], references: [id])

  @@map("workshopform_comments")
}

// The assessment dimensions definitions of Number of errors gr
model WorkshopformNumerrors {
  id BigInt @id @default(autoincrement())
  workshopid BigInt // Workshop ID
  sort BigInt? @default(0) // Defines the dimension order within the assessment form
  description String? // The description of the dimension
  descriptionformat Int? @default(0) // The format of the description field
  descriptiontrust BigInt?
  grade0 String? // The word describing the negative evaluation (like Poor, Missing, Absent, etc.). If NULL, it defaults to a translated string False
  grade1 String? // A word for possitive evaluation (like Good, Present, OK etc). If NULL, it defaults to a translated string True
  weight Int? @default(1) // Weight of this dimension

  Workshop Workshop @relation(fields: [workshopid], references: [id])

  @@map("workshopform_numerrors")
}

// This maps the number of errors to a percentual grade for sub
model WorkshopformNumerrorsMap {
  id BigInt @id @default(autoincrement())
  workshopid BigInt // The id of the workshop
  nonegative BigInt // Number of negative responses given by the reviewer
  grade Decimal // Percentual grade 0..100 for this number of negative responses

  Workshop Workshop @relation(fields: [workshopid], references: [id])

  @@map("workshopform_numerrors_map")
}

// The assessment dimensions definitions of Rubric grading stra
model WorkshopformRubric {
  id BigInt @id @default(autoincrement())
  workshopid BigInt // Workshop ID
  sort BigInt? @default(0) // Defines the dimension order within the assessment form
  description String? // The description of the dimension
  descriptionformat Int? @default(0) // The format of the description field

  Workshop Workshop @relation(fields: [workshopid], references: [id])

  WorkshopformRubricLevels WorkshopformRubricLevels[]

  @@map("workshopform_rubric")
}

// Configuration table for the Rubric grading strategy
model WorkshopformRubricConfig {
  id BigInt @id @default(autoincrement())
  workshopid BigInt // The id of workshop this configuartion applies for
  layout String? @default("list") // How should the rubric be displayed for reviewers

  Workshop Workshop @relation(fields: [workshopid], references: [id])

  @@map("workshopform_rubric_config")
}

// The definition of rubric rating scales
model WorkshopformRubricLevels {
  id BigInt @id @default(autoincrement())
  dimensionid BigInt // Which criterion this level is part of
  grade Decimal // Grade representing this level.
  definition String? // The definition of this level
  definitionformat Int? @default(0) // The format of the definition field

  Dimension WorkshopformRubric @relation(fields: [dimensionid], references: [id])

  @@map("workshopform_rubric_levels")
}
