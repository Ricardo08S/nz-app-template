  imageauthorurl String?
  imagecaption String?

  Usercreated User @relation(name: "badge_usercreated", fields: [usercreated], references: [id])
  Usermodified User @relation(name: "badge_usermodified", fields: [usermodified], references: [id])
  Course Course? @relation(fields: [courseid], references: [id])

  BadgeAlignment BadgeAlignment[]
  BadgeCriteria BadgeCriteria[]
  BadgeEndorsement BadgeEndorsement[]
  BadgeIssued BadgeIssued[]
  BadgeManualAward BadgeManualAward[]
  BadgeRelatedByBadge BadgeRelated[] @relation(name: "badge_related_badgeid")
  BadgeRelatedByRelatedbadge BadgeRelated[] @relation(name: "badge_related_relatedbadgeid")

  @@map("badge")
}

// Defines alignment for badges
model BadgeAlignment {
  id BigInt @id @default(autoincrement())
  badgeid BigInt @default(0)
  targetname String @default("")
  targeturl String @default("")
  targetdescription String?
  targetframework String?
  targetcode String?

  Badge Badge @relation(fields: [badgeid], references: [id])

  @@map("badge_alignment")
}

// Defines settings for connecting external backpack
model BadgeBackpack {
  id BigInt @id @default(autoincrement())
  userid BigInt @default(0)
  email String @default("")
  backpackuid BigInt
  autosync Boolean @default(false)
  password String?
  externalbackpackid BigInt?

  User User @relation(fields: [userid], references: [id])
  Externalbackpack BadgeExternalBackpack? @relation(fields: [externalbackpackid], references: [id])

  BadgeExternal BadgeExternal[]
  BadgeExternalIdentifier BadgeExternalIdentifier[]

  @@map("badge_backpack")
}

// Default comment for the table, please edit me
model BadgeBackpackOauth2 {
  id BigInt @id @default(autoincrement())
  usermodified BigInt @default(0)
  timecreated BigInt @default(0)
  timemodified BigInt @default(0)
