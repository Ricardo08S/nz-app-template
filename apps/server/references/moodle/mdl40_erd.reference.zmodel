  badgeid BigInt
  recipientid BigInt
  issuerid BigInt
  issuerrole BigInt
  datemet BigInt

  Badge Badge @relation(fields: [badgeid], references: [id])
  Recipient User @relation(name: "badge_manual_award_recipientid", fields: [recipientid], references: [id])
  Issuer User @relation(name: "badge_manual_award_issuerid", fields: [issuerid], references: [id])
  Issuerrole Role @relation(fields: [issuerrole], references: [id])

  @@map("badge_manual_award")
