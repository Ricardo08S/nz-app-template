// This table saves information about an instance of mod_assign
model Assign {
  id BigInt @id @default(autoincrement())
  course BigInt @default(0)
  name String @default("") // The name of the instance of the assignment. Displayed at the top of each page.
  intro String // The description of the assignment. This field is used by feature MOD_INTRO.
  introformat Int @default(0) // The format of the description field of the assignment. This field is used by feature MOD_INTRO.
  alwaysshowdescription Int @default(0) // If false the assignment intro will only be displayed after the allowsubmissionsfrom date. If true it will always be displayed.
  nosubmissions Int @default(0) // This field is a cache for is_any_submission_plugin_enabled() which allows Moodle pages to distinguish offline assignment types without loading the assignment class.
  submissiondrafts Int @default(0) // If true, assignment submissions will be considered drafts until the student clicks on the submit assignmnet button.
  sendnotifications Int @default(0) // Allows the disabling of email notifications in the assign module.
  sendlatenotifications Int @default(0) // Allows separate enabling of notifications for late assignment submissions.
  duedate BigInt @default(0) // The due date for the assignment. Displayed to students.
  allowsubmissionsfromdate BigInt @default(0) // If set, submissions will only be accepted after this date.
  grade BigInt @default(0) // The maximum grade for this assignment. Can be negative to indicate the use of a scale.
  timemodified BigInt @default(0) // The time the settings for this assign module instance were last modified.
  requiresubmissionstatement Int @default(0) // Forces the student to accept a submission statement when submitting an assignment
  completionsubmit Int @default(0) // If this field is set to 1, then the activity will be automatically marked as 'complete' once the user submits their assignment.
  cutoffdate BigInt @default(0) // The final date after which submissions will no longer be accepted for this assignment without an extensions.
  gradingduedate BigInt @default(0) // The expected date for marking the submissions.
  teamsubmission Int @default(0) // Do students submit in teams?
  requireallteammemberssubmit Int @default(0) // If enabled, a submission will not be accepted until all team members have submitted it.
  teamsubmissiongroupingid BigInt @default(0) // A grouping id to get groups for team submissions
  blindmarking Int @default(0) // Hide student/grader identities until the reveal identities action is performed
  hidegrader Int @default(0) // Hide the grader's identity from students. The opposite of blind marking.
  revealidentities Int @default(0) // Show identities for a blind marking assignment
  attemptreopenmethod String @default("none") // How to determine when students are allowed to open a new submission. Valid options are none, manual, untilpass
  maxattempts Int @default(-1) // What is the maximum number of student attempts allowed for this assignment? -1 means unlimited.
  markingworkflow Int @default(0) // If enabled, marking workflow features will be used in this assignment.
  markingallocation Int @default(0) // If enabled, marking allocation features will be used in this assignment
  sendstudentnotifications Int @default(1) // Default for send student notifications checkbox when grading.
  preventsubmissionnotingroup Int @default(0) // If enabled a user will be unable to make a submission unless they are a member of a group.
  activity String?
  activityformat Int @default(0)
  timelimit BigInt @default(0)
  submissionattachments Int @default(0)

  AssignGrades AssignGrades[]
  AssignOverrides AssignOverrides[]
  AssignPluginConfig AssignPluginConfig[]
  AssignSubmission AssignSubmission[]
  AssignUserFlags AssignUserFlags[]
  AssignUserMapping AssignUserMapping[]
  AssignfeedbackComments AssignfeedbackComments[]
  AssignfeedbackFile AssignfeedbackFile[]
  AssignsubmissionFile AssignsubmissionFile[]
  AssignsubmissionOnlinetext AssignsubmissionOnlinetext[]

  @@map("assign")
}

