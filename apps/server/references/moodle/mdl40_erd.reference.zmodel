// Defines badge related for badges
model BadgeRelated {
  id BigInt @id @default(autoincrement())
  badgeid BigInt @default(0)
  relatedbadgeid BigInt?

  Badge Badge @relation(name: "badge_related_badgeid", fields: [badgeid], references: [id])
  Relatedbadge Badge? @relation(name: "badge_related_relatedbadgeid", fields: [relatedbadgeid], references: [id])

  @@map("badge_related")
}

// The bigbluebuttonbn table to store information about a meeti
model Bigbluebuttonbn {
  id BigInt @id @default(autoincrement())
  type Int @default(0)
  course BigInt @default(0)
  name String @default("")
  intro String?
  introformat Int @default(1)
  meetingid String @default("")
  moderatorpass String @default("")
  viewerpass String @default("")
  wait Boolean @default(false)
  record Boolean @default(false)
  recordallfromstart Boolean @default(false)
  recordhidebutton Boolean @default(false)
  welcome String?
  voicebridge Int @default(0)
  openingtime BigInt @default(0)
  closingtime BigInt @default(0)
  timecreated BigInt @default(0)
  timemodified BigInt @default(0)
  presentation String?
  participants String?
  userlimit Int @default(0)
  recordings_html Boolean @default(false)
  recordings_deleted Boolean @default(true)
  recordings_imported Boolean @default(false)
  recordings_preview Boolean @default(false)
  clienttype Boolean @default(false)
  muteonstart Boolean @default(false)
  disablecam Boolean @default(false)
  disablemic Boolean @default(false)
  disableprivatechat Boolean @default(false)
  disablepublicchat Boolean @default(false)
  disablenote Boolean @default(false)
  hideuserlist Boolean @default(false)
  lockedlayout Boolean @default(false)
  lockonjoin Boolean @default(false)
  lockonjoinconfigurable Boolean @default(false)
  completionattendance Int @default(0) // Nonzero if a certain number of minutes in the meeting are required to mark an activity completed for a user.
  completionengagementchats Int @default(0) // Nonzero if chat during the meeting is required to mark an activity completed for a user.
  completionengagementtalks Int @default(0) // Nonzero if talking during the meeting is required to mark an activity completed for a user.
  completionengagementraisehand Int @default(0) // Nonzero if raising hand during the meeting is required to mark an activity completed for a user.
  completionengagementpollvotes Int @default(0) // Nonzero if poll voting during the meeting is required to mark an activity completed for a user.
  completionengagementemojis Int @default(0) // Nonzero if the use of emojis during the meeting is required to mark an activity completed for a user.

  BigbluebuttonbnLogs BigbluebuttonbnLogs[]
  BigbluebuttonbnRecordings BigbluebuttonbnRecordings[]

  @@map("bigbluebuttonbn")
}

// The bigbluebuttonbn table to store meeting activity events
model BigbluebuttonbnLogs {
  id BigInt @id @default(autoincrement())
  courseid BigInt
  bigbluebuttonbnid BigInt
  userid BigInt?
  timecreated BigInt @default(0)
  meetingid String @default("")
  log String @default("")
  meta String?

  Course Course @relation(fields: [courseid], references: [id])
  Bigbluebuttonbn Bigbluebuttonbn @relation(fields: [bigbluebuttonbnid], references: [id])
  User User? @relation(fields: [userid], references: [id])

  @@map("bigbluebuttonbn_logs")
}

// The bigbluebuttonbn table to store references to recordings
model BigbluebuttonbnRecordings {
  id BigInt @id @default(autoincrement())
  courseid BigInt
  bigbluebuttonbnid BigInt
  groupid BigInt?
  recordingid String @default("")
  headless Boolean @default(false)
  imported Boolean @default(false)
  status Boolean @default(false)
  importeddata String? // This is the remote recording data stored as json and kept for future reference.
  timecreated BigInt @default(0)
  usermodified BigInt @default(0)
  timemodified BigInt @default(0)

  Course Course @relation(fields: [courseid], references: [id])
  Bigbluebuttonbn Bigbluebuttonbn @relation(fields: [bigbluebuttonbnid], references: [id])
  Usermodified User @relation(fields: [usermodified], references: [id])

  @@map("bigbluebuttonbn_recordings")
}

// contains all installed blocks
model Block {
  id BigInt @id @default(autoincrement())
  name String @default("") @unique
  cron BigInt @default(0)
  lastcron BigInt @default(0)
  visible Boolean @default(true)

  BlockInstances BlockInstances[]

  @@map("block")
}

// This table stores block instances. The type of block this is
model BlockInstances {
  id BigInt @id @default(autoincrement())
  blockname String @default("") // The type of block this is. Foreign key, references block.name.
  parentcontextid BigInt // The context within which this block appears. Foreign key, references context.id.
  showinsubcontexts Int // If 1, this block appears on all matching pages in subcontexts of parentcontextid, as well in pages belonging to parentcontextid.
  requiredbytheme Int @default(0) // If 1, this block was created because it was required by the theme and did not exist.
  pagetypepattern String @default("") // The types of page this block appears on. Either an exact page type like mod-quiz-view, or a pattern like mod-quiz-* or course-view-*. Note that course-view-* will match course-view.
  subpagepattern String? // Further restrictions on where this block appears. In some places, e.g. during a quiz or lesson attempt, different pages have different subpage ids. If this field is not null, the block only appears on that particular subpage.
  defaultregion String @default("") // Which block region this block should appear in on each page, in the absence of a specific position in the block_positions table.
  defaultweight BigInt // Used to order the blocks within a block region. Again, may be overridden by the block_positions table for a specific page where this block appears.
  configdata String? // A serialized blob of configuration data for this block instance.
  timecreated BigInt // Time at which this block instance was originally created
  timemodified BigInt // Time at which block instance was last modified.

  Blockname Block @relation(fields: [blockname], references: [name])
  Parentcontext Context @relation(fields: [parentcontextid], references: [id])

  BlockPositions BlockPositions[]

  @@map("block_instances")
}

// Stores the position of a sticky block_instance on a another
model BlockPositions {
  id BigInt @id @default(autoincrement())
  blockinstanceid BigInt // The block_instance this position relates to.
  contextid BigInt // With pagetype and subpage, defines the page we are setting the position for.
  pagetype String @default("") // With contextid and subpage, defines the page we are setting the position for.
  subpage String @default("") // With contextid and pagetype, defines the page we are setting the position for.
  visible Int // Whether this block instance is visible on this page.
  region String @default("") // Which block region on this page this block should appear in.
  weight BigInt // Used to order the blocks within a block region.

  Blockinstance BlockInstances @relation(fields: [blockinstanceid], references: [id])
  Context Context @relation(fields: [contextid], references: [id])

  @@map("block_positions")
}

// Recent activity block
model BlockRecentActivity {
  id BigInt @id @default(autoincrement())
  courseid BigInt // Course id
  cmid BigInt // Course module id
  timecreated BigInt
  userid BigInt // User performing the action
  action Boolean // 0 created, 1 updated, 2 deleted
  modname String? // module type name (for delete action)

  Course Course @relation(fields: [courseid], references: [id])
  User User @relation(fields: [userid], references: [id])

  @@map("block_recent_activity")
}

// Most recently accessed items accessed by a user
model BlockRecentlyaccesseditems {
  id BigInt @id @default(autoincrement())
  courseid BigInt // Course id the item belongs to
  cmid BigInt // Item course module id
  userid BigInt // User id that accessed the item
  timeaccess BigInt // Time the user accessed the last time an item

  Course Course @relation(fields: [courseid], references: [id])
  Cm CourseModules @relation(fields: [cmid], references: [id])
  User User @relation(fields: [userid], references: [id])

  @@map("block_recentlyaccesseditems")
}

// Remote news feed information. Contains the news feed id, the
model BlockRssClient {
  id BigInt @id @default(autoincrement())
  userid BigInt @default(0)
  title String
  preferredtitle String @default("")
  description String
  shared Int @default(0)
  url String @default("")
  skiptime BigInt @default(0) // How many seconds skip this feed for (increases every time it fails, resets to 0 when it succeeds)
  skipuntil BigInt @default(0) // Do not query this RSS feed again until this time

  User User @relation(fields: [userid], references: [id])

  @@map("block_rss_client")
}

// Associations of blog entries with courses and module instanc
model BlogAssociation {
  id BigInt @id @default(autoincrement())
  contextid BigInt
  blogid BigInt

  Context Context @relation(fields: [contextid], references: [id])
  Blog Post @relation(fields: [blogid], references: [id])

  @@map("blog_association")
}

// External blog links used for RSS copying of blog entries to
model BlogExternal {
  id BigInt @id @default(autoincrement())
  userid BigInt
  name String @default("")
  description String?
  url String
  filtertags String? // Comma-separated list of tags that will be used to filter which entries are copied over from the external blog. They refer to existing tags in the external blog.
  failedlastsync Boolean @default(false) // Whether or not the last sync failed for some reason
  timemodified BigInt?
  timefetched BigInt @default(0)

  User User @relation(fields: [userid], references: [id])

  @@map("blog_external")
}

// Defines book
model Book {
  id BigInt @id @default(autoincrement())
  course BigInt @default(0)
  name String @default("")
  intro String?
  introformat Int @default(0)
  numbering Int @default(0)
  navstyle Int @default(1)
  customtitles Int @default(0)
  revision BigInt @default(0)
  timecreated BigInt @default(0)
  timemodified BigInt @default(0)

  BookChapters BookChapters[]

  @@map("book")
}

// Defines book_chapters
model BookChapters {
  id BigInt @id @default(autoincrement())
  bookid BigInt @default(0)
  pagenum BigInt @default(0)
  subchapter BigInt @default(0)
  title String @default("")
  content String
  contentformat Int @default(0)
  hidden Int @default(0)
  timecreated BigInt @default(0)
  timemodified BigInt @default(0)
  importsrc String @default("")

  Book Book @relation(fields: [bookid], references: [id])

  @@map("book_chapters")
}

// For keeping information about cached data
model CacheFilters {
  id BigInt @id @default(autoincrement())
  filter String @default("")
  version BigInt @default(0)
  md5key String @default("")
  rawtext String
  timemodified BigInt @default(0)

  @@map("cache_filters")
}

// Cache of time-sensitive flags
model CacheFlags {
  id BigInt @id @default(autoincrement())
  flagtype String @default("")
  name String @default("")
  timemodified BigInt @default(0)
  value String
  expiry BigInt

  @@map("cache_flags")
}

// this defines all capabilities
model Capabilities {
  id BigInt @id @default(autoincrement())
  name String @default("") @unique
  captype String @default("")
  contextlevel BigInt @default(0)
  component String @default("")
  riskbitmask BigInt @default(0)

  RoleCapabilities RoleCapabilities[]

  @@map("capabilities")
}

// Each of these is a chat room
model Chat {
  id BigInt @id @default(autoincrement())
  course BigInt @default(0)
  name String @default("")
  intro String
  introformat Int @default(0) // text format of intro field
  keepdays BigInt @default(0)
  studentlogs Int @default(0)
  chattime BigInt @default(0)
  schedule Int @default(0)
  timemodified BigInt @default(0)

  ChatMessages ChatMessages[]
  ChatMessagesCurrent ChatMessagesCurrent[]
  ChatUsers ChatUsers[]

  @@map("chat")
}

// Stores all the actual chat messages
model ChatMessages {
  id BigInt @id @default(autoincrement())
  chatid BigInt @default(0)
  userid BigInt @default(0)
  groupid BigInt @default(0)
  issystem Boolean @default(false)
  message String
  timestamp BigInt @default(0)

  Chat Chat @relation(fields: [chatid], references: [id])
  User User @relation(fields: [userid], references: [id])

  @@map("chat_messages")
}

// Stores current session
model ChatMessagesCurrent {
  id BigInt @id @default(autoincrement())
  chatid BigInt @default(0)
  userid BigInt @default(0)
  groupid BigInt @default(0)
  issystem Boolean @default(false)
  message String
  timestamp BigInt @default(0)

  Chat Chat @relation(fields: [chatid], references: [id])
  User User @relation(fields: [userid], references: [id])

  @@map("chat_messages_current")
}

// Keeps track of which users are in which chat rooms
model ChatUsers {
  id BigInt @id @default(autoincrement())
  chatid BigInt @default(0)
  userid BigInt @default(0)
  groupid BigInt @default(0)
  version String @default("")
  ip String @default("")
  firstping BigInt @default(0)
  lastping BigInt @default(0)
  lastmessageping BigInt @default(0)
  sid String @default("")
  course BigInt @default(0)
  lang String @default("")

  Chat Chat @relation(fields: [chatid], references: [id])
  User User @relation(fields: [userid], references: [id])

  @@map("chat_users")
}

// Available choices are stored here
model Choice {
  id BigInt @id @default(autoincrement())
  course BigInt @default(0)
  name String @default("")
  intro String
  introformat Int @default(0)
  publish Int @default(0)
  showresults Int @default(0)
  display Int @default(0)
  allowupdate Int @default(0)
  allowmultiple Int @default(0)
  showunanswered Int @default(0)
  includeinactive Int @default(1)
  limitanswers Int @default(0)
  timeopen BigInt @default(0)
  timeclose BigInt @default(0)
  showpreview Int @default(0)
  timemodified BigInt @default(0)
  completionsubmit Boolean @default(false) // If this field is set to 1, then the activity will be automatically marked as 'complete' once the user submits their choice.
  showavailable Boolean @default(false) // If this field is set to 1, then the the number of available space on choice options will be shown, given limitanswers is set to 1.

  ChoiceAnswers ChoiceAnswers[]
  ChoiceOptions ChoiceOptions[]

  @@map("choice")
}

// choices performed by users
model ChoiceAnswers {
  id BigInt @id @default(autoincrement())
  choiceid BigInt @default(0)
  userid BigInt @default(0)
  optionid BigInt @default(0)
  timemodified BigInt @default(0)

  Choice Choice @relation(fields: [choiceid], references: [id])
  User User @relation(fields: [userid], references: [id])
  Option ChoiceOptions @relation(fields: [optionid], references: [id])

  @@map("choice_answers")
}

// available options to choice
model ChoiceOptions {
  id BigInt @id @default(autoincrement())
  choiceid BigInt @default(0)
  text String?
  maxanswers BigInt? @default(0)
  timemodified BigInt @default(0)

  Choice Choice @relation(fields: [choiceid], references: [id])

  ChoiceAnswers ChoiceAnswers[]

  @@map("choice_options")
}

// Each record represents one cohort (aka site-wide group).
model Cohort {
  id BigInt @id @default(autoincrement())
  contextid BigInt // Context is usually ignored in sync operations so that the cohorts may be moved freely around in the context tree without any side affects.
  name String @default("") // Short human readable name for the cohort, does not have to be unique
  idnumber String? // Unique identifier of a cohort, useful especially for mapping to external entities
  description String? // Standard description text box
  descriptionformat Int
  visible Boolean @default(true) // Visibility to teachers
  component String @default("") // Component (plugintype_pluignname) that manages the cohort, manual modifications are allowed only when set to NULL
  timecreated BigInt
  timemodified BigInt
  theme String?

  Context Context @relation(fields: [contextid], references: [id])

  CohortMembers CohortMembers[]
  CompetencyTemplatecohort CompetencyTemplatecohort[]
  ToolCohortroles ToolCohortroles[]

  @@map("cohort")
}

// Link a user to a cohort.
model CohortMembers {
  id BigInt @id @default(autoincrement())
  cohortid BigInt @default(0)
  userid BigInt @default(0)
  timeadded BigInt @default(0)

  Cohort Cohort @relation(fields: [cohortid], references: [id])
  User User @relation(fields: [userid], references: [id])

  @@map("cohort_members")
}

// moodle comments module
model Comments {
  id BigInt @id @default(autoincrement())
  contextid BigInt
  component String? // The plugin this comment belongs to.
  commentarea String @default("")
  itemid BigInt
  content String
  format Int @default(0)
  userid BigInt
  timecreated BigInt

  Context Context @relation(fields: [contextid], references: [id])
  User User @relation(fields: [userid], references: [id])

  @@map("comments")
}

// This table contains the master record of each competency in
model Competency {
  id BigInt @id @default(autoincrement())
  shortname String? // Shortname of a competency
  description String? // Description of a single competency
  descriptionformat Int @default(0) // The format of the description field
  idnumber String?
  competencyframeworkid BigInt // The framework this competency relates to.
  parentid BigInt @default(0) // The parent competency.
  path String @default("") // Used to speed up queries that use an entire branch of the tree. Looks like /5/34/54.
  sortorder BigInt // Relative sort order within the branch
  ruletype String?
  ruleoutcome Int @default(0)
  ruleconfig String?
  scaleid BigInt?
  scaleconfiguration String?
  timecreated BigInt // The time this competency was created.
  timemodified BigInt // The time this competency was last modified.
  usermodified BigInt? // The user who last modified this competency

  Competencyframework CompetencyFramework @relation(fields: [competencyframeworkid], references: [id])
  Scale Scale? @relation(fields: [scaleid], references: [id])

  CompetencyCoursecomp CompetencyCoursecomp[]
  CompetencyModulecomp CompetencyModulecomp[]
  CompetencyPlancomp CompetencyPlancomp[]
  CompetencyRelatedcomp CompetencyRelatedcomp[]
  CompetencyTemplatecomp CompetencyTemplatecomp[]
  CompetencyUsercomp CompetencyUsercomp[]
  CompetencyUsercompcourse CompetencyUsercompcourse[]
  CompetencyUsercompplan CompetencyUsercompplan[]
  CompetencyUserevidencecomp CompetencyUserevidencecomp[]

  @@map("competency")
}

// Link a competency to a course.
model CompetencyCoursecomp {
  id BigInt @id @default(autoincrement())
  courseid BigInt // The course this competency is linked to.
  competencyid BigInt // The competency that is linked to this course.
  ruleoutcome Int // The rule that applies to the competency when the course is completed.
  timecreated BigInt // The time this link was created.
  timemodified BigInt // The time this link was modified.
  usermodified BigInt // The user who modified this link.
  sortorder BigInt // The display order for this link.

  Course Course @relation(fields: [courseid], references: [id])
  Competency Competency @relation(fields: [competencyid], references: [id])

  @@map("competency_coursecomp")
}

// This table contains the course specific settings for compete
model CompetencyCoursecompsetting {
  id BigInt @id @default(autoincrement())
  courseid BigInt // The course this setting is linked to.
  pushratingstouserplans Int? // Does this course push ratings to user plans?
  timecreated BigInt // The time this setting was created.
  timemodified BigInt // The time this setting was last modified.
  usermodified BigInt? // The user who last modified this setting

  Course Course @relation(fields: [courseid], references: [id])

  @@map("competency_coursecompsetting")
}

// The evidence linked to a user competency
model CompetencyEvidence {
  id BigInt @id @default(autoincrement())
  usercompetencyid BigInt
  contextid BigInt
  action Int
  actionuserid BigInt?
  descidentifier String @default("")
  desccomponent String @default("")
  desca String?
  url String?
  grade BigInt?
  note String? // A non-localised text to attach to the evidence.
  timecreated BigInt
  timemodified BigInt
  usermodified BigInt

  Usercompetency CompetencyUsercomp @relation(fields: [usercompetencyid], references: [id])
  Context Context @relation(fields: [contextid], references: [id])

  @@map("competency_evidence")
}

// List of competency frameworks.
model CompetencyFramework {
  id BigInt @id @default(autoincrement())
  shortname String? // Short name for the competency framework.
  contextid BigInt
  idnumber String? // Unique idnumber for this competency framework.
  description String? // Description of this competency framework
  descriptionformat Int @default(0) // The format of the description field
  scaleid BigInt? // Scale used to define competency.
  scaleconfiguration String // Scale information.
  visible Int @default(1) // Used to show/hide this competency framework.
  taxonomies String @default("") // Sequence of terms to use for each competency level.
  timecreated BigInt // The time this competency framework was created.
  timemodified BigInt // The time this competency framework was last modified.
  usermodified BigInt? // The user who last modified this framework

  Context Context @relation(fields: [contextid], references: [id])
  Scale Scale? @relation(fields: [scaleid], references: [id])

  Competency Competency[]

  @@map("competency_framework")
}

// Link a competency to a module.
model CompetencyModulecomp {
  id BigInt @id @default(autoincrement())
  cmid BigInt // ID of the record in the course_modules table.
  timecreated BigInt // The time this record was created.
  timemodified BigInt // The time this record was last modified
  usermodified BigInt // The user who last modified this field.
  sortorder BigInt // The field used to naturally sort this link.
  competencyid BigInt // The course competency this activity is linked to.
  ruleoutcome Int // The outcome when an activity is completed.

  Cm CourseModules @relation(fields: [cmid], references: [id])
  Competency Competency @relation(fields: [competencyid], references: [id])

  @@map("competency_modulecomp")
}

// Learning plans
model CompetencyPlan {
  id BigInt @id @default(autoincrement())
  name String @default("")
  description String?
  descriptionformat Int @default(0)
  userid BigInt
  templateid BigInt?
  origtemplateid BigInt? // The template ID this plan was based on originally
  status Boolean
  duedate BigInt? @default(0)
  reviewerid BigInt?
  timecreated BigInt
  timemodified BigInt @default(0)
  usermodified BigInt

  User User @relation(fields: [userid], references: [id])
  Template CompetencyTemplate? @relation(fields: [templateid], references: [id])

  @@map("competency_plan")
}

// Plan competencies
model CompetencyPlancomp {
  id BigInt @id @default(autoincrement())
  planid BigInt
  competencyid BigInt
  sortorder BigInt? // Relative sort order
  timecreated BigInt
  timemodified BigInt?
  usermodified BigInt

  Competency Competency @relation(fields: [competencyid], references: [id])

  @@map("competency_plancomp")
}

// Related competencies
model CompetencyRelatedcomp {
  id BigInt @id @default(autoincrement())
  competencyid BigInt
  relatedcompetencyid BigInt
  timecreated BigInt
  timemodified BigInt?
  usermodified BigInt

  Competency Competency @relation(fields: [competencyid], references: [id])

  @@map("competency_relatedcomp")
}

// Learning plan templates.
model CompetencyTemplate {
  id BigInt @id @default(autoincrement())
  shortname String? // Short name for the learning plan template.
  contextid BigInt
  description String? // Description of this learning plan template
  descriptionformat Int @default(0) // The format of the description field
  visible Int @default(1) // Used to show/hide this learning plan template.
  duedate BigInt? // The default due date for instances of this plan.
  timecreated BigInt // The time this learning plan template was created.
  timemodified BigInt // The time this learning plan template was last modified.
  usermodified BigInt? // The user who last modified this learning plan template

  Context Context @relation(fields: [contextid], references: [id])

  CompetencyPlan CompetencyPlan[]
  CompetencyTemplatecohort CompetencyTemplatecohort[]
  CompetencyTemplatecomp CompetencyTemplatecomp[]

  @@map("competency_template")
}

// Default comment for the table, please edit me
model CompetencyTemplatecohort {
  id BigInt @id @default(autoincrement())
  templateid BigInt
  cohortid BigInt
  timecreated BigInt
  timemodified BigInt
  usermodified BigInt

  Template CompetencyTemplate @relation(fields: [templateid], references: [id])
  Cohort Cohort @relation(fields: [cohortid], references: [id])

  @@map("competency_templatecohort")
}

// Link a competency to a learning plan template.
model CompetencyTemplatecomp {
  id BigInt @id @default(autoincrement())
  templateid BigInt // The template this competency is linked to.
  competencyid BigInt // The competency that is linked to this course.
  timecreated BigInt // The time this link was created.
  timemodified BigInt // The time this link was modified.
  usermodified BigInt // The user who modified this link.
  sortorder BigInt? // Relative sort order

  Template CompetencyTemplate @relation(fields: [templateid], references: [id])
  Competency Competency @relation(fields: [competencyid], references: [id])

  @@map("competency_templatecomp")
}

// User competencies
model CompetencyUsercomp {
  id BigInt @id @default(autoincrement())
  userid BigInt // User associated to the competency.
  competencyid BigInt // Competency associated to the user.
  status Int @default(0) // Competency status.
  reviewerid BigInt? // User that reviewed the competency.
  proficiency Int? // Indicate if the competency is proficient not.
  grade BigInt? // Grade assigned to the competency.
  timecreated BigInt
  timemodified BigInt?
  usermodified BigInt

  User User @relation(fields: [userid], references: [id])
  Competency Competency @relation(fields: [competencyid], references: [id])

  CompetencyEvidence CompetencyEvidence[]

  @@map("competency_usercomp")
}

// User competencies in a course
model CompetencyUsercompcourse {
  id BigInt @id @default(autoincrement())
  userid BigInt // User associated to the competency.
  courseid BigInt // The course this competency is linked to.
  competencyid BigInt // Competency associated to the user.
  proficiency Int? // Indicate if the competency is proficient not.
  grade BigInt? // The course grade assigned for the competency.
  timecreated BigInt
  timemodified BigInt?
  usermodified BigInt

  User User @relation(fields: [userid], references: [id])
  Course Course @relation(fields: [courseid], references: [id])
  Competency Competency @relation(fields: [competencyid], references: [id])

  @@map("competency_usercompcourse")
}

// User competencies plans
model CompetencyUsercompplan {
  id BigInt @id @default(autoincrement())
  userid BigInt // User associated to the competency.
  competencyid BigInt // Competency associated to the user.
  planid BigInt // Plan associated to the user.
  proficiency Int? // Indicate if the competency is proficient not.
  grade BigInt? // Grade assigned to the competency.
  sortorder BigInt? // Relative sort order
  timecreated BigInt
  timemodified BigInt?
  usermodified BigInt

  User User @relation(fields: [userid], references: [id])
  Competency Competency @relation(fields: [competencyid], references: [id])

  @@map("competency_usercompplan")
}

// The evidence of prior learning
model CompetencyUserevidence {
  id BigInt @id @default(autoincrement())
  userid BigInt
  name String @default("")
  description String
  descriptionformat Boolean
  url String
  timecreated BigInt
  timemodified BigInt
  usermodified BigInt

  User User @relation(fields: [userid], references: [id])

  @@map("competency_userevidence")
}

// Relationship between user evidence and competencies
model CompetencyUserevidencecomp {
  id BigInt @id @default(autoincrement())
  userevidenceid BigInt
  competencyid BigInt
  timecreated BigInt
  timemodified BigInt
  usermodified BigInt

  Userevidence User @relation(fields: [userevidenceid], references: [id])
  Competency Competency @relation(fields: [competencyid], references: [id])

  @@map("competency_userevidencecomp")
}

// Moodle configuration variables
model Config {
  id BigInt @id @default(autoincrement())
  name String @default("")
  value String

  AdminpresetsAppIt AdminpresetsAppIt[]
  AdminpresetsAppItA AdminpresetsAppItA[]

  @@map("config")
}

// Changes done in server configuration through admin UI
model ConfigLog {
  id BigInt @id @default(autoincrement())
  userid BigInt
  timemodified BigInt
  plugin String?
  name String @default("")
  value String?
  oldvalue String?

  User User @relation(fields: [userid], references: [id])

  @@map("config_log")
}

// Moodle modules and plugins configuration variables
model ConfigPlugins {
  id BigInt @id @default(autoincrement())
  plugin String @default("core")
  name String @default("")
  value String

  @@map("config_plugins")
}

// This table stores content data in the content bank.
model ContentbankContent {
  id BigInt @id @default(autoincrement())
  name String @default("")
  contenttype String @default("")
  contextid BigInt // References context.id.
  visibility Boolean @default(true)
  instanceid BigInt?
  configdata String?
  usercreated BigInt // The original author of the content
  usermodified BigInt?
  timecreated BigInt @default(0)
  timemodified BigInt? @default(0)

  Context Context @relation(fields: [contextid], references: [id])
  Usercreated User @relation(name: "contentbank_content_usercreated", fields: [usercreated], references: [id])
  Usermodified User? @relation(name: "contentbank_content_usermodified", fields: [usermodified], references: [id])

  @@map("contentbank_content")
}

// one of these must be set
model Context {
  id BigInt @id @default(autoincrement())
  contextlevel BigInt @default(0)
  instanceid BigInt @default(0)
  path String?
  depth Int @default(0)
  locked Int @default(0) // Whether this context and its children are locked

  AnalyticsIndicatorCalc AnalyticsIndicatorCalc[]
  AnalyticsPredictions AnalyticsPredictions[]
  BlockInstances BlockInstances[]
  BlockPositions BlockPositions[]
  BlogAssociation BlogAssociation[]
  Cohort Cohort[]
  Comments Comments[]
  CompetencyEvidence CompetencyEvidence[]
  CompetencyFramework CompetencyFramework[]
  CompetencyTemplate CompetencyTemplate[]
  ContentbankContent ContentbankContent[]
  CustomfieldCategory CustomfieldCategory[]
  CustomfieldData CustomfieldData[]
  EditorAttoAutosave EditorAttoAutosave[]
  EnrolLtiTools EnrolLtiTools[]
  ExternalTokens ExternalTokens[]
  Favourite Favourite[]
  Files Files[]
  FilterActive FilterActive[]
  FilterConfig FilterConfig[]
  GradeLetters GradeLetters[]
  GradingAreas GradingAreas[]
  LogstoreStandardLogByContext LogstoreStandardLog[] @relation(name: "logstore_standard_log_contextid")
  LogstoreStandardLogByContextinstance LogstoreStandardLog[] @relation(name: "logstore_standard_log_contextinstanceid")
  MessageConversations MessageConversations[]
  PaymentAccounts PaymentAccounts[]
  QuestionCategories QuestionCategories[]
  QuestionReferences QuestionReferences[]
  QuestionSetReferencesByUsingcontext QuestionSetReferences[] @relation(name: "question_set_references_usingcontextid")
  QuestionSetReferencesByQuestionscontext QuestionSetReferences[] @relation(name: "question_set_references_questionscontextid")
  QuestionUsages QuestionUsages[]
  Rating Rating[]
  ReportbuilderReport ReportbuilderReport[]
  RepositoryInstances RepositoryInstances[]
  RoleAssignments RoleAssignments[]
  RoleCapabilities RoleCapabilities[]
  RoleNames RoleNames[]
  SearchIndexRequests SearchIndexRequests[]
  SearchSimpledbIndex SearchSimpledbIndex[]
  TagInstance TagInstance[]
  ToolBrickfieldAreas ToolBrickfieldAreas[]
  ToolBrickfieldProcess ToolBrickfieldProcess[]
  ToolBrickfieldSchedule ToolBrickfieldSchedule[]
  ToolDataprivacyCtxexpired ToolDataprivacyCtxexpired[]
  ToolDataprivacyCtxinstance ToolDataprivacyCtxinstance[]
  ToolMonitorEventsByContext ToolMonitorEvents[] @relation(name: "tool_monitor_events_contextid")
  ToolMonitorEventsByContextinstance ToolMonitorEvents[] @relation(name: "tool_monitor_events_contextinstanceid")

  @@map("context")
}

// Used by build_context_path() in upgrade and cron to keep con
model ContextTemp {
  id BigInt @id @default(autoincrement()) // This id isn't autonumeric/sequence. It's the context-&gt;id
  path String @default("")
  depth Int
  locked Int @default(0) // Whether this context and its children are locked

  @@map("context_temp")
}

// Central course table
model Course {
  id BigInt @id @default(autoincrement())
  category BigInt @default(0)
  sortorder BigInt @default(0)
  fullname String @default("")
  shortname String @default("")
  idnumber String @default("")
  summary String?
  summaryformat Int @default(0)
  format String @default("topics")
  showgrades Int @default(1)
  newsitems Int @default(1)
  startdate BigInt @default(0)
  enddate BigInt @default(0)
  relativedatesmode Boolean @default(false) // Whether to let this course display course- or activity-related dates relative to the user's enrolment date in this course.
  marker BigInt @default(0)
  maxbytes BigInt @default(0)
  legacyfiles Int @default(0) // course files are not necessary any more: 0 no legacy files, 1 legacy files disabled, 2 legacy files enabled
  showreports Int @default(0)
  visible Boolean @default(true)
  visibleold Boolean @default(true) // the state of visible field when hiding parent category, this helps us to recover hidden states when unhiding the parent category later
  downloadcontent Boolean?
  groupmode Int @default(0)
  groupmodeforce Int @default(0)
  defaultgroupingid BigInt @default(0) // default grouping used in course modules, does not have key intentionally
  lang String @default("")
  calendartype String @default("")
  theme String @default("")
  timecreated BigInt @default(0)
  timemodified BigInt @default(0)
  requested Boolean @default(false)
  enablecompletion Boolean @default(false) // 1 = allow use of 'completion' progress-tracking on this course. 0 = disable completion tracking on this course.
  completionnotify Boolean @default(false) // Notify users when they complete this course
  cacherev BigInt @default(0) // Incrementing revision for validating the course content cache
  originalcourseid BigInt? // the id of the source course when a new course originates from a restore of another course on the same site.
  showactivitydates Boolean @default(false) // Whether to display activity dates to user. 0 = do not display, 1 = display activity dates
  showcompletionconditions Boolean? // Whether to display completion conditions to user. 0 = do not display, 1 = display conditions

  Category CourseCategories @relation(fields: [category], references: [id])

  BackupCourses BackupCourses[]
  Badge Badge[]
  BigbluebuttonbnLogs BigbluebuttonbnLogs[]
  BigbluebuttonbnRecordings BigbluebuttonbnRecordings[]
  BlockRecentActivity BlockRecentActivity[]
  BlockRecentlyaccesseditems BlockRecentlyaccesseditems[]
  CompetencyCoursecomp CompetencyCoursecomp[]
  CompetencyCoursecompsetting CompetencyCoursecompsetting[]
  CompetencyUsercompcourse CompetencyUsercompcourse[]
  CourseCompletionAggrMethd CourseCompletionAggrMethd[]
  CourseCompletionCritCompl CourseCompletionCritCompl[]
  CourseCompletionCriteria CourseCompletionCriteria[]
  CourseCompletionDefaults CourseCompletionDefaults[]
  CourseCompletions CourseCompletions[]
  CourseFormatOptions CourseFormatOptions[]
  CourseModules CourseModules[]
  CoursePublished CoursePublished[]
  CourseSections CourseSections[]
  Enrol Enrol[]
  EnrolFlatfile EnrolFlatfile[]
  EnrolPaypal EnrolPaypal[]
  Event Event[]
  EventSubscriptions EventSubscriptions[]
  FeedbackCompleted FeedbackCompleted[]
  FeedbackCompletedtmp FeedbackCompletedtmp[]
  FeedbackSitecourseMap FeedbackSitecourseMap[]
  Folder Folder[]
  GradeCategories GradeCategories[]
  GradeCategoriesHistory GradeCategoriesHistory[]
  GradeItems GradeItems[]
  GradeItemsHistory GradeItemsHistory[]
  GradeOutcomes GradeOutcomes[]
  GradeOutcomesCourses GradeOutcomesCourses[]
  GradeOutcomesHistory GradeOutcomesHistory[]
  GradeSettings GradeSettings[]
  Groupings Groupings[]
  Groups Groups[]
  H5pactivity H5pactivity[]
  Imscp Imscp[]
  Label Label[]
  LogstoreStandardLog LogstoreStandardLog[]
  LtiToolSettings LtiToolSettings[]
  LtiserviceGradebookservices LtiserviceGradebookservices[]
  Page Page[]
  PostByCourse Post[] @relation(name: "post_courseid")
  PostByCoursemodule Post[] @relation(name: "post_coursemoduleid")
  Resource Resource[]
  Scale Scale[]
  ScaleHistory ScaleHistory[]
  SearchSimpledbIndex SearchSimpledbIndex[]
  StatsDaily StatsDaily[]
  StatsMonthly StatsMonthly[]
  StatsUserDaily StatsUserDaily[]
  StatsUserMonthly StatsUserMonthly[]
  StatsUserWeekly StatsUserWeekly[]
  StatsWeekly StatsWeekly[]
  ToolBrickfieldAreas ToolBrickfieldAreas[]
  ToolBrickfieldCacheActs ToolBrickfieldCacheActs[]
  ToolBrickfieldCacheCheck ToolBrickfieldCacheCheck[]
  ToolBrickfieldProcess ToolBrickfieldProcess[]
  ToolBrickfieldSummary ToolBrickfieldSummary[]
  ToolMonitorEvents ToolMonitorEvents[]
  ToolMonitorRules ToolMonitorRules[]
  ToolMonitorSubscriptions ToolMonitorSubscriptions[]
  ToolRecyclebinCourse ToolRecyclebinCourse[]
  Url Url[]
  UserLastaccess UserLastaccess[]
  Workshop Workshop[]

  @@map("course")
}

// Course categories
model CourseCategories {
  id BigInt @id @default(autoincrement())
  name String @default("")
  idnumber String?
  description String?
  descriptionformat Int @default(0)
  parent BigInt @default(0)
  sortorder BigInt @default(0)
  coursecount BigInt @default(0)
  visible Boolean @default(true)
  visibleold Boolean @default(true) // the state of visible field when hiding parent category, this helps us to recover hidden states when unhiding the parent category later
  timemodified BigInt @default(0)
  depth BigInt @default(0)
  path String @default("")
  theme String? // Theme for the category

  Parent CourseCategories @relation(name: "course_categories_parent", fields: [parent], references: [id])

  Course Course[]
  CourseCategoriesByParent CourseCategories[] @relation(name: "course_categories_parent")
  Event Event[]
  ToolBrickfieldAreas ToolBrickfieldAreas[]
  ToolRecyclebinCategory ToolRecyclebinCategory[]

  @@map("course_categories")
}

// Course completion aggregation methods for criteria
model CourseCompletionAggrMethd {
  id BigInt @id @default(autoincrement())
  course BigInt @default(0)
  criteriatype BigInt? // The criteria type we are aggregating, or NULL if complete course aggregation
  method Boolean @default(false) // 1 = all, 2 = any, 3 = fraction, 4 = unit
  value Decimal? // NULL = all/any, 0..1 for method 'fraction', &gt; 0 for method 'unit'

  Course Course @relation(fields: [course], references: [id])

  @@map("course_completion_aggr_methd")
}

// Course completion user records
model CourseCompletionCritCompl {
  id BigInt @id @default(autoincrement())
  userid BigInt @default(0)
  course BigInt @default(0)
  criteriaid BigInt @default(0) // Completion criteria this references
  gradefinal Decimal? // The final grade for the course (included regardless of whether a passing grade was required)
  unenroled BigInt? // Timestamp when the user was unenroled
  timecompleted BigInt?

  User User @relation(fields: [userid], references: [id])
  Course Course @relation(fields: [course], references: [id])

  @@map("course_completion_crit_compl")
}

// Course completion criteria
model CourseCompletionCriteria {
  id BigInt @id @default(autoincrement())
  course BigInt @default(0)
  criteriatype BigInt @default(0) // Type of criteria
  module String? // Type of module (if using module criteria type)
  moduleinstance BigInt? // Module instance id (if using module criteria type)
  courseinstance BigInt? // Course instance id (if using course criteria type)
  enrolperiod BigInt? // Number of days after enrolment the course is completed (if using enrolperiod criteria type)
  timeend BigInt? // Timestamp of the date for course completion (if using date criteria type)
  gradepass Decimal? // The minimum grade needed to pass the course (if passing grade criteria enabled)
  role BigInt?

  Course Course @relation(fields: [course], references: [id])

  @@map("course_completion_criteria")
}

// Default settings for activities completion
model CourseCompletionDefaults {
  id BigInt @id @default(autoincrement())
  course BigInt
  module BigInt
  completion Boolean @default(false)
  completionview Boolean @default(false)
  completionusegrade Boolean @default(false)
  completionpassgrade Boolean @default(false)
  completionexpected BigInt @default(0)
  customrules String?

  Course Course @relation(fields: [course], references: [id])
  Module Modules @relation(fields: [module], references: [id])

  @@map("course_completion_defaults")
}

// Course completion records
model CourseCompletions {
  id BigInt @id @default(autoincrement())
  userid BigInt @default(0)
  course BigInt @default(0)
  timeenrolled BigInt @default(0)
  timestarted BigInt @default(0)
  timecompleted BigInt?
  reaggregate BigInt @default(0)

  User User @relation(fields: [userid], references: [id])
  Course Course @relation(fields: [course], references: [id])

  @@map("course_completions")
}

// Stores format-specific options for the course or course sect
model CourseFormatOptions {
  id BigInt @id @default(autoincrement())
  courseid BigInt // Id of the course
  format String @default("") // Format this option is for
  sectionid BigInt @default(0) // Null if this is a course option, otherwise id of the section this option is for
  name String @default("") // Name of the format option
  value String? // Value of the format option

  Course Course @relation(fields: [courseid], references: [id])

  @@map("course_format_options")
}

// course_modules table retrofitted from MySQL
model CourseModules {
  id BigInt @id @default(autoincrement())
  course BigInt @default(0)
  module BigInt @default(0)
  instance BigInt @default(0)
  section BigInt @default(0)
  idnumber String? // customizable idnumber
  added BigInt @default(0)
  score Int @default(0)
  indent Int @default(0)
  visible Boolean @default(true)
  visibleoncoursepage Boolean @default(true) // If stealth visibility is allowed for the course, this controls whether activity is visible on course page
  visibleold Boolean @default(true)
  groupmode Int @default(0)
  groupingid BigInt @default(0)
  completion Boolean @default(false) // Whether the completion-tracking facilities are enabled for this activity. 0 = not enabled (database default) 1 = manual tracking, user can tick this activity off (UI default for most activity types) 2 = automatic tracking, system should mark completion according to rules specified in course_moduleS_completion
  completiongradeitemnumber BigInt? // Grade-item number used to track automatic completion, if applicable.
  completionview Boolean @default(false) // Controls whether a page view is part of the automatic completion requirements for this activity. 0 = view not required 1 = view required
  completionexpected BigInt @default(0) // Date at which students are expected to complete this activity. This field is used when displaying student progress.
  completionpassgrade Boolean @default(false) // Enable completion check on passing grade.
  showdescription Boolean @default(false) // Some module types support a 'description' which shows within the module pages. This option controls whether it also displays on the course main page. 0 = does not display (default), 1 = displays
  availability String? // Availability restrictions for viewing this activity, in JSON format. Null if no restrictions.
  deletioninprogress Boolean @default(false)
  downloadcontent Boolean? @default(true) // Whether the ability to download course module content is enabled for this activity

  Course Course @relation(fields: [course], references: [id])
  Grouping Groupings @relation(fields: [groupingid], references: [id])

  BlockRecentlyaccesseditems BlockRecentlyaccesseditems[]
  CompetencyModulecomp CompetencyModulecomp[]
  CourseModulesCompletion CourseModulesCompletion[]
  QuizaccessSebQuizsettings QuizaccessSebQuizsettings[]
  ToolBrickfieldAreas ToolBrickfieldAreas[]

  @@map("course_modules")
}

// Stores the completion state (completed or not completed, etc
model CourseModulesCompletion {
  id BigInt @id @default(autoincrement())
  coursemoduleid BigInt // Activity that has been completed (or not).
  userid BigInt // ID of user who has (or hasn't) completed the activity.
  completionstate Boolean // Whether or not the user has completed the activity. Available states: 0 = not completed [if there's no row in this table, that also counts as 0] 1 = completed 2 = completed, show passed 3 = completed, show failed
  viewed Boolean? // Tracks whether or not this activity has been viewed. NULL = we are not tracking viewed for this activity 0 = not viewed 1 = viewed
  overrideby BigInt? // Tracks whether this completion state has been set manually to override a previous state.
  timemodified BigInt // Time at which the completion state last changed.

  Coursemodule CourseModules @relation(fields: [coursemoduleid], references: [id])
  User User @relation(fields: [userid], references: [id])

  @@map("course_modules_completion")
}

// Information about how and when an local courses were publish
model CoursePublished {
  id BigInt @id @default(autoincrement())
  huburl String? // the url of the &quot;registered on&quot; hub
  courseid BigInt // the id of the published course
  timepublished BigInt // The time when the publication occurred
  enrollable Boolean @default(true) // 1 = enrollable, 0 = downloadable
  hubcourseid BigInt // the course id on the hub server
  status Boolean? @default(false) // is the publication published or not
  timechecked BigInt? // the last time the status has been checked

  Course Course @relation(fields: [courseid], references: [id])

  @@map("course_published")
}

// course requests
model CourseRequest {
  id BigInt @id @default(autoincrement())
  fullname String @default("")
  shortname String @default("")
  summary String
  summaryformat Int @default(0)
  category BigInt @default(0)
  reason String
  requester BigInt @default(0)
  password String @default("")

  @@map("course_request")
}

// to define the sections for each course
model CourseSections {
  id BigInt @id @default(autoincrement())
  course BigInt @default(0)
  section BigInt @default(0)
  name String?
  summary String?
  summaryformat Int @default(0)
  sequence String?
  visible Boolean @default(true)
  availability String? // Availability restrictions for viewing this section, in JSON format. Null if no restrictions.
  timemodified BigInt @default(0) // Time at which the course section was last changed.

  Course Course @relation(fields: [course], references: [id])

  @@map("course_sections")
}

// core_customfield category table
model CustomfieldCategory {
  id BigInt @id @default(autoincrement())
  name String @default("")
  description String?
  descriptionformat BigInt?
  sortorder BigInt?
  timecreated BigInt
  timemodified BigInt
  component String @default("")
  area String @default("")
  itemid BigInt @default(0)
  contextid BigInt?

  Context Context? @relation(fields: [contextid], references: [id])

  CustomfieldField CustomfieldField[]

  @@map("customfield_category")
}

// core_customfield data table
model CustomfieldData {
  id BigInt @id @default(autoincrement())
  fieldid BigInt
  instanceid BigInt
  intvalue BigInt?
  decvalue Decimal?
  shortcharvalue String?
  charvalue String?
  value String
  valueformat BigInt
  timecreated BigInt
  timemodified BigInt
  contextid BigInt?

  Field CustomfieldField @relation(fields: [fieldid], references: [id])
  Context Context? @relation(fields: [contextid], references: [id])

  @@map("customfield_data")
}

// core_customfield field table
model CustomfieldField {
  id BigInt @id @default(autoincrement())
  shortname String @default("")
  name String @default("")
  type String @default("")
  description String?
  descriptionformat BigInt?
  sortorder BigInt?
  categoryid BigInt?
  configdata String?
  timecreated BigInt
  timemodified BigInt

  Category CustomfieldCategory? @relation(fields: [categoryid], references: [id])

  CustomfieldData CustomfieldData[]

  @@map("customfield_field")
}

// all database activities
model Data {
  id BigInt @id @default(autoincrement())
  course BigInt @default(0)
  name String @default("")
  intro String
  introformat Int @default(0)
  comments Int @default(0)
  timeavailablefrom BigInt @default(0)
  timeavailableto BigInt @default(0)
  timeviewfrom BigInt @default(0)
  timeviewto BigInt @default(0)
  requiredentries Int @default(0)
  requiredentriestoview Int @default(0)
  maxentries Int @default(0)
  rssarticles Int @default(0)
  singletemplate String?
  listtemplate String?
  listtemplateheader String?
  listtemplatefooter String?
  addtemplate String?
  rsstemplate String?
  rsstitletemplate String?
  csstemplate String?
  jstemplate String?
  asearchtemplate String?
  approval Int @default(0)
  manageapproved Int @default(1)
  scale BigInt @default(0)
  assessed BigInt @default(0)
  assesstimestart BigInt @default(0)
  assesstimefinish BigInt @default(0)
  defaultsort BigInt @default(0)
  defaultsortdir Int @default(0)
  editany Int @default(0)
  notification BigInt @default(0) // Notify people when things change
  timemodified BigInt @default(0) // The time the settings for this database module instance were last modified.
  config String?
  completionentries BigInt? @default(0) // Number of entries required for completion

  DataFields DataFields[]
  DataRecords DataRecords[]

  @@map("data")
}

// the content introduced in each record/fields
model DataContent {
  id BigInt @id @default(autoincrement())
  fieldid BigInt @default(0)
  recordid BigInt @default(0)
  content String?
  content1 String?
  content2 String?
  content3 String?
  content4 String?

  Field DataFields @relation(fields: [fieldid], references: [id])
  Record DataRecords @relation(fields: [recordid], references: [id])

  @@map("data_content")
}

// every field available
model DataFields {
  id BigInt @id @default(autoincrement())
  dataid BigInt @default(0)
  type String @default("")
  name String @default("")
  description String
  required Boolean @default(false) // Required fields must have a value when inserted by a user
  param1 String?
  param2 String?
  param3 String?
  param4 String?
  param5 String?
  param6 String?
  param7 String?
  param8 String?
  param9 String?
  param10 String?

  Data Data @relation(fields: [dataid], references: [id])

  DataContent DataContent[]

  @@map("data_fields")
}

// every record introduced
model DataRecords {
  id BigInt @id @default(autoincrement())
  userid BigInt @default(0)
  groupid BigInt @default(0)
  dataid BigInt @default(0)
  timecreated BigInt @default(0)
  timemodified BigInt @default(0)
  approved Int @default(0)

  User User @relation(fields: [userid], references: [id])
  Data Data @relation(fields: [dataid], references: [id])

  DataContent DataContent[]

  @@map("data_records")
}

// Draft text that is auto-saved every 5 seconds while an edito
model EditorAttoAutosave {
  id BigInt @id @default(autoincrement())
  elementid String @default("") // The unique id for the text editor in the form.
  contextid BigInt // The contextid that the form was loaded with.
  pagehash String @default("") // The HTML DOM id of the page that loaded the form.
  userid BigInt // The id of the user that loaded the form.
  drafttext String // The draft text
  draftid BigInt? // Optional draft area id containing draft files.
  pageinstance String @default("") // The browser tab instance that last saved the draft text. This is to prevent multiple tabs from the same user saving different text alternately.
  timemodified BigInt @default(0) // Store the last modified time for the auto save text.

  Context Context @relation(fields: [contextid], references: [id])
  User User @relation(fields: [userid], references: [id])

  @@map("editor_atto_autosave")
}

// Instances of enrolment plugins used in courses, fields marke
model Enrol {
  id BigInt @id @default(autoincrement())
  enrol String @default("")
  status BigInt @default(0) // 0..9 are system constants, 0 means active enrolment, see ENROL_STATUS_* constants, plugins may define own status greater than 10
  courseid BigInt
  sortorder BigInt @default(0) // order of enrol plugins in each course
  name String? // Optional instance name
  enrolperiod BigInt? @default(0) // Custom - enrolment duration
  enrolstartdate BigInt? @default(0) // Custom - start of self enrolment
  enrolenddate BigInt? @default(0) // Custom - end of enrolment
  expirynotify Boolean? @default(false) // Custom - notify users before expiration
  expirythreshold BigInt? @default(0) // Custom - when should be the participants notified
  notifyall Boolean? @default(false) // Custom - Notify both participant and person responsible for enrolments
  password String? // Custom - enrolment or access password
  cost String? // Custom - enrolment cost
  currency String? // Custom - cost currency
  roleid BigInt? @default(0) // Custom - the default role given to participants who self-enrol
  customint1 BigInt? // Custom - general int
  customint2 BigInt? // Custom - general int
  customint3 BigInt? // Custom - general int
  customint4 BigInt? // Custom - general int
  customint5 BigInt? // Custom - general int
  customint6 BigInt? // Custom - general int
  customint7 BigInt? // Custom - general int
  customint8 BigInt? // Custom - general int
  customchar1 String? // Custom - general short name
  customchar2 String? // Custom - general short name
  customchar3 String? // Custom - general short name
  customdec1 Decimal? // Custom - general decimal
  customdec2 Decimal? // Custom - general decimal
  customtext1 String? // Custom - general text
  customtext2 String? // Custom - general text
  customtext3 String? // Custom - general text
  customtext4 String? // Custom - general text
  timecreated BigInt @default(0)
  timemodified BigInt @default(0)

  Course Course @relation(fields: [courseid], references: [id])
  Role Role? @relation(fields: [roleid], references: [id])

  EnrolLtiTools EnrolLtiTools[]
  EnrolPaypal EnrolPaypal[]
  UserEnrolments UserEnrolments[]

  @@map("enrol")
}

// enrol_flatfile table retrofitted from MySQL
model EnrolFlatfile {
  id BigInt @id @default(autoincrement())
  action String @default("")
  roleid BigInt
  userid BigInt
  courseid BigInt
  timestart BigInt @default(0)
  timeend BigInt @default(0)
  timemodified BigInt @default(0)

  Role Role @relation(fields: [roleid], references: [id])
  User User @relation(fields: [userid], references: [id])
  Course Course @relation(fields: [courseid], references: [id])

  @@map("enrol_flatfile")
}

// Details of each application that has been registered with th
model EnrolLtiAppRegistration {
  id BigInt @id @default(autoincrement())
  name String @default("") // Common name to identify this platform to users
  platformid String? // The issuer URL
  clientid String? // The clientid string, generated by the platform when setting up the tool.
  uniqueid String @default("") // A unique local id, which can be used in the initiate login URI to provide {iss, clientid} uniqueness in the absence of the optional client_id claim.
  platformclienthash String? // SHA256 hash of the platformid (issuer) and clientid
  platformuniqueidhash String? // SHA256 hash of the platformid (issuer) and uniqueid
  authenticationrequesturl String? // The authorisation endpoint of the platform
  jwksurl String? // The JSON Web Key Set URL for the platform
  accesstokenurl String?
  status Boolean @default(false) // Status of the registration, used to denote draft (incomplete) or active (complete)
  timecreated BigInt
  timemodified BigInt

  EnrolLtiDeployment EnrolLtiDeployment[]

  @@map("enrol_lti_app_registration")
}

// Each row represents a context in the platform, where resourc
model EnrolLtiContext {
  id BigInt @id @default(autoincrement())
  contextid String @default("") // The id of the context on the platform
  ltideploymentid BigInt // The id of the enrol_lti_deployment record containing the deployment information.
  type String? // The type of the context on the platform
  timecreated BigInt
  timemodified BigInt

  Ltideployment EnrolLtiDeployment @relation(fields: [ltideploymentid], references: [id])

  EnrolLtiResourceLink EnrolLtiResourceLink[]

  @@map("enrol_lti_context")
}

// Each row represents a deployment of a tool within a platform
model EnrolLtiDeployment {
  id BigInt @id @default(autoincrement())
  name String @default("") // A short name identifying the tool deployment to users
  deploymentid String @default("") // The id of the deployment, as defined in the platform
  platformid BigInt // The platformid to which this deployment belongs
  legacyconsumerkey String? // The legacy consumer key mapped to this deployment, if the deployment represents a migrated tool.
  timecreated BigInt
  timemodified BigInt

  Platform EnrolLtiAppRegistration @relation(fields: [platformid], references: [id])

  EnrolLtiContext EnrolLtiContext[]
  EnrolLtiResourceLink EnrolLtiResourceLink[]
  EnrolLtiUsers EnrolLtiUsers[]

  @@map("enrol_lti_deployment")
}

// LTI consumers interacting with moodle
model EnrolLtiLti2Consumer {
  id BigInt @id @default(autoincrement())
  name String @default("")
  consumerkey256 String @default("")
  consumerkey String?
  secret String @default("")
  ltiversion String?
  consumername String?
  consumerversion String?
  consumerguid String?
  profile String?
  toolproxy String?
  settings String?
  protected Boolean
  enabled Boolean
  enablefrom BigInt?
  enableuntil BigInt?
  lastaccess BigInt?
  created BigInt
  updated BigInt

  EnrolLtiLti2Context EnrolLtiLti2Context[]
  EnrolLtiLti2Nonce EnrolLtiLti2Nonce[]
  EnrolLtiLti2ResourceLink EnrolLtiLti2ResourceLink[]
  EnrolLtiLti2ToolProxy EnrolLtiLti2ToolProxy[]
  EnrolLtiToolConsumerMap EnrolLtiToolConsumerMap[]

  @@map("enrol_lti_lti2_consumer")
}

// Information about a specific LTI contexts from the consumers
model EnrolLtiLti2Context {
  id BigInt @id @default(autoincrement())
  consumerid BigInt
  lticontextkey String @default("")
  type String?
  settings String?
  created BigInt
  updated BigInt

  Consumer EnrolLtiLti2Consumer @relation(fields: [consumerid], references: [id])

  EnrolLtiLti2ResourceLink EnrolLtiLti2ResourceLink[]

  @@map("enrol_lti_lti2_context")
}

// Nonce used for authentication between moodle and a consumer
model EnrolLtiLti2Nonce {
  id BigInt @id @default(autoincrement())
  consumerid BigInt
  value String @default("")
  expires BigInt

  Consumer EnrolLtiLti2Consumer @relation(fields: [consumerid], references: [id])

  @@map("enrol_lti_lti2_nonce")
}

// Link from the consumer to the tool
model EnrolLtiLti2ResourceLink {
  id BigInt @id @default(autoincrement())
  contextid BigInt?
  consumerid BigInt?
  ltiresourcelinkkey String @default("")
  settings String?
  primaryresourcelinkid BigInt?
  shareapproved Boolean?
  created BigInt
  updated BigInt

  Context EnrolLtiLti2Context? @relation(fields: [contextid], references: [id])
  Consumer EnrolLtiLti2Consumer? @relation(fields: [consumerid], references: [id])
  Primaryresourcelink EnrolLtiLti2ResourceLink? @relation(name: "enrol_lti_lti2_resource_link_primaryresourcelinkid", fields: [primaryresourcelinkid], references: [id])

  EnrolLtiLti2ResourceLinkByPrimaryresourcelink EnrolLtiLti2ResourceLink[] @relation(name: "enrol_lti_lti2_resource_link_primaryresourcelinkid")
  EnrolLtiLti2ShareKey EnrolLtiLti2ShareKey[]
  EnrolLtiLti2UserResult EnrolLtiLti2UserResult[]

  @@map("enrol_lti_lti2_resource_link")
}

// Resource link share key
model EnrolLtiLti2ShareKey {
  id BigInt @id @default(autoincrement())
  sharekey String @default("")
  resourcelinkid BigInt
  autoapprove Boolean
  expires BigInt

  Resourcelink EnrolLtiLti2ResourceLink @relation(fields: [resourcelinkid], references: [id])

  @@map("enrol_lti_lti2_share_key")
}

// A tool proxy between moodle and a consumer
model EnrolLtiLti2ToolProxy {
  id BigInt @id @default(autoincrement())
  toolproxykey String @default("")
  consumerid BigInt
  toolproxy String
  created BigInt
  updated BigInt

  Consumer EnrolLtiLti2Consumer @relation(fields: [consumerid], references: [id])

  @@map("enrol_lti_lti2_tool_proxy")
}

// Results for each user for each resource link
model EnrolLtiLti2UserResult {
  id BigInt @id @default(autoincrement())
  resourcelinkid BigInt
  ltiuserkey String @default("")
  ltiresultsourcedid String @default("")
  created BigInt
  updated BigInt

  Resourcelink EnrolLtiLti2ResourceLink @relation(fields: [resourcelinkid], references: [id])

  @@map("enrol_lti_lti2_user_result")
}

// Each row represents a resource link for a platform and deplo
model EnrolLtiResourceLink {
  id BigInt @id @default(autoincrement())
  resourcelinkid String @default("") // The platform-and-deployment-unique id of the resource link
  ltideploymentid BigInt // The id of the enrol_lti_deployment record containing the deployment information.
  resourceid BigInt // The id of the local enrol_lti_tools record containing information about the published resource to which this resource link relates.
  lticontextid BigInt? // The id of the enrol_lti_context record containing information about the context from which this resource link originates.
  lineitemsservice String? // The URL for the line items service for this resource link
  lineitemservice String? // The URL for the line item service (if only one line item present).
  lineitemscope String? // The ags line items authorization scope
  resultscope String? // The ags result authorization scope
  scorescope String? // The ags score items authorization scope
  contextmembershipsurl String? // The NRPS membership URL
  nrpsserviceversions String? // The NRPS supported service versions
  timecreated BigInt
  timemodified BigInt

  Ltideployment EnrolLtiDeployment @relation(fields: [ltideploymentid], references: [id])
  Resource Resource @relation(fields: [resourceid], references: [id])
  Lticontext EnrolLtiContext? @relation(fields: [lticontextid], references: [id])

  EnrolLtiUserResourceLink EnrolLtiUserResourceLink[]

  @@map("enrol_lti_resource_link")
}

// Table that maps the published tool to tool consumers.
model EnrolLtiToolConsumerMap {
  id BigInt @id @default(autoincrement())
  toolid BigInt // The tool ID.
  consumerid BigInt // The consumer ID.

  Tool EnrolLtiTools @relation(fields: [toolid], references: [id])
  Consumer EnrolLtiLti2Consumer @relation(fields: [consumerid], references: [id])

  @@map("enrol_lti_tool_consumer_map")
}

// List of tools provided to the remote system
model EnrolLtiTools {
  id BigInt @id @default(autoincrement())
  enrolid BigInt
  contextid BigInt
  ltiversion String @default("LTI-1p3")
  institution String @default("")
  lang String @default("en")
  timezone String @default("99")
  maxenrolled BigInt @default(0)
  maildisplay Int @default(2)
  city String @default("")
  country String @default("")
  gradesync Boolean @default(false)
  gradesynccompletion Boolean @default(false)
  membersync Boolean @default(false)
  membersyncmode Boolean @default(false)
  roleinstructor BigInt
  rolelearner BigInt
  secret String?
  uuid String?
  provisioningmodelearner Int?
  provisioningmodeinstructor Int?
  timecreated BigInt
  timemodified BigInt

  Enrol Enrol @relation(fields: [enrolid], references: [id])
  Context Context @relation(fields: [contextid], references: [id])

  EnrolLtiToolConsumerMap EnrolLtiToolConsumerMap[]
  EnrolLtiUsers EnrolLtiUsers[]

  @@map("enrol_lti_tools")
}

// Join table mapping users to resource links as this is a many
model EnrolLtiUserResourceLink {
  id BigInt @id @default(autoincrement())
  ltiuserid BigInt // The id of the enrol_lti_users record
  resourcelinkid BigInt // The id of the enrol_lti_resource_link record.

  Ltiuser EnrolLtiUsers @relation(fields: [ltiuserid], references: [id])
  Resourcelink EnrolLtiResourceLink @relation(fields: [resourcelinkid], references: [id])

  @@map("enrol_lti_user_resource_link")
}

// User access log and gradeback data
model EnrolLtiUsers {
  id BigInt @id @default(autoincrement())
  userid BigInt
  toolid BigInt
  serviceurl String?
  sourceid String?
  ltideploymentid BigInt?
  consumerkey String?
  consumersecret String?
  membershipsurl String?
  membershipsid String?
  lastgrade Decimal? // The last grade that was sent
  lastaccess BigInt? // The time the user last accessed
  timecreated BigInt? // The time the user was created

  User User @relation(fields: [userid], references: [id])
  Tool EnrolLtiTools @relation(fields: [toolid], references: [id])
  Ltideployment EnrolLtiDeployment? @relation(fields: [ltideploymentid], references: [id])

  EnrolLtiUserResourceLink EnrolLtiUserResourceLink[]

  @@map("enrol_lti_users")
}

// Holds all known information about PayPal transactions
model EnrolPaypal {
  id BigInt @id @default(autoincrement())
  business String @default("")
  receiver_email String @default("")
  receiver_id String @default("")
  item_name String @default("")
  courseid BigInt @default(0)
  userid BigInt @default(0)
  instanceid BigInt @default(0)
  memo String @default("")
  tax String @default("")
  option_name1 String @default("")
  option_selection1_x String @default("")
  option_name2 String @default("")
  option_selection2_x String @default("")
  payment_status String @default("")
  pending_reason String @default("")
  reason_code String @default("")
  txn_id String @default("")
  parent_txn_id String @default("")
  payment_type String @default("")
  timeupdated BigInt @default(0)

  Course Course @relation(fields: [courseid], references: [id])
  User User @relation(fields: [userid], references: [id])
  Instance Enrol @relation(fields: [instanceid], references: [id])

  @@map("enrol_paypal")
}

// For everything with a time associated to it
model Event {
  id BigInt @id @default(autoincrement())
  name String
  description String
  format Int @default(0)
  categoryid BigInt @default(0)
  courseid BigInt @default(0)
  groupid BigInt @default(0)
  userid BigInt @default(0)
  repeatid BigInt @default(0)
  component String? // Component that created this event, if specified, only component itself can edit and delete it
  modulename String @default("")
  instance BigInt @default(0)
  type Int @default(0)
  eventtype String @default("")
  timestart BigInt @default(0)
  timeduration BigInt @default(0)
  timesort BigInt?
  visible Int @default(1)
  uuid String @default("")
  sequence BigInt @default(1)
  timemodified BigInt @default(0)
  subscriptionid BigInt? // The event_subscription id this event is associated with.
  priority BigInt? // The event's display priority. For multiple events with the same module name, instance and eventtype (e.g. for group overrides), the one with the higher priority will be displayed.
  location String? // Event Location

  Category CourseCategories @relation(fields: [categoryid], references: [id])
  Course Course @relation(fields: [courseid], references: [id])
  User User @relation(fields: [userid], references: [id])
  Subscription EventSubscriptions? @relation(fields: [subscriptionid], references: [id])

  @@map("event")
}

// Tracks subscriptions to remote calendars.
model EventSubscriptions {
  id BigInt @id @default(autoincrement())
  url String @default("")
  categoryid BigInt @default(0)
  courseid BigInt @default(0)
  groupid BigInt @default(0)
  userid BigInt @default(0)
  eventtype String @default("") // The type of the event
  pollinterval BigInt @default(0) // Frequency of checks for new/changed events
  lastupdated BigInt?
  name String @default("")

  Course Course @relation(fields: [courseid], references: [id])
  User User @relation(fields: [userid], references: [id])

  Event Event[]

  @@map("event_subscriptions")
}

// This table is for storing which components requests what typ
model EventsHandlers {
  id BigInt @id @default(autoincrement())
  eventname String @default("") // name of the event, e.g. 'grade_updated'
  component String @default("") // e.g. moodle, mod_forum, block_rss_client
  handlerfile String @default("") // path to the file of the function, eg /grade/export/lib.php
  handlerfunction String? // serialized string or array describing function, suitable to be passed to call_user_func()
  schedule String? // 'cron' or 'instant'.
  status BigInt @default(0) // number of failed attempts to process this handler
  internal Int @default(1) // 1 means standard plugin handler, 0 indicates if event handler sends data to external systems, this is used for example to prevent immediate sending of events from pending db transactions

  EventsQueueHandlers EventsQueueHandlers[]

  @@map("events_handlers")
}

// This table is for storing queued events. It stores only one
model EventsQueue {
  id BigInt @id @default(autoincrement())
  eventdata String // serialized version of the data object passed to the event handler.
  stackdump String? // serialized debug_backtrace showing where the event was fired from
  userid BigInt? // $USER-&amp;gt;id when the event was fired
  timecreated BigInt // time stamp of the first time this was added

  User User? @relation(fields: [userid], references: [id])

  EventsQueueHandlers EventsQueueHandlers[]

  @@map("events_queue")
}

// This is the list of queued handlers for processing. The even
model EventsQueueHandlers {
  id BigInt @id @default(autoincrement())
  queuedeventid BigInt // foreign key id corresponding to the id of the event_queues table
  handlerid BigInt // foreign key id corresponding to the id of the event_handlers table
  status BigInt? // number of failed attempts to process this handler
  errormessage String? // if an error happened last time we tried to process this event, record it here.
  timemodified BigInt // time stamp of the last attempt to run this from the queue

  Queuedevent EventsQueue @relation(fields: [queuedeventid], references: [id])
  Handler EventsHandlers @relation(fields: [handlerid], references: [id])

  @@map("events_queue_handlers")
}

// list of all external functions
model ExternalFunctions {
  id BigInt @id @default(autoincrement())
  name String @default("")
  classname String @default("")
  methodname String @default("")
  classpath String?
  component String @default("")
  capabilities String? // all capabilities that are required to be run by the function (separated by comma)
  services String? // all the services (by shortname) where this function must be included

  @@map("external_functions")
}

// built in and custom external services
model ExternalServices {
  id BigInt @id @default(autoincrement())
  name String @default("")
  enabled Boolean
  requiredcapability String?
  restrictedusers Boolean
  component String?
  timecreated BigInt
  timemodified BigInt?
  shortname String? // a unique shortname
  downloadfiles Boolean @default(false) // 1 if the service allow people to download file from webservice/plugins.php - 0 if not
  uploadfiles Boolean @default(false) // 1 if the service allow people to upload files to webservice/upload.php - 0 if not

  ExternalServicesFunctions ExternalServicesFunctions[]
  ExternalServicesUsers ExternalServicesUsers[]
  ExternalTokens ExternalTokens[]

  @@map("external_services")
}

// lists functions available in each service group
model ExternalServicesFunctions {
  id BigInt @id @default(autoincrement())
  externalserviceid BigInt
  functionname String @default("")

  Externalservice ExternalServices @relation(fields: [externalserviceid], references: [id])

  @@map("external_services_functions")
}

// users allowed to use services with restricted users flag
model ExternalServicesUsers {
  id BigInt @id @default(autoincrement())
  externalserviceid BigInt
  userid BigInt
  iprestriction String? // ip restriction
  validuntil BigInt? // timestampt - valid until data
  timecreated BigInt? // created timestamp

  Externalservice ExternalServices @relation(fields: [externalserviceid], references: [id])
  User User @relation(fields: [userid], references: [id])

  @@map("external_services_users")
}

// Security tokens for accessing of external services
model ExternalTokens {
  id BigInt @id @default(autoincrement())
  token String @default("") // security token, aka private access key
  privatetoken String? // private token, generated at the same time that the token, must be stored safely by the ws client, to be transmitted only via https
  tokentype Int // type of token: 0=permanent, no session; 1=linked to current browser session via sid; 2=permanent, with emulated session
  userid BigInt // owner of the token
  externalserviceid BigInt
  sid String? // link to browser or emulated session
  contextid BigInt // context id where in token valid
  creatorid BigInt @default(1) // user id of the token creator (useful to know when the administrator created a token and so display the token to a specific administrator)
  iprestriction String? // ip restriction
  validuntil BigInt? // timestampt - valid until data
  timecreated BigInt // created timestamp
  lastaccess BigInt? // last access timestamp

  User User @relation(name: "external_tokens_userid", fields: [userid], references: [id])
  Externalservice ExternalServices @relation(fields: [externalserviceid], references: [id])
  Context Context @relation(fields: [contextid], references: [id])
  Creator User @relation(name: "external_tokens_creatorid", fields: [creatorid], references: [id])

  @@map("external_tokens")
}

// Stores the relationship between an arbitrary item (itemtype,
model Favourite {
  id BigInt @id @default(autoincrement())
  component String @default("") // Defines the Moodle component in which the favourite was created.
  itemtype String @default("") // The type of the item which is being favourited. Usually a table name, but doesn't have to be. E.g. 'messages' or 'message_conversations'.
  itemid BigInt // The identifier of the item which is being favourited.
  contextid BigInt // The context id of the item being favourited
  userid BigInt // The id of the user to whom the favourite belongs
  ordering BigInt? // Optional ordering of the favourite within its context area. For example, this allows things like sorting favourite message conversations.
  timecreated BigInt // Creation time
  timemodified BigInt // Last modification time

  Context Context @relation(fields: [contextid], references: [id])
  User User @relation(fields: [userid], references: [id])

  @@map("favourite")
}

// all feedbacks
model Feedback {
  id BigInt @id @default(autoincrement())
  course BigInt @default(0)
  name String @default("")
  intro String
  introformat Int @default(0)
  anonymous Boolean @default(true)
  email_notification Boolean @default(true)
  multiple_submit Boolean @default(true)
  autonumbering Boolean @default(true)
  site_after_submit String @default("")
  page_after_submit String
  page_after_submitformat Int @default(0)
  publish_stats Boolean @default(false)
  timeopen BigInt @default(0)
  timeclose BigInt @default(0)
  timemodified BigInt @default(0)
  completionsubmit Boolean @default(false) // If this field is set to 1, then the activity will be automatically marked as 'complete' once the user submits their choice.

  FeedbackCompleted FeedbackCompleted[]
  FeedbackCompletedtmp FeedbackCompletedtmp[]
  FeedbackItem FeedbackItem[]
  FeedbackSitecourseMap FeedbackSitecourseMap[]

  @@map("feedback")
}

// filled out feedback
model FeedbackCompleted {
  id BigInt @id @default(autoincrement())
  feedback BigInt @default(0)
  userid BigInt @default(0)
  timemodified BigInt @default(0)
  random_response BigInt @default(0)
  anonymous_response Boolean @default(false)
  courseid BigInt @default(0)

  Feedback Feedback @relation(fields: [feedback], references: [id])
  User User @relation(fields: [userid], references: [id])
  Course Course @relation(fields: [courseid], references: [id])

  @@map("feedback_completed")
}

// filled out feedback
model FeedbackCompletedtmp {
  id BigInt @id @default(autoincrement())
  feedback BigInt @default(0)
  userid BigInt @default(0)
  guestid String @default("")
  timemodified BigInt @default(0)
  random_response BigInt @default(0)
  anonymous_response Boolean @default(false)
  courseid BigInt @default(0)

  Feedback Feedback @relation(fields: [feedback], references: [id])
  User User @relation(fields: [userid], references: [id])
  Course Course @relation(fields: [courseid], references: [id])

  @@map("feedback_completedtmp")
}

// feedback_items
model FeedbackItem {
  id BigInt @id @default(autoincrement())
  feedback BigInt @default(0)
  template BigInt @default(0)
  name String @default("")
  label String @default("")
  presentation String
  typ String @default("")
  hasvalue Boolean @default(false)
  position Int @default(0)
  required Boolean @default(false)
  dependitem BigInt @default(0)
  dependvalue String @default("")
  options String @default("")

  Feedback Feedback @relation(fields: [feedback], references: [id])
  Template FeedbackTemplate @relation(fields: [template], references: [id])

  FeedbackValue FeedbackValue[]
  FeedbackValuetmp FeedbackValuetmp[]

  @@map("feedback_item")
}

// feedback sitecourse map
model FeedbackSitecourseMap {
  id BigInt @id @default(autoincrement())
  feedbackid BigInt @default(0)
  courseid BigInt @default(0)

  Feedback Feedback @relation(fields: [feedbackid], references: [id])
  Course Course @relation(fields: [courseid], references: [id])

  @@map("feedback_sitecourse_map")
}

// templates of feedbackstructures
model FeedbackTemplate {
  id BigInt @id @default(autoincrement())
  course BigInt @default(0)
  ispublic Boolean @default(false)
  name String @default("")

  FeedbackItem FeedbackItem[]

  @@map("feedback_template")
}

// values of the completeds
model FeedbackValue {
  id BigInt @id @default(autoincrement())
  course_id BigInt @default(0)
  item BigInt @default(0)
  completed BigInt @default(0)
  tmp_completed BigInt @default(0)
  value String

  Item FeedbackItem @relation(fields: [item], references: [id])

  @@map("feedback_value")
}

// values of the completedstmp
model FeedbackValuetmp {
  id BigInt @id @default(autoincrement())
  course_id BigInt @default(0)
  item BigInt @default(0)
  completed BigInt @default(0)
  tmp_completed BigInt @default(0)
  value String

  Item FeedbackItem @relation(fields: [item], references: [id])

  @@map("feedback_valuetmp")
}

// Table to track file conversions.
model FileConversion {
  id BigInt @id @default(autoincrement())
  usermodified BigInt
  timecreated BigInt
  timemodified BigInt
  sourcefileid BigInt
  targetformat String @default("")
  status BigInt? @default(0)
  statusmessage String?
  converter String?
  destfileid BigInt?
  data String?

  Sourcefile Files @relation(name: "file_conversion_sourcefileid", fields: [sourcefileid], references: [id])
  Destfile Files? @relation(name: "file_conversion_destfileid", fields: [destfileid], references: [id])

  @@map("file_conversion")
}

// description of files, content is stored in sha1 file pool
model Files {
  id BigInt @id @default(autoincrement())
  contenthash String @default("") // sha1 hash of file content
  pathnamehash String @default("") // complete file path sha1 hash - unique for each file
  contextid BigInt // The context id defined in context table - identifies the instance of plugin owning the file
  component String @default("") // Full name of the component owning the area
  filearea String @default("") // Like &quot;coursefiles&quot;. &quot;submission&quot;, &quot;intro&quot; and &quot;content&quot; (images and swf linked from summaries), etc.
  itemid BigInt // Optional - some plugin specific item id (eg. forum post, blog entry or assignment submission, user id for user files)
  filepath String @default("") // Optional - relative path to file from module content root, useful in Scorm and Resource mod - most of the mods do not need this
  filename String @default("") // The full Unicode name of this file (case sensitive) - some chars are not allowed though
  userid BigInt? // Optional - general userid field - meaning depending on plugin
  filesize BigInt
  mimetype String? // type of file - jpeg image, open document spreadsheet
  status BigInt @default(0) // number greater than 0 means something is wrong with this file (virus, missing, etc.)
  source String? // contains the reference if the file is imported from external sites
  author String? // The original author of the file
  license String? // license of the file to guide reuse
  timecreated BigInt
  timemodified BigInt
  sortorder BigInt @default(0) // order of files
  referencefileid BigInt? // Use to indicate file is a proxy for repository file

  Context Context @relation(fields: [contextid], references: [id])
  User User? @relation(fields: [userid], references: [id])
  Referencefile FilesReference? @relation(fields: [referencefileid], references: [id])

  AnalyticsUsedFiles AnalyticsUsedFiles[]
  FileConversionBySourcefile FileConversion[] @relation(name: "file_conversion_sourcefileid")
  FileConversionByDestfile FileConversion[] @relation(name: "file_conversion_destfileid")

  @@map("files")
}

// Store files references
model FilesReference {
  id BigInt @id @default(autoincrement())
  repositoryid BigInt
  lastsync BigInt? // Last time the proxy file was synced with repository
  reference String? // Identification of the external file. Repository plugins are interpreting it to locate the external file.
  referencehash String @default("") // Internal implementation detail, contains SHA1 hash of the reference field. Can be indexed and used for comparison. Not meant to be used by a non-core code.

  Repository RepositoryInstances @relation(fields: [repositoryid], references: [id])

  Files Files[]

  @@map("files_reference")
}

// Stores information about which filters are active in which c
model FilterActive {
  id BigInt @id @default(autoincrement())
  filter String @default("") // The filter internal name, like 'tex'.
  contextid BigInt // References context.id.
  active Int // Whether this filter is active in this context. +1 = On, -1 = Off, no row with this contextid = inherit. As a special case, when contextid points to the system context, -9999 means this filter is completely disabled.
  sortorder BigInt @default(0) // Only relevant if contextid points to the system context. In other cases this field should contain 0. The order in which the filters should be applied.

  Context Context @relation(fields: [contextid], references: [id])

  @@map("filter_active")
}

// Stores per-context configuration settings for filters which
model FilterConfig {
  id BigInt @id @default(autoincrement())
  filter String @default("") // The filter internal name, like 'tex'.
  contextid BigInt // References context.id.
  name String @default("") // The config variable name.
  value String? // The correspoding config variable value.

  Context Context @relation(fields: [contextid], references: [id])

  @@map("filter_config")
}

// each record is one folder resource
model Folder {
  id BigInt @id @default(autoincrement())
  course BigInt @default(0)
  name String @default("")
  intro String?
  introformat Int @default(0)
  revision BigInt @default(0) // incremented when after each file changes, solves browser caching issues
  timemodified BigInt @default(0)
  display Int @default(0) // Display type of folder contents - on a separate page or inline
  showexpanded Boolean @default(true) // 1 = expanded, 0 = collapsed for sub-folders
  showdownloadfolder Boolean @default(true) // 1 = show download folder button
  forcedownload Boolean @default(true) // 1 = force download of individual files

  Course Course @relation(fields: [course], references: [id])

  @@map("folder")
}

// Forums contain and structure discussion
model Forum {
  id BigInt @id @default(autoincrement())
  course BigInt @default(0)
  type String @default("general")
  name String @default("")
  intro String
  introformat Int @default(0) // text format of intro field
  duedate BigInt @default(0) // A due date to show in the calendar. Not used for grading.
  cutoffdate BigInt @default(0) // The final date after which forum posts will no longer be accepted for this forum.
  assessed BigInt @default(0)
  assesstimestart BigInt @default(0)
  assesstimefinish BigInt @default(0)
  scale BigInt @default(0)
  grade_forum BigInt @default(0)
  grade_forum_notify Int @default(0)
  maxbytes BigInt @default(0)
  maxattachments BigInt @default(1) // Number of attachments allowed per post
  forcesubscribe Boolean @default(false)
  trackingtype Int @default(1)
  rsstype Int @default(0)
  rssarticles Int @default(0)
  timemodified BigInt @default(0)
  warnafter BigInt @default(0)
  blockafter BigInt @default(0)
  blockperiod BigInt @default(0)
  completiondiscussions Int @default(0) // Nonzero if a certain number of posts are required to mark this forum completed for a user.
  completionreplies Int @default(0) // Nonzero if a certain number of replies are required to mark this forum complete for a user.
  completionposts Int @default(0) // Nonzero if a certain number of posts or replies (total) are required to mark this forum complete for a user.
  displaywordcount Boolean @default(false)
  lockdiscussionafter BigInt @default(0)

  ForumDigests ForumDigests[]
  ForumDiscussionSubs ForumDiscussionSubs[]
  ForumDiscussions ForumDiscussions[]
  ForumGrades ForumGrades[]
  ForumRead ForumRead[]
  ForumSubscriptions ForumSubscriptions[]
  ForumTrackPrefsByUser ForumTrackPrefs[] @relation(name: "forum_track_prefs_userid")
  ForumTrackPrefsByForum ForumTrackPrefs[] @relation(name: "forum_track_prefs_forumid")

  @@map("forum")
}

// Keeps track of user mail delivery preferences for each forum
model ForumDigests {
  id BigInt @id @default(autoincrement())
  userid BigInt
  forum BigInt
  maildigest Boolean

  User User @relation(fields: [userid], references: [id])
  Forum Forum @relation(fields: [forum], references: [id])

  @@map("forum_digests")
}

// Users may choose to subscribe and unsubscribe from specific
model ForumDiscussionSubs {
  id BigInt @id @default(autoincrement())
  forum BigInt
  userid BigInt
  discussion BigInt
  preference BigInt @default(1)

  Forum Forum @relation(fields: [forum], references: [id])
  User User @relation(fields: [userid], references: [id])
  Discussion ForumDiscussions @relation(fields: [discussion], references: [id])

  @@map("forum_discussion_subs")
}

// Forums are composed of discussions
model ForumDiscussions {
  id BigInt @id @default(autoincrement())
  course BigInt @default(0)
  forum BigInt @default(0)
  name String @default("")
  firstpost BigInt @default(0)
  userid BigInt @default(0)
  groupid BigInt @default(-1)
  assessed Boolean @default(true)
  timemodified BigInt @default(0)
  usermodified BigInt @default(0)
  timestart BigInt @default(0)
  timeend BigInt @default(0)
  pinned Boolean @default(false)
  timelocked BigInt @default(0)

  Forum Forum @relation(fields: [forum], references: [id])
  User User @relation(fields: [userid], references: [id])

  ForumDiscussionSubs ForumDiscussionSubs[]
  ForumPosts ForumPosts[]
  ForumQueue ForumQueue[]
  ForumRead ForumRead[]

  @@map("forum_discussions")
}

// Grading data for forum instances
model ForumGrades {
  id BigInt @id @default(autoincrement())
  forum BigInt // The ID of the forum that this grade relates to
  itemnumber BigInt // The grade itemnumber
  userid BigInt // The user who was graded
  grade Decimal? // The numerical grade for this user's forum assessment. Can be determined by scales/advancedgradingforms etc but will always be converted back to a floating point number.
  timecreated BigInt
  timemodified BigInt

  Forum Forum @relation(fields: [forum], references: [id])
  User User @relation(fields: [userid], references: [id])

  @@map("forum_grades")
}

// All posts are stored in this table
model ForumPosts {
  id BigInt @id @default(autoincrement())
  discussion BigInt @default(0)
  parent BigInt @default(0)
  userid BigInt @default(0)
  created BigInt @default(0)
  modified BigInt @default(0)
  mailed Int @default(0)
  subject String @default("")
  message String
  messageformat Int @default(0)
  messagetrust Int @default(0)
  attachment String @default("")
  totalscore Int @default(0)
  mailnow BigInt @default(0)
  deleted Boolean @default(false)
  privatereplyto BigInt @default(0)
  wordcount BigInt?
  charcount BigInt?

  Discussion ForumDiscussions @relation(fields: [discussion], references: [id])
  Parent ForumPosts @relation(name: "forum_posts_parent", fields: [parent], references: [id])
  User User @relation(fields: [userid], references: [id])

  ForumPostsByParent ForumPosts[] @relation(name: "forum_posts_parent")
  ForumQueue ForumQueue[]
  ForumRead ForumRead[]

  @@map("forum_posts")
}

// For keeping track of posts that will be mailed in digest for
model ForumQueue {
  id BigInt @id @default(autoincrement())
  userid BigInt @default(0)
  discussionid BigInt @default(0)
  postid BigInt @default(0)
  timemodified BigInt @default(0) // The modified time of the original post

  User User @relation(fields: [userid], references: [id])
  Discussion ForumDiscussions @relation(fields: [discussionid], references: [id])
  Post ForumPosts @relation(fields: [postid], references: [id])

  @@map("forum_queue")
}

// Tracks each users read posts
model ForumRead {
  id BigInt @id @default(autoincrement())
  userid BigInt @default(0)
  forumid BigInt @default(0)
  discussionid BigInt @default(0)
  postid BigInt @default(0)
  firstread BigInt @default(0)
  lastread BigInt @default(0)

  User User @relation(fields: [userid], references: [id])
  Forum Forum @relation(fields: [forumid], references: [id])
  Discussion ForumDiscussions @relation(fields: [discussionid], references: [id])
  Post ForumPosts @relation(fields: [postid], references: [id])

  @@map("forum_read")
}

// Keeps track of who is subscribed to what forum
model ForumSubscriptions {
  id BigInt @id @default(autoincrement())
  userid BigInt @default(0)
  forum BigInt @default(0)

  User User @relation(fields: [userid], references: [id])
  Forum Forum @relation(fields: [forum], references: [id])

  @@map("forum_subscriptions")
}

// Tracks each users untracked forums
model ForumTrackPrefs {
  id BigInt @id @default(autoincrement())
  userid BigInt @default(0)
  forumid BigInt @default(0)

  User Forum @relation(name: "forum_track_prefs_userid", fields: [userid], references: [id])
  Forum Forum @relation(name: "forum_track_prefs_forumid", fields: [forumid], references: [id])

  @@map("forum_track_prefs")
}

// all glossaries
model Glossary {
  id BigInt @id @default(autoincrement())
  course BigInt @default(0)
  name String @default("")
  intro String
  introformat Int @default(0)
  allowduplicatedentries Int @default(0)
  displayformat String @default("dictionary")
  mainglossary Int @default(0)
  showspecial Int @default(1)
  showalphabet Int @default(1)
  showall Int @default(1)
  allowcomments Int @default(0)
  allowprintview Int @default(1)
  usedynalink Int @default(1)
  defaultapproval Int @default(1)
  approvaldisplayformat String @default("default") // Display Format when approving entries
  globalglossary Int @default(0)
  entbypage Int @default(10)
  editalways Int @default(0)
  rsstype Int @default(0)
  rssarticles Int @default(0)
  assessed BigInt @default(0)
  assesstimestart BigInt @default(0)
  assesstimefinish BigInt @default(0)
  scale BigInt @default(0)
  timecreated BigInt @default(0)
  timemodified BigInt @default(0)
  completionentries Int @default(0) // Non zero if a certain number of entries are required to mark this glossary complete for a user.

  GlossaryCategories GlossaryCategories[]
  GlossaryEntries GlossaryEntries[]

  @@map("glossary")
}

// entries alias
model GlossaryAlias {
  id BigInt @id @default(autoincrement())
  entryid BigInt @default(0)
  alias String @default("")

  Entry GlossaryEntries @relation(fields: [entryid], references: [id])

  @@map("glossary_alias")
}

// all categories for glossary entries
model GlossaryCategories {
  id BigInt @id @default(autoincrement())
  glossaryid BigInt @default(0)
  name String @default("")
  usedynalink Int @default(1)

  Glossary Glossary @relation(fields: [glossaryid], references: [id])

  GlossaryEntriesCategories GlossaryEntriesCategories[]

  @@map("glossary_categories")
}

// all glossary entries
model GlossaryEntries {
  id BigInt @id @default(autoincrement())
  glossaryid BigInt @default(0)
  userid BigInt @default(0)
  concept String @default("")
  definition String
  definitionformat Int @default(0)
  definitiontrust Int @default(0)
  attachment String @default("")
  timecreated BigInt @default(0)
  timemodified BigInt @default(0)
  teacherentry Int @default(0)
  sourceglossaryid BigInt @default(0)
  usedynalink Int @default(1)
  casesensitive Int @default(0)
  fullmatch Int @default(1)
  approved Int @default(1)

  Glossary Glossary @relation(fields: [glossaryid], references: [id])
  User User @relation(fields: [userid], references: [id])

  GlossaryAlias GlossaryAlias[]
  GlossaryEntriesCategories GlossaryEntriesCategories[]

  @@map("glossary_entries")
}

// categories of each glossary entry
model GlossaryEntriesCategories {
  id BigInt @id @default(autoincrement())
  categoryid BigInt @default(0)
  entryid BigInt @default(0)

  Category GlossaryCategories @relation(fields: [categoryid], references: [id])
  Entry GlossaryEntries @relation(fields: [entryid], references: [id])

  @@map("glossary_entries_categories")
}

// Setting of the display formats
model GlossaryFormats {
  id BigInt @id @default(autoincrement())
  name String @default("")
  popupformatname String @default("")
  visible Int @default(1)
  showgroup Int @default(1)
  showtabs String?
  defaultmode String @default("")
  defaulthook String @default("")
  sortkey String @default("")
  sortorder String @default("")

  @@map("glossary_formats")
}

// This table keeps information about categories, used for grou
model GradeCategories {
  id BigInt @id @default(autoincrement())
  courseid BigInt // The course this grade category is part of
  parent BigInt? // Categories can be hierarchical
  depth BigInt @default(0) // How many parents does this category have?
  path String? // shows the path as /1/2/3 (like course_categories)
  fullname String @default("") // The name of this grade category
  aggregation BigInt @default(0) // A constant pointing to one of the predefined aggregation strategies (none, mean,median,sum, etc)
  keephigh BigInt @default(0) // Keep only the X highest items
  droplow BigInt @default(0) // Drop the X lowest items
  aggregateonlygraded Boolean @default(false) // aggregate only graded activities
  aggregateoutcomes Boolean @default(false) // Aggregate outcomes
  timecreated BigInt
  timemodified BigInt
  hidden BigInt @default(0)

  Course Course @relation(fields: [courseid], references: [id])
  Parent GradeCategories? @relation(name: "grade_categories_parent", fields: [parent], references: [id])

  GradeCategoriesByParent GradeCategories[] @relation(name: "grade_categories_parent")
  GradeCategoriesHistoryByOld GradeCategoriesHistory[] @relation(name: "grade_categories_history_oldid")
  GradeCategoriesHistoryByParent GradeCategoriesHistory[] @relation(name: "grade_categories_history_parent")
  GradeItems GradeItems[]
  GradeItemsHistory GradeItemsHistory[]

  @@map("grade_categories")
}

// History of grade_categories
model GradeCategoriesHistory {
  id BigInt @id @default(autoincrement())
  action BigInt @default(0) // created/modified/deleted constants
  oldid BigInt
  source String? // What caused the modification? manual/module/import/...
  timemodified BigInt? // The last time this grade_item was modified
  loggeduser BigInt? // the userid of the person who last modified this outcome
  courseid BigInt // The course this grade category is part of
  parent BigInt? // Categories can be hierarchical
  depth BigInt @default(0) // How many parents does this category have?
  path String? // shows the path as /1/2/3 (like course_categories)
  fullname String @default("") // The name of this grade category
  aggregation BigInt @default(0) // A constant pointing to one of the predefined aggregation strategies (none, mean,median,sum, etc)
  keephigh BigInt @default(0) // Keep only the X highest items
  droplow BigInt @default(0) // Drop the X lowest items
  aggregateonlygraded Boolean @default(false) // aggregate only graded items
  aggregateoutcomes Boolean @default(false) // Aggregate outcomes
  aggregatesubcats Boolean @default(false) // This setting was removed from grade_categories. It is kept here only to preserve history.
  hidden BigInt @default(0)

  Old GradeCategories @relation(name: "grade_categories_history_oldid", fields: [oldid], references: [id])
  Loggeduser User? @relation(fields: [loggeduser], references: [id])
  Course Course @relation(fields: [courseid], references: [id])
  Parent GradeCategories? @relation(name: "grade_categories_history_parent", fields: [parent], references: [id])

  @@map("grade_categories_history")
}

// grade_grades This table keeps individual grades for each us
model GradeGrades {
  id BigInt @id @default(autoincrement())
  itemid BigInt // The item this grade belongs to
  userid BigInt // The user who this grade is for
  rawgrade Decimal? // If the grade is a float value (or has been converted to one)
  rawgrademax Decimal @default(100.0) // The maximum allowable grade when this was created
  rawgrademin Decimal @default(0.0) // The minimum allowable grade when this was created
  rawscaleid BigInt? // If this grade is based on a scale, which one was it?
  usermodified BigInt? // the userid of the person who last modified this grade
  finalgrade Decimal? // The final grade (cached) after all calculations are made
  hidden BigInt @default(0) // show 0, hide 1 or hide until date
  locked BigInt @default(0) // not locked 0, locked from date
  locktime BigInt @default(0) // automatic locking of final grade, 0 means none, date otherwise
  exported BigInt @default(0) // date of last grade export, 0 if none
  overridden BigInt @default(0) // indicates grade overridden from gradebook, 0 means none, date means overridden
  excluded BigInt @default(0) // grade excluded from aggregation functions, date means when excluded
  feedback String? // grading feedback
  feedbackformat BigInt @default(0) // format of feedback text
  information String? // optiona information
  informationformat BigInt @default(0) // format of information text
  timecreated BigInt? // the time this grade was first created
  timemodified BigInt? // the time this grade was last modified
  aggregationstatus String @default("unknown") // One of several values describing how this grade_grade was used when calculating the aggregation. Possible values are &quot;unknown&quot;, &quot;dropped&quot;, &quot;novalue&quot;, &quot;used&quot;
  aggregationweight Decimal? // If the aggregationstatus == 'included', then this is the percent this item contributed to the aggregation.

  Item GradeItems @relation(fields: [itemid], references: [id])
  User User @relation(name: "grade_grades_userid", fields: [userid], references: [id])
  Rawscale Scale? @relation(fields: [rawscaleid], references: [id])
  Usermodified User? @relation(name: "grade_grades_usermodified", fields: [usermodified], references: [id])

  GradeGradesHistory GradeGradesHistory[]

  @@map("grade_grades")
}

// History table
model GradeGradesHistory {
  id BigInt @id @default(autoincrement())
  action BigInt @default(0) // created/modified/deleted constants
  oldid BigInt
  source String? // What caused the modification? manual/module/import/...
  timemodified BigInt? // The last time this grade_item was modified
  loggeduser BigInt? // the userid of the person who last modified this outcome
  itemid BigInt // The item this grade belongs to
  userid BigInt // The user who this grade is for
  rawgrade Decimal? // If the grade is a float value (or has been converted to one)
  rawgrademax Decimal @default(100.0) // The maximum allowable grade when this was created
  rawgrademin Decimal @default(0.0) // The minimum allowable grade when this was created
  rawscaleid BigInt? // If this grade is based on a scale, which one was it?
  usermodified BigInt? // the userid of the person who last modified this grade
  finalgrade Decimal? // The final grade (cached) after all calculations are made
  hidden BigInt @default(0) // show 0, hide 1 or hide until date
  locked BigInt @default(0) // not locked 0, locked from date
  locktime BigInt @default(0) // automatic locking of final grade, 0 means none, date otherwise
  exported BigInt @default(0) // date of last grade export, 0 if none
  overridden BigInt @default(0) // indicates grade overridden from gradebook, 0 means none, date means overridden
  excluded BigInt @default(0) // grade excluded from aggregation functions, date means when excluded
  feedback String? // grading feedback
  feedbackformat BigInt @default(0) // format of feedback text
  information String? // optiona information
  informationformat BigInt @default(0) // format of information text

  Old GradeGrades @relation(fields: [oldid], references: [id])
  Loggeduser User? @relation(name: "grade_grades_history_loggeduser", fields: [loggeduser], references: [id])
  Item GradeItems @relation(fields: [itemid], references: [id])
  User User @relation(name: "grade_grades_history_userid", fields: [userid], references: [id])
  Rawscale Scale? @relation(fields: [rawscaleid], references: [id])
  Usermodified User? @relation(name: "grade_grades_history_usermodified", fields: [usermodified], references: [id])

  @@map("grade_grades_history")
}

// temporary table for storing new grade_item names from grade
model GradeImportNewitem {
  id BigInt @id @default(autoincrement())
  itemname String @default("") // new grade item name
  importcode BigInt // import batch code for identification
  importer BigInt // user importing the data

  Importer User @relation(fields: [importer], references: [id])

  GradeImportValues GradeImportValues[]

  @@map("grade_import_newitem")
}

// Temporary table for importing grades
model GradeImportValues {
  id BigInt @id @default(autoincrement())
  itemid BigInt? // if set, this points to existing grade_items id
  newgradeitem BigInt? // if set, points to the id of grade_import_newitem
  userid BigInt
  finalgrade Decimal? // raw grade value
  feedback String?
  importcode BigInt // similar to backup_code, a unique batch code for identifying one batch of imports
  importer BigInt?
  importonlyfeedback Boolean? @default(false)

  Item GradeItems? @relation(fields: [itemid], references: [id])
  Newgradeitem GradeImportNewitem? @relation(fields: [newgradeitem], references: [id])
  User User @relation(name: "grade_import_values_userid", fields: [userid], references: [id])
  Importer User? @relation(name: "grade_import_values_importer", fields: [importer], references: [id])

  @@map("grade_import_values")
}

// This table keeps information about gradeable items (ie colum
model GradeItems {
  id BigInt @id @default(autoincrement())
  courseid BigInt? // The course this item is part of
  categoryid BigInt? // (optional) the category group this item belongs to
  itemname String? // The name of this item (pushed in by the module)
  itemtype String @default("") // 'mod', 'blocks', 'import', 'calculated' etc
  itemmodule String? // 'forum', 'quiz', 'csv', etc
  iteminstance BigInt? // id of the item module
  itemnumber BigInt? // Can be used to distinguish multiple grades for an activity
  iteminfo String? // Info and notes about this item XXX
  idnumber String? // Arbitrary idnumber provided by the module responsible
  calculation String? // Formula describing how to derive this grade from other items, referring to them using giXXX where XXX is grade item id ... eg something like: =sin(square([#gi20#])) + [#gi30#]
  gradetype Int @default(1) // 0 = none, 1 = value, 2 = scale, 3 = text
  grademax Decimal @default(100.0) // What is the maximum allowable grade?
  grademin Decimal @default(0.0) // What is the minimum allowable grade?
  scaleid BigInt? // If this grade is based on a scale, which one is it?
  outcomeid BigInt? // If this grade is related to an outcome, which one is it?
  gradepass Decimal @default(0.0) // What grade is needed to pass? grademin &amp;lt; gradepass &amp;lt;= grademax
  multfactor Decimal @default(1.0) // Multiply all grades by this
  plusfactor Decimal @default(0.0) // Add this to all grades
  aggregationcoef Decimal @default(0.0) // Aggregation coefficient used for category weights or other aggregation types
  aggregationcoef2 Decimal @default(0.0) // Aggregation coefficient used for weights in aggregation types with both extra credit and weight
  sortorder BigInt @default(0) // Sorting order of the columns
  display BigInt @default(0) // Display as real grades, percentages (in reference to the minimum and maximum grades) or letters (A, B, C etc..), or course default (0)
  decimals Boolean? // Also known as precision, the number of digits after the decimal point symbol.
  hidden BigInt @default(0) // 1 is hidden, &amp;gt; 1 is a date to hide until (prevents viewing)
  locked BigInt @default(0) // 1 is locked, &amp;gt; 1 is a date to lock until (prevents update)
  locktime BigInt @default(0) // lock all final grades after this date
  needsupdate BigInt @default(0) // If this flag is set, then the whole column will be recalculated
  weightoverride Boolean @default(false)
  timecreated BigInt? // The first time this grade_item was created
  timemodified BigInt? // The last time this grade_item was modified

  Course Course? @relation(fields: [courseid], references: [id])
  Category GradeCategories? @relation(fields: [categoryid], references: [id])
  Scale Scale? @relation(fields: [scaleid], references: [id])
  Outcome GradeOutcomes? @relation(fields: [outcomeid], references: [id])

  GradeGrades GradeGrades[]
  GradeGradesHistory GradeGradesHistory[]
  GradeImportValues GradeImportValues[]
  GradeItemsHistory GradeItemsHistory[]

  @@map("grade_items")
}

// History of grade_items
model GradeItemsHistory {
  id BigInt @id @default(autoincrement())
  action BigInt @default(0) // created/modified/deleted constants
  oldid BigInt
  source String? // What caused the modification? manual/module/import/...
  timemodified BigInt? // The last time this grade_item was modified
  loggeduser BigInt? // the userid of the person who last modified this outcome
  courseid BigInt? // The course this item is part of
  categoryid BigInt? // (optional) the category group this item belongs to
  itemname String? // The name of this item (pushed in by the module)
  itemtype String @default("") // 'mod', 'blocks', 'import', 'calculated' etc
  itemmodule String? // 'forum', 'quiz', 'csv', etc
  iteminstance BigInt? // id of the item module
  itemnumber BigInt? // Can be used to distinguish multiple grades for an activity
  iteminfo String? // Info and notes about this item XXX
  idnumber String? // Arbitrary idnumber provided by the module responsible
  calculation String? // Formula describing how to derive this grade from other items, referring to them using giXXX where XXX is grade item id ... eg something like: =sin(square([#gi20#])) + [#gi30#]
  gradetype Int @default(1) // 0 = none, 1 = value, 2 = scale, 3 = text
  grademax Decimal @default(100.0) // What is the maximum allowable grade?
  grademin Decimal @default(0.0) // What is the minimum allowable grade?
  scaleid BigInt? // If this grade is based on a scale, which one is it?
  outcomeid BigInt? // If this grade is related to an outcome, which one is it?
  gradepass Decimal @default(0.0) // What grade is needed to pass? grademin &amp;lt; gradepass &amp;lt;= grademax
  multfactor Decimal @default(1.0) // Multiply all grades by this
  plusfactor Decimal @default(0.0) // Add this to all grades
  aggregationcoef Decimal @default(0.0) // Aggregation coefficient used for category weights or other aggregation types
  aggregationcoef2 Decimal @default(0.0) // Aggregation coefficient used for category weights or other aggregation types
  sortorder BigInt @default(0) // Sorting order of the columns
  hidden BigInt @default(0) // 1 is hidden, &amp;gt; 1 is a date to hide until (prevents viewing)
  locked BigInt @default(0) // 1 is locked, &amp;gt; 1 is a date to lock until (prevents update)
  locktime BigInt @default(0) // lock all final grades after this date
  needsupdate BigInt @default(0) // If this flag is set, then the whole column will be recalculated
  display BigInt @default(0)
  decimals Boolean?
  weightoverride Boolean @default(false)

  Old GradeItems @relation(fields: [oldid], references: [id])
  Loggeduser User? @relation(fields: [loggeduser], references: [id])
  Course Course? @relation(fields: [courseid], references: [id])
  Category GradeCategories? @relation(fields: [categoryid], references: [id])
  Scale Scale? @relation(fields: [scaleid], references: [id])
  Outcome GradeOutcomes? @relation(fields: [outcomeid], references: [id])

  @@map("grade_items_history")
}

// Repository for grade letters, for courses and other moodle e
model GradeLetters {
  id BigInt @id @default(autoincrement())
  contextid BigInt // What contextid does this letter apply to (for now these will always be courses, but later...)
  lowerboundary Decimal // The lower boundary of the letter. Its upper boundary is the lower boundary of the next highest letter, unless there is none above, in which case it's grademax for that grade_item.
  letter String @default("") // The display value of the letter. Can be any character or string of characters (OK, A, 10% etc..)

  Context Context @relation(fields: [contextid], references: [id])

  @@map("grade_letters")
}

// This table describes the outcomes used in the system. An out
model GradeOutcomes {
  id BigInt @id @default(autoincrement()) // id of the table
  courseid BigInt? // Mostly these are defined site wide ie NULL
  shortname String @default("") // The short name or code for this outcome statement
  fullname String // The full description of the outcome (usually 1 sentence)
  scaleid BigInt? // The recommended scale for this outcome.
  description String? // outcome description
  descriptionformat Int @default(0)
  timecreated BigInt? // the time this outcome was first created
  timemodified BigInt? // the time this outcome was last updated
  usermodified BigInt? // the userid of the person who last modified this outcome

  Course Course? @relation(fields: [courseid], references: [id])
  Scale Scale? @relation(fields: [scaleid], references: [id])
  Usermodified User? @relation(fields: [usermodified], references: [id])

  GradeItems GradeItems[]
  GradeItemsHistory GradeItemsHistory[]
  GradeOutcomesCourses GradeOutcomesCourses[]
  GradeOutcomesHistory GradeOutcomesHistory[]

  @@map("grade_outcomes")
}

// stores what outcomes are used in what courses.
model GradeOutcomesCourses {
  id BigInt @id @default(autoincrement())
  courseid BigInt // id of the course
  outcomeid BigInt // id of the outcome

  Course Course @relation(fields: [courseid], references: [id])
  Outcome GradeOutcomes @relation(fields: [outcomeid], references: [id])

  @@map("grade_outcomes_courses")
}

// History table
model GradeOutcomesHistory {
  id BigInt @id @default(autoincrement())
  action BigInt @default(0) // created/modified/deleted constants
  oldid BigInt
  source String? // What caused the modification? manual/module/import/...
  timemodified BigInt? // The last time this grade_item was modified
  loggeduser BigInt? // the userid of the person who last modified this outcome
  courseid BigInt? // Mostly these are defined site wide ie NULL
  shortname String @default("") // The short name or code for this outcome statement
  fullname String // The full description of the outcome (usually 1 sentence)
  scaleid BigInt? // The recommended scale for this outcome.
  description String? // Outcome description
  descriptionformat Int @default(0)

  Old GradeOutcomes @relation(fields: [oldid], references: [id])
  Loggeduser User? @relation(fields: [loggeduser], references: [id])
  Course Course? @relation(fields: [courseid], references: [id])
  Scale Scale? @relation(fields: [scaleid], references: [id])

  @@map("grade_outcomes_history")
}

// gradebook settings
model GradeSettings {
  id BigInt @id @default(autoincrement())
  courseid BigInt
  name String @default("")
  value String?

  Course Course @relation(fields: [courseid], references: [id])

  @@map("grade_settings")
}

// Identifies gradable areas where advanced grading can happen.
model GradingAreas {
  id BigInt @id @default(autoincrement())
  contextid BigInt // The context of the gradable area, eg module instance context.
  component String @default("") // Frankenstyle name of the component holding this area
  areaname String @default("") // The name of gradable area
  activemethod String? // The default grading method (plugin) that should be used for this area

  Context Context @relation(fields: [contextid], references: [id])

  GradingDefinitions GradingDefinitions[]

  @@map("grading_areas")
}

// Contains the basic information about an advanced grading for
model GradingDefinitions {
  id BigInt @id @default(autoincrement())
  areaid BigInt
  method String @default("") // The name of the plugin providing this grading form
  name String @default("") // The title of the form that helps users to identify it
  description String? // More detailed description of the form
  descriptionformat Int? // Format of the description field
  status BigInt @default(0) // Status of the form definition, by default in the under-construction state
  copiedfromid BigInt? // The id of the original definition that this was initially copied from or null if it was from scratch
  timecreated BigInt // The timestamp of when the form definition was created initially
  usercreated BigInt // The ID of the user who created this definition and is considered as its owner for access control purposes
  timemodified BigInt // The time stamp of when the form definition was modified recently
  usermodified BigInt // The ID of the user who did the most recent modification
  timecopied BigInt? @default(0) // The timestamp of when this form was most recently copied into another area
  options String? // General field to be used by plugins as a general storage place for their own settings

  Area GradingAreas @relation(fields: [areaid], references: [id])
  Usercreated User @relation(name: "grading_definitions_usercreated", fields: [usercreated], references: [id])
  Usermodified User @relation(name: "grading_definitions_usermodified", fields: [usermodified], references: [id])

  GradingInstances GradingInstances[]
  GradingformGuideComments GradingformGuideComments[]
  GradingformGuideCriteria GradingformGuideCriteria[]
  GradingformRubricCriteria GradingformRubricCriteria[]

  @@map("grading_definitions")
}

// Grading form instance is an assessment record for one gradab
model GradingInstances {
  id BigInt @id @default(autoincrement())
  definitionid BigInt // The ID of the form definition this is instance of
  raterid BigInt // The ID of the user who did the assessment
  itemid BigInt? // This identifies the graded item within the grabable area
  rawgrade Decimal? // The raw normalized grade 0.00000 - 100.00000 as a result of the most recent assessment
  status BigInt @default(0) // The status of the assessment. By default the instance is under-assessment state
  feedback String? // Overall feedback from the rater for the author of the graded item
  feedbackformat Int? // The format of the feedback field
  timemodified BigInt // The timestamp of when the assessment was most recently modified

  Definition GradingDefinitions @relation(fields: [definitionid], references: [id])
  Rater User @relation(fields: [raterid], references: [id])

  GradingformGuideFillings GradingformGuideFillings[]
  GradingformRubricFillings GradingformRubricFillings[]

  @@map("grading_instances")
}

// frequently used comments used in marking guide
model GradingformGuideComments {
  id BigInt @id @default(autoincrement())
  definitionid BigInt // The ID of the form definition this faq is part of
  sortorder BigInt // Defines the order of the comments
  description String? // The comment description
  descriptionformat Int? // The format of the description field

  Definition GradingDefinitions @relation(fields: [definitionid], references: [id])

  @@map("gradingform_guide_comments")
}

// Stores the rows of the criteria grid.
model GradingformGuideCriteria {
  id BigInt @id @default(autoincrement())
  definitionid BigInt // The ID of the form definition this criterion is part of
  sortorder BigInt // Defines the order of the criterion in the guide
  shortname String @default("") // shortname of this criterion
  description String? // The criterion description for students
  descriptionformat Int? // The format of the description field
  descriptionmarkers String? // Description for Markers
  descriptionmarkersformat Int?
  maxscore Decimal // maximum grade that can be assigned using this criterion

  Definition GradingDefinitions @relation(fields: [definitionid], references: [id])

  GradingformGuideFillings GradingformGuideFillings[]

  @@map("gradingform_guide_criteria")
}

// Stores the data of how the guide is filled by a particular r
model GradingformGuideFillings {
  id BigInt @id @default(autoincrement())
  instanceid BigInt // The ID of the grading form instance
  criterionid BigInt // The ID of the criterion (row) in the guide
  remark String? // Side note feedback regarding this particular criterion
  remarkformat Int? // The format of the remark field
  score Decimal // The score assigned

  Instance GradingInstances @relation(fields: [instanceid], references: [id])
  Criterion GradingformGuideCriteria @relation(fields: [criterionid], references: [id])

  @@map("gradingform_guide_fillings")
}

// Stores the rows of the rubric grid.
model GradingformRubricCriteria {
  id BigInt @id @default(autoincrement())
  definitionid BigInt // The ID of the form definition this criterion is part of
  sortorder BigInt // Defines the order of the criterion in the rubric
  description String? // The criterion description
  descriptionformat Int? // The format of the description field

  Definition GradingDefinitions @relation(fields: [definitionid], references: [id])

  GradingformRubricFillings GradingformRubricFillings[]
  GradingformRubricLevels GradingformRubricLevels[]

  @@map("gradingform_rubric_criteria")
}

// Stores the data of how the rubric is filled by a particular
model GradingformRubricFillings {
  id BigInt @id @default(autoincrement())
  instanceid BigInt // The ID of the grading form instance
  criterionid BigInt // The ID of the criterion (row) in the rubric
  levelid BigInt? // If a particular level was selected during the assessment, its ID is stored here
  remark String? // Side note feedback regarding this particular criterion
  remarkformat Int? // The format of the remark field

  Instance GradingInstances @relation(fields: [instanceid], references: [id])
  Criterion GradingformRubricCriteria @relation(fields: [criterionid], references: [id])

  @@map("gradingform_rubric_fillings")
}

// Stores the columns of the rubric grid.
model GradingformRubricLevels {
  id BigInt @id @default(autoincrement())
  criterionid BigInt // The rubric criterion we are level of
  score Decimal // The score for this level
  definition String? // The optional text describing the level
  definitionformat BigInt? // The format of the definition field

  Criterion GradingformRubricCriteria @relation(fields: [criterionid], references: [id])

  @@map("gradingform_rubric_levels")
}

// A grouping is a collection of groups. WAS: groups_groupings
model Groupings {
  id BigInt @id @default(autoincrement())
  courseid BigInt @default(0)
  name String @default("") // Short human readable unique name for group.
  idnumber String @default("")
  description String?
  descriptionformat Int @default(0)
  configdata String? // extra configuration data - may be used by group IU tools
  timecreated BigInt @default(0)
  timemodified BigInt @default(0)

  Course Course @relation(fields: [courseid], references: [id])

  CourseModules CourseModules[]
  GroupingsGroups GroupingsGroups[]

  @@map("groupings")
}

// Link a grouping to a group (note, groups can be in multiple
model GroupingsGroups {
  id BigInt @id @default(autoincrement())
  groupingid BigInt @default(0)
  groupid BigInt @default(0)
  timeadded BigInt @default(0)

  Grouping Groupings @relation(fields: [groupingid], references: [id])
  Group Groups @relation(fields: [groupid], references: [id])

  @@map("groupings_groups")
}

// Each record represents a group.
model Groups {
  id BigInt @id @default(autoincrement())
  courseid BigInt
  idnumber String @default("")
  name String @default("") // Short human readable unique name for the group.
  description String?
  descriptionformat Int @default(0)
  enrolmentkey String?
  picture BigInt @default(0)
  timecreated BigInt @default(0)
  timemodified BigInt @default(0)

  Course Course @relation(fields: [courseid], references: [id])

  AssignOverrides AssignOverrides[]
  GroupingsGroups GroupingsGroups[]
  GroupsMembers GroupsMembers[]
  LessonOverrides LessonOverrides[]
  QuizOverrides QuizOverrides[]

  @@map("groups")
}

// Link a user to a group.
model GroupsMembers {
  id BigInt @id @default(autoincrement())
  groupid BigInt @default(0)
  userid BigInt @default(0)
  timeadded BigInt @default(0)
  component String @default("") // Defines the Moodle component which added this group membership (e.g. 'auth_myplugin'), or blank if it was added manually. (Entries which are created by a Moodle component cannot be removed in the normal user interface.)
  itemid BigInt @default(0) // If the 'component' field is set, this can be used to define the instance of the component that created the entry. Otherwise should be left as default (0).

  Group Groups @relation(fields: [groupid], references: [id])
  User User @relation(fields: [userid], references: [id])

  @@map("groups_members")
}

// Stores H5P content information
model H5p {
  id BigInt @id @default(autoincrement())
  jsoncontent String // The content in json format
  mainlibraryid BigInt // The library we first instanciate for this node
  displayoptions Int? // H5P Button display options
  pathnamehash String @default("") // Defines the complete unique hash for the file path where the H5P content was added.
  contenthash String @default("") // Defines the hash for the file content.
  filtered String? // Filtered version of json_content
  timecreated BigInt @default(0)
  timemodified BigInt @default(0)

  Mainlibrary H5pLibraries @relation(fields: [mainlibraryid], references: [id])

  H5pContentsLibraries H5pContentsLibraries[]

  @@map("h5p")
}

// Store which library is used in which content.
model H5pContentsLibraries {
  id BigInt @id @default(autoincrement())
  h5pid BigInt // Identifier for the h5p content
  libraryid BigInt // The identifier of a H5P library this content uses
  dependencytype String @default("") // dynamic, preloaded or editor
  dropcss Boolean // 1 if the preloaded css from the dependency is to be excluded
  weight BigInt // Determines the order in which the preloaded libraries will be loaded

  H5p H5p @relation(fields: [h5pid], references: [id])
  Library H5pLibraries @relation(fields: [libraryid], references: [id])

  @@map("h5p_contents_libraries")
}

// Stores information about libraries used by H5P content.
model H5pLibraries {
  id BigInt @id @default(autoincrement()) // Primary Key: The id of the library
  machinename String @default("") // The library machine name
  title String @default("") // The human readable name of this library
  majorversion Int
  minorversion Int
  patchversion Int
  runnable Boolean // Can this library be started by the module? i.e. not a dependency.
  fullscreen Boolean @default(false) // Display fullscreen button
  embedtypes String @default("") // List of supported embed types
  preloadedjs String? // Comma separated list of scripts to load.
  preloadedcss String? // Comma separated list of stylesheets to load.
  droplibrarycss String? // List of libraries that should not have CSS included if this library is used. Comma separated list.
  semantics String? // The semantics definition in json format
  addto String? // Plugin configuration data
  coremajor Int? // H5P core API major version required
  coreminor Int? // H5P core API minor version required
  metadatasettings String? // Library metadata settings
  tutorial String? // Tutorial URL
  example String? // Example URL
  enabled Boolean? @default(true) // Defines if this library is enabled (1) or not (0)

  H5p H5p[]
  H5pContentsLibraries H5pContentsLibraries[]
  H5pLibrariesCachedassets H5pLibrariesCachedassets[]
  H5pLibraryDependenciesByLibrary H5pLibraryDependencies[] @relation(name: "h5p_library_dependencies_libraryid")
  H5pLibraryDependenciesByRequiredlibrary H5pLibraryDependencies[] @relation(name: "h5p_library_dependencies_requiredlibraryid")

  @@map("h5p_libraries")
}

// H5P cached library assets
model H5pLibrariesCachedassets {
  id BigInt @id @default(autoincrement())
  libraryid BigInt
  hash String @default("") // Cache hash key that this library is part of.

  Library H5pLibraries @relation(fields: [libraryid], references: [id])

  @@map("h5p_libraries_cachedassets")
}

// Stores H5P library dependencies
model H5pLibraryDependencies {
  id BigInt @id @default(autoincrement())
  libraryid BigInt // The id of a H5P library.
  requiredlibraryid BigInt // The dependent library to load
  dependencytype String @default("") // preloaded, dynamic, or editor

  Library H5pLibraries @relation(name: "h5p_library_dependencies_libraryid", fields: [libraryid], references: [id])
  Requiredlibrary H5pLibraries @relation(name: "h5p_library_dependencies_requiredlibraryid", fields: [requiredlibraryid], references: [id])

  @@map("h5p_library_dependencies")
}

// Stores the h5pactivity activity module instances.
model H5pactivity {
  id BigInt @id @default(autoincrement())
  course BigInt // ID of the course this activity is part of.
  name String @default("") // The name of the activity module instance
  timecreated BigInt // Timestamp of when the instance was added to the course.
  timemodified BigInt // Timestamp of when the instance was last modified.
  intro String? // Activity description.
  introformat Int @default(0) // The format of the intro field.
  grade BigInt? @default(0)
  displayoptions Int @default(0) // H5P Button display options
  enabletracking Boolean @default(true) // Enable xAPI tracking
  grademethod Int @default(1) // Which H5P attempt is used for grading
  reviewmode Int? @default(1)

  Course Course @relation(fields: [course], references: [id])

  H5pactivityAttempts H5pactivityAttempts[]

  @@map("h5pactivity")
}

// Users attempts inside H5P activities
model H5pactivityAttempts {
  id BigInt @id @default(autoincrement())
  h5pactivityid BigInt // H5P activity ID
  userid BigInt // Attempt user ID
  timecreated BigInt
  timemodified BigInt
  attempt Int @default(1) // Attempt number
  rawscore BigInt? @default(0)
  maxscore BigInt? @default(0)
  scaled Decimal @default(0.0) // Number 0..1 that reflects the performance of the learner
  duration BigInt? @default(0) // Number of second inverted in that attempt (provided by the statement)
  completion Boolean? // Store the xAPI tracking completion result.
  success Boolean? // Store the xAPI tracking success result.

  H5pactivity H5pactivity @relation(fields: [h5pactivityid], references: [id])
  User User @relation(fields: [userid], references: [id])

  H5pactivityAttemptsResults H5pactivityAttemptsResults[]

  @@map("h5pactivity_attempts")
}

// H5Pactivities_attempts tracking info
model H5pactivityAttemptsResults {
  id BigInt @id @default(autoincrement())
  attemptid BigInt // h5pactivity_attempts ID
  subcontent String?
  timecreated BigInt
  interactiontype String?
  description String?
  correctpattern String? // Correct Pattern in xAPI format
  response String // User response data in xAPI format
  additionals String? // Extra subcontent information in JSON format
  rawscore BigInt @default(0)
  maxscore BigInt @default(0)
  duration BigInt? @default(0) // Seconds inverted in this result (exctracted directly from statement)
  completion Boolean? // Store the xAPI tracking completion result.
  success Boolean? // Store the xAPI tracking success result.

  Attempt H5pactivityAttempts @relation(fields: [attemptid], references: [id])

  @@map("h5pactivity_attempts_results")
}

// each record is one imscp resource
model Imscp {
  id BigInt @id @default(autoincrement())
  course BigInt @default(0)
  name String @default("")
  intro String?
  introformat Int @default(0)
  revision BigInt @default(0) // incremented when after each file changes, solves browser caching issues
  keepold BigInt @default(-1) // incremented when after each file changes, solves browser caching issues
  structure String?
  timemodified BigInt @default(0)

  Course Course @relation(fields: [course], references: [id])

  @@map("imscp")
}

// Table to store infected file details.
model InfectedFiles {
  id BigInt @id @default(autoincrement())
  filename String // Original file name
  quarantinedfile String? // Quarantine zip file
  userid BigInt // The user that uploaded the infected file.
  reason String // The reason for the antivirus failure
  timecreated BigInt @default(0) // The time the infected file was uploaded.

  User User @relation(fields: [userid], references: [id])

  @@map("infected_files")
}

// Defines labels
model Label {
  id BigInt @id @default(autoincrement())
  course BigInt @default(0)
  name String @default("")
  intro String
  introformat Int? @default(0)
  timemodified BigInt @default(0)

  Course Course @relation(fields: [course], references: [id])

  @@map("label")
}

// Defines lesson
model Lesson {
  id BigInt @id @default(autoincrement())
  course BigInt @default(0)
  name String @default("")
  intro String?
  introformat Int @default(0)
  practice Int @default(0)
  modattempts Int @default(0)
  usepassword Int @default(0)
  password String @default("")
  dependency BigInt @default(0)
  conditions String
  grade BigInt @default(0)
  custom Int @default(0)
  ongoing Int @default(0)
  usemaxgrade Int @default(0)
  maxanswers Int @default(4)
  maxattempts Int @default(5)
  review Int @default(0)
  nextpagedefault Int @default(0)
  feedback Int @default(1)
  minquestions Int @default(0)
  maxpages Int @default(0)
  timelimit BigInt @default(0)
  retake Int @default(1)
  activitylink BigInt @default(0)
  mediafile String @default("") // Local file path or full external URL
  mediaheight BigInt @default(100)
  mediawidth BigInt @default(650)
  mediaclose Int @default(0)
  slideshow Int @default(0)
  width BigInt @default(640)
  height BigInt @default(480)
  bgcolor String @default("#FFFFFF")
  displayleft Int @default(0)
  displayleftif Int @default(0)
  progressbar Int @default(0)
  available BigInt @default(0)
  deadline BigInt @default(0)
  timemodified BigInt @default(0)
  completionendreached Boolean? @default(false)
  completiontimespent BigInt? @default(0)
  allowofflineattempts Boolean? @default(false) // Whether to allow the lesson to be attempted offline in the mobile app

  LessonAnswers LessonAnswers[]
  LessonAttempts LessonAttempts[]
  LessonBranch LessonBranch[]
  LessonGrades LessonGrades[]
  LessonOverrides LessonOverrides[]
  LessonPages LessonPages[]
  LessonTimer LessonTimer[]

  @@map("lesson")
}

// Defines lesson_answers
model LessonAnswers {
  id BigInt @id @default(autoincrement())
  lessonid BigInt @default(0)
  pageid BigInt @default(0)
  jumpto BigInt @default(0)
  grade Int @default(0)
  score BigInt @default(0)
  flags Int @default(0)
  timecreated BigInt @default(0)
  timemodified BigInt @default(0)
  answer String?
  answerformat Int @default(0)
  response String?
  responseformat Int @default(0)

  Lesson Lesson @relation(fields: [lessonid], references: [id])
  Page LessonPages @relation(fields: [pageid], references: [id])

  LessonAttempts LessonAttempts[]

  @@map("lesson_answers")
}

// Defines lesson_attempts
model LessonAttempts {
  id BigInt @id @default(autoincrement())
  lessonid BigInt @default(0)
  pageid BigInt @default(0)
  userid BigInt @default(0)
  answerid BigInt @default(0)
  retry Int @default(0)
  correct BigInt @default(0)
  useranswer String?
  timeseen BigInt @default(0)

  Lesson Lesson @relation(fields: [lessonid], references: [id])
  Page LessonPages @relation(fields: [pageid], references: [id])
  User User @relation(fields: [userid], references: [id])
  Answer LessonAnswers @relation(fields: [answerid], references: [id])

  @@map("lesson_attempts")
}

// branches for each lesson/user
model LessonBranch {
  id BigInt @id @default(autoincrement())
  lessonid BigInt @default(0)
  userid BigInt @default(0)
  pageid BigInt @default(0)
  retry BigInt @default(0)
  flag Int @default(0)
  timeseen BigInt @default(0)
  nextpageid BigInt @default(0)

  Lesson Lesson @relation(fields: [lessonid], references: [id])
  User User @relation(fields: [userid], references: [id])
  Page LessonPages @relation(fields: [pageid], references: [id])

  @@map("lesson_branch")
}

// Defines lesson_grades
model LessonGrades {
  id BigInt @id @default(autoincrement())
  lessonid BigInt @default(0)
  userid BigInt @default(0)
  grade Float @default(0.0)
  late Int @default(0)
  completed BigInt @default(0)

  Lesson Lesson @relation(fields: [lessonid], references: [id])
  User User @relation(fields: [userid], references: [id])

  @@map("lesson_grades")
}

// The overrides to lesson settings.
model LessonOverrides {
  id BigInt @id @default(autoincrement())
  lessonid BigInt @default(0) // Foreign key references lesson.id
  groupid BigInt? // Foreign key references groups.id. Can be null if this is a per-user override.
  userid BigInt? // Foreign key references user.id. Can be null if this is a per-group override.
  available BigInt? // Time at which students may start attempting this lesson. Can be null, in which case the lesson default is used.
  deadline BigInt? // Time by which students must have completed their attempt. Can be null, in which case the lesson default is used.
  timelimit BigInt? // Time limit in seconds. Can be null, in which case the lesson default is used.
  review Int?
  maxattempts Int?
  retake Int?
  password String? // Lesson password. Can be null, in which case the lesson default is used.

  Lesson Lesson @relation(fields: [lessonid], references: [id])
  Group Groups? @relation(fields: [groupid], references: [id])
  User User? @relation(fields: [userid], references: [id])

  @@map("lesson_overrides")
}

// Defines lesson_pages
model LessonPages {
  id BigInt @id @default(autoincrement())
  lessonid BigInt @default(0)
  prevpageid BigInt @default(0)
  nextpageid BigInt @default(0)
  qtype Int @default(0)
  qoption Int @default(0)
  layout Int @default(1)
  display Int @default(1)
  timecreated BigInt @default(0)
  timemodified BigInt @default(0)
  title String @default("")
  contents String
  contentsformat Int @default(0)

  Lesson Lesson @relation(fields: [lessonid], references: [id])

  LessonAnswers LessonAnswers[]
  LessonAttempts LessonAttempts[]
  LessonBranch LessonBranch[]

  @@map("lesson_pages")
}

// lesson timer for each lesson
model LessonTimer {
  id BigInt @id @default(autoincrement())
  lessonid BigInt @default(0)
  userid BigInt @default(0)
  starttime BigInt @default(0)
  lessontime BigInt @default(0)
  completed Boolean? @default(false)
  timemodifiedoffline BigInt @default(0) // Last modified time via web services (mobile app).

  Lesson Lesson @relation(fields: [lessonid], references: [id])
  User User @relation(fields: [userid], references: [id])

  @@map("lesson_timer")
}

// store licenses used by moodle
model License {
  id BigInt @id @default(autoincrement())
  shortname String?
  fullname String?
  source String?
  enabled Boolean @default(true)
  version BigInt @default(0)
  custom Boolean @default(false) // If this flag is set, license is custom and can be updated or deleted, otherwise license is a core license and cannot be edited.
  sortorder Int @default(0)

  @@map("license")
}

// Stores active and inactive lock types for db locking method.
model LockDb {
  id BigInt @id @default(autoincrement())
  resourcekey String @default("") // String identifying the resource to be locked. Should use frankenstyle format.
  expires BigInt? // Expiry time for an active lock.
  owner String? // uuid indicating the owner of the lock.

  @@map("lock_db")
}

// Every action is logged as far as possible
model Log {
  id BigInt @id @default(autoincrement())
  time BigInt @default(0)
  userid BigInt @default(0)
  ip String @default("")
  course BigInt @default(0)
  module String @default("")
  cmid BigInt @default(0)
  action String @default("")
  url String @default("")
  info String @default("")

  User User @relation(fields: [userid], references: [id])

  @@map("log")
}

// For a particular module/action, specifies a moodle table/fie
model LogDisplay {
  id BigInt @id @default(autoincrement())
  module String @default("")
  action String @default("")
  mtable String @default("")
  field String @default("")
  component String @default("") // owner of the log action

  @@map("log_display")
}

// Logged database queries.
model LogQueries {
  id BigInt @id @default(autoincrement())
  qtype Int // query type constant
  sqltext String // query sql
  sqlparams String? // query parameters
  error Int @default(0) // is error
  info String? // detailed info such as error text
  backtrace String? // php execution trace
  exectime Decimal // query execution time in seconds as float
  timelogged BigInt // timestamp when log info stored into db

  @@map("log_queries")
}

// Standard log table
model LogstoreStandardLog {
  id BigInt @id @default(autoincrement())
  eventname String @default("")
  component String @default("")
  action String @default("")
  target String @default("")
  objecttable String?
  objectid BigInt?
  crud String @default("")
  edulevel Boolean
  contextid BigInt
  contextlevel BigInt
  contextinstanceid BigInt
  userid BigInt
  courseid BigInt?
  relateduserid BigInt?
  anonymous Boolean @default(false) // Was this event anonymous at the time of triggering?
  other String?
  timecreated BigInt
  origin String? // cli, cron, ws, etc.
  ip String? // IP address
  realuserid BigInt? // real user id when logged-in-as

  Context Context @relation(name: "logstore_standard_log_contextid", fields: [contextid], references: [id])
  Contextinstance Context @relation(name: "logstore_standard_log_contextinstanceid", fields: [contextinstanceid], references: [id])
  User User @relation(fields: [userid], references: [id])
  Course Course? @relation(fields: [courseid], references: [id])

  @@map("logstore_standard_log")
}

// This table contains Basic LTI activities instances
model Lti {
  id BigInt @id @default(autoincrement())
  course BigInt @default(0) // Course basiclti activity belongs to
  name String @default("") // name field for moodle instances
  intro String? // General introduction of the basiclti activity
  introformat Int? @default(0) // Format of the intro field (MOODLE, HTML, MARKDOWN...)
  timecreated BigInt @default(0)
  timemodified BigInt @default(0)
  typeid BigInt? // Basic LTI type
  toolurl String // Remote tool url
  securetoolurl String?
  instructorchoicesendname Boolean? // Send user's name
  instructorchoicesendemailaddr Boolean? // Send user's email
  instructorchoiceallowroster Boolean? // Allow the roster to be retrieved
  instructorchoiceallowsetting Boolean? // Allow a tool to store a setting
  instructorcustomparameters String? // Additional custom parameters provided by the instructor
  instructorchoiceacceptgrades Boolean? // Accept grades from tool
  grade BigInt @default(100) // Grade scale
  launchcontainer Int @default(1) // Launch external tool in a pop-up
  resourcekey String?
  password String?
  debuglaunch Boolean @default(false) // Enable the debug-style launch which pauses before auto-submit
  showtitlelaunch Boolean @default(false)
  showdescriptionlaunch Boolean @default(false)
  servicesalt String?
  icon String?
  secureicon String?

  Type LtiTypes? @relation(fields: [typeid], references: [id])

  LtiSubmission LtiSubmission[]
  LtiToolSettings LtiToolSettings[]
  LtiTypesConfig LtiTypesConfig[]
  LtiserviceGradebookservices LtiserviceGradebookservices[]

  @@map("lti")
}

// Security tokens for accessing of LTI services
model LtiAccessTokens {
  id BigInt @id @default(autoincrement())
  typeid BigInt // Basic LTI type id
  scope String // Scope values as JSON array
  token String @default("") // security token, aka private access key
  validuntil BigInt // timestamp - valid until data
  timecreated BigInt // created timestamp
  lastaccess BigInt? // last access timestamp

  Type LtiTypes @relation(fields: [typeid], references: [id])

  @@map("lti_access_tokens")
}

// Keeps track of individual submissions for LTI activities.
model LtiSubmission {
  id BigInt @id @default(autoincrement())
  ltiid BigInt // ID of the LTI tool instance
  userid BigInt
  datesubmitted BigInt
  dateupdated BigInt
  gradepercent Decimal
  originalgrade Decimal
  launchid BigInt
  state Int

  Lti Lti @relation(fields: [ltiid], references: [id])
  User User @relation(fields: [userid], references: [id])

  @@map("lti_submission")
}

// LTI tool proxy registrations
model LtiToolProxies {
  id BigInt @id @default(autoincrement())
  name String @default("Tool Provider") // Tool Provider name
  regurl String?
  state Int @default(1) // Configured = 1, Pending = 2, Accepted = 3, Rejected = 4, Cancelled = 5
  guid String?
  secret String?
  vendorcode String?
  capabilityoffered String // List of capabilities offered, one per line
  serviceoffered String // List of services offered, one per line
  toolproxy String? // JSON string representing tool proxy returned by tool provider
  createdby BigInt // ID of user which initiated the registration process
  timecreated BigInt // Date/time at which the record was created
  timemodified BigInt // Date/time at which the record was last modified

  LtiToolSettings LtiToolSettings[]

  @@map("lti_tool_proxies")
}

// LTI tool setting values
model LtiToolSettings {
  id BigInt @id @default(autoincrement())
  toolproxyid BigInt // Primary key of related tool proxy
  typeid BigInt?
  course BigInt? // Primary key of course (null for system-wide settings)
  coursemoduleid BigInt? // Primary key of course module - tool link added to course (null for system-wide and context-wide settings)
  settings String // Setting values as JSON
  timecreated BigInt // Date/time at which the record was created
  timemodified BigInt // Date/time at which the record was last modified

  Toolproxy LtiToolProxies @relation(fields: [toolproxyid], references: [id])
  Type LtiTypes? @relation(fields: [typeid], references: [id])
  Course Course? @relation(fields: [course], references: [id])
  Coursemodule Lti? @relation(fields: [coursemoduleid], references: [id])

  @@map("lti_tool_settings")
}

// Basic LTI pre-configured activities
model LtiTypes {
  id BigInt @id @default(autoincrement())
  name String @default("basiclti Activity") // Activity name
  baseurl String
  tooldomain String @default("")
  state Int @default(2) // Active = 1, Pending = 2, Rejected = 3
  course BigInt
  coursevisible Boolean @default(false)
  ltiversion String @default("")
  clientid String?
  toolproxyid BigInt? // Primary key of related tool proxy (null for LTI 1 tools)
  enabledcapability String? // Enabled capabilities, one per line (null for LTI 1 tools)
  parameter String? // Launch parameters, one per line (null for LTI 1 tools)
  icon String? // URL to icon file
  secureicon String? // Secure URL to icon file
  createdby BigInt
  timecreated BigInt
  timemodified BigInt
  description String? // A description of what this LTI module is.

  Lti Lti[]
  LtiAccessTokens LtiAccessTokens[]
  LtiToolSettings LtiToolSettings[]

  @@map("lti_types")
}

// Basic LTI types configuration
model LtiTypesConfig {
  id BigInt @id @default(autoincrement())
  typeid BigInt // Basic LTI type id
  name String @default("") // Basic LTI param
  value String // Param value

  Type Lti @relation(fields: [typeid], references: [id])

  @@map("lti_types_config")
}

// This file records the grade items created by the LTI Gradebo
model LtiserviceGradebookservices {
  id BigInt @id @default(autoincrement())
  gradeitemid BigInt // ID of the gradeItem related.
  courseid BigInt // ID of the course related.
  toolproxyid BigInt? // ID of the Tool Proxy instance.
  typeid BigInt? // ID of the LTI Type if not Proxy.
  baseurl String? // Lineitem URL that will be returned to the Tool provider
  ltilinkid BigInt? // ID of the LTI element related with this lineitem.
  resourceid String? // Resource id for the line item
  tag String? // Tag type specified for the line item

  Course Course @relation(fields: [courseid], references: [id])
  Ltilink Lti? @relation(fields: [ltilinkid], references: [id])

  @@map("ltiservice_gradebookservices")
}

// Stores all unread messages
model Message {
  id BigInt @id @default(autoincrement())
  useridfrom BigInt @default(0)
  useridto BigInt @default(0)
  subject String? // The message subject
  fullmessage String?
  fullmessageformat Int? @default(0) // The format of the full message
  fullmessagehtml String? // html format of message
  smallmessage String? // Smal version of message (eg sms)
  notification Boolean? @default(false)
  contexturl String? // If this message is a notification of an event contexturl should contain a link to view this event. For example if its a notification of a forum post contexturl should contain a link to the forum post.
  contexturlname String? // Display text for the contexturl
  timecreated BigInt @default(0)
  timeuserfromdeleted BigInt @default(0)
  timeusertodeleted BigInt @default(0)
  component String?
  eventtype String?
  customdata String? // Custom data to be passed to the message processor. Must be serialisable using json_encode()

  MessagePopup MessagePopup[]

  @@map("message")
}

// Store information about the devices registered in Airnotifie
model MessageAirnotifierDevices {
  id BigInt @id @default(autoincrement())
  userdeviceid BigInt // The user device id in the user_devices table
  enable Boolean @default(true) // The user can enable/disable his devices

  Userdevice UserDevices @relation(fields: [userdeviceid], references: [id])

  @@map("message_airnotifier_devices")
}

// Maintains list of contact requests between users
model MessageContactRequests {
  id BigInt @id @default(autoincrement())
  userid BigInt
  requesteduserid BigInt
  timecreated BigInt

  User User @relation(name: "message_contact_requests_userid", fields: [userid], references: [id])
  Requesteduser User @relation(name: "message_contact_requests_requesteduserid", fields: [requesteduserid], references: [id])

  @@map("message_contact_requests")
}

// Maintains lists of contacts between users
model MessageContacts {
  id BigInt @id @default(autoincrement())
  userid BigInt
  contactid BigInt
  timecreated BigInt?

  User User @relation(name: "message_contacts_userid", fields: [userid], references: [id])
  Contact User @relation(name: "message_contacts_contactid", fields: [contactid], references: [id])

  @@map("message_contacts")
}

// Stores all per-user actions on individual conversations
model MessageConversationActions {
  id BigInt @id @default(autoincrement())
  userid BigInt
  conversationid BigInt
  action BigInt
  timecreated BigInt

  User User @relation(fields: [userid], references: [id])
  Conversation MessageConversations @relation(fields: [conversationid], references: [id])

  @@map("message_conversation_actions")
}

// Stores all members in a conversations
model MessageConversationMembers {
  id BigInt @id @default(autoincrement())
  conversationid BigInt
  userid BigInt
  timecreated BigInt

  Conversation MessageConversations @relation(fields: [conversationid], references: [id])
  User User @relation(fields: [userid], references: [id])

  @@map("message_conversation_members")
}

// Stores all message conversations
model MessageConversations {
  id BigInt @id @default(autoincrement())
  type BigInt @default(1)
  name String?
  convhash String?
  component String? // Defines the Moodle component which the area was added to
  itemtype String?
  itemid BigInt?
  contextid BigInt? // The context id of the itemid or course of the itemtype was added
  enabled Boolean @default(false)
  timecreated BigInt
  timemodified BigInt?

  Context Context? @relation(fields: [contextid], references: [id])

  MessageConversationActions MessageConversationActions[]
  MessageConversationMembers MessageConversationMembers[]
  MessageEmailMessages MessageEmailMessages[]
  Messages Messages[]

  @@map("message_conversations")
}

// Keeps track of what emails to send in an email digest
model MessageEmailMessages {
  id BigInt @id @default(autoincrement())
  useridto BigInt
  conversationid BigInt
  messageid BigInt

  Useridto User @relation(fields: [useridto], references: [id])
  Conversation MessageConversations @relation(fields: [conversationid], references: [id])
  Message Messages @relation(fields: [messageid], references: [id])

  @@map("message_email_messages")
}

// Keep state of notifications for the popup message processor
model MessagePopup {
  id BigInt @id @default(autoincrement())
  messageid BigInt
  isread Boolean @default(false)

  Message Message @relation(fields: [messageid], references: [id])

  @@map("message_popup")
}

// List of notifications to display in the message output popup
model MessagePopupNotifications {
  id BigInt @id @default(autoincrement())
  notificationid BigInt

  Notification Notifications @relation(fields: [notificationid], references: [id])

  @@map("message_popup_notifications")
}

// List of message output plugins
model MessageProcessors {
  id BigInt @id @default(autoincrement())
  name String @default("") // Name of the message processor
  enabled Boolean @default(true) // Defines if processor is enabled

  @@map("message_processors")
}

// This table stores the message providers (modules and core sy
model MessageProviders {
  id BigInt @id @default(autoincrement()) // id of the table, please edit me
  name String @default("") // The full name of the message provider in standard form
  component String @default("") // The name of the component that produces these messages
  capability String? // Optional: permission that is required on the user's setting screen to see this message provider.

  @@map("message_providers")
}

// Stores all messages that have been read
model MessageRead {
  id BigInt @id @default(autoincrement())
  useridfrom BigInt @default(0)
  useridto BigInt @default(0)
  subject String? // The message subject
  fullmessage String?
  fullmessageformat Int? @default(0) // The format of the full message
  fullmessagehtml String? // html format of message
  smallmessage String? // Smal version of message (eg sms)
  notification Boolean? @default(false)
  contexturl String? // If this message is a notification of an event contexturl should contain a link to view this event. For example if its a notification of a forum post contexturl should contain a link to the forum post.
  contexturlname String? // Display text for the contexturl
  timecreated BigInt @default(0)
  timeread BigInt @default(0)
  timeuserfromdeleted BigInt @default(0)
  timeusertodeleted BigInt @default(0)
  component String?
  eventtype String?

  Useridfrom User @relation(fields: [useridfrom], references: [id])

  @@map("message_read")
}

// Stores all per-user actions on individual messages
model MessageUserActions {
  id BigInt @id @default(autoincrement())
  userid BigInt
  messageid BigInt
  action BigInt
  timecreated BigInt

  User User @relation(fields: [userid], references: [id])
  Message Messages @relation(fields: [messageid], references: [id])

  @@map("message_user_actions")
}

// Maintains lists of blocked users
model MessageUsersBlocked {
  id BigInt @id @default(autoincrement())
  userid BigInt
  blockeduserid BigInt
  timecreated BigInt?

  User User @relation(name: "message_users_blocked_userid", fields: [userid], references: [id])
  Blockeduser User @relation(name: "message_users_blocked_blockeduserid", fields: [blockeduserid], references: [id])

  @@map("message_users_blocked")
}

// Inbound Message data item secret keys.
model MessageinboundDatakeys {
  id BigInt @id @default(autoincrement())
  handler BigInt // The handler that this key belongs to.
  datavalue BigInt // The integer value of the data item that this key belongs to.
  datakey String? // The secret key for this data item.
  timecreated BigInt // The time that the data key was created.
  expires BigInt? // The expiry time of this key.

  Handler MessageinboundHandlers @relation(fields: [handler], references: [id])

  @@map("messageinbound_datakeys")
}

// Inbound Message Handler definitions.
model MessageinboundHandlers {
  id BigInt @id @default(autoincrement())
  component String @default("") // The component this handler belongs to.
  classname String @default("") // The class defining the Inbound Message handler to be called.
  defaultexpiration BigInt @default(86400) // The default expiration period to use when creating a new key
  validateaddress Boolean @default(true) // Whether to validate the sender address against the user record.
  enabled Boolean @default(false) // Whether this handler is currently enabled.

  MessageinboundDatakeys MessageinboundDatakeys[]

  @@map("messageinbound_handlers")
}

// A list of message IDs for existing replies
model MessageinboundMessagelist {
  id BigInt @id @default(autoincrement())
  messageid String
  userid BigInt
  address String // The Inbound Message address that the message was originally sent to
  timecreated BigInt

  User User @relation(fields: [userid], references: [id])

  @@map("messageinbound_messagelist")
}

// Stores all messages
model Messages {
  id BigInt @id @default(autoincrement())
  useridfrom BigInt
  conversationid BigInt
  subject String?
  fullmessage String?
  fullmessageformat Boolean @default(false)
  fullmessagehtml String?
  smallmessage String?
  timecreated BigInt
  fullmessagetrust Int @default(0)
  customdata String? // Custom data to be passed to the message processor. Must be serialisable using json_encode()

  Useridfrom User @relation(fields: [useridfrom], references: [id])
  Conversation MessageConversations @relation(fields: [conversationid], references: [id])

  MessageEmailMessages MessageEmailMessages[]
  MessageUserActions MessageUserActions[]

  @@map("messages")
}

// Information about applications on remote hosts
model MnetApplication {
  id BigInt @id @default(autoincrement())
  name String @default("")
  display_name String @default("")
  xmlrpc_server_url String @default("")
  sso_land_url String @default("")
  sso_jump_url String @default("")

  MnetHost MnetHost[]

  @@map("mnet_application")
}

// Information about the local and remote hosts for RPC
model MnetHost {
  id BigInt @id @default(autoincrement()) // Unique Host ID
  deleted Boolean @default(false)
  wwwroot String @default("")
  ip_address String @default("")
  name String @default("")
  public_key String
  public_key_expires BigInt @default(0)
  transport Int @default(0)
  portno Int @default(0)
  last_connect_time BigInt @default(0)
  last_log_id BigInt @default(0)
  force_theme Boolean @default(false)
  theme String?
  applicationid BigInt @default(1)
  sslverification Boolean @default(false)

  Application MnetApplication @relation(fields: [applicationid], references: [id])

  MnetLog MnetLog[]
  MnetserviceEnrolEnrolments MnetserviceEnrolEnrolments[]

  @@map("mnet_host")
}

// Information about the services for a given host
model MnetHost2service {
  id BigInt @id @default(autoincrement())
  hostid BigInt @default(0)
  serviceid BigInt @default(0)
  publish Boolean @default(false)
  subscribe Boolean @default(false)

  @@map("mnet_host2service")
}

// Store session data from users migrating to other sites
model MnetLog {
  id BigInt @id @default(autoincrement())
  hostid BigInt @default(0) // Unique host ID
  remoteid BigInt @default(0)
  time BigInt @default(0)
  userid BigInt @default(0)
  ip String @default("")
  course BigInt @default(0)
  coursename String @default("")
  module String @default("")
  cmid BigInt @default(0)
  action String @default("")
  url String @default("")
  info String @default("")

  Host MnetHost @relation(fields: [hostid], references: [id])
  User User @relation(fields: [userid], references: [id])

  @@map("mnet_log")
}

// This table describes functions that might be called remotely
model MnetRemoteRpc {
  id BigInt @id @default(autoincrement())
  functionname String @default("")
  xmlrpcpath String @default("")
  plugintype String @default("")
  pluginname String @default("")
  enabled Boolean

  @@map("mnet_remote_rpc")
}

// Group functions or methods under a service
model MnetRemoteService2rpc {
  id BigInt @id @default(autoincrement()) // Required ID field
  serviceid BigInt @default(0) // Unique service ID
  rpcid BigInt @default(0) // Unique Function ID

  @@map("mnet_remote_service2rpc")
}

// Functions or methods that we may publish or subscribe to
model MnetRpc {
  id BigInt @id @default(autoincrement()) // Unique Function ID
  functionname String @default("")
  xmlrpcpath String @default("")
  plugintype String @default("")
  pluginname String @default("")
  enabled Boolean @default(false)
  help String
  profile String // Method signature
  filename String @default("")
  classname String?
  static Boolean?

  @@map("mnet_rpc")
}

// A service is a group of functions
model MnetService {
  id BigInt @id @default(autoincrement()) // Unique Service ID
  name String @default("")
  description String @default("")
  apiversion String @default("")
  offer Boolean @default(false) // Do we even offer this service?

  MnetService2rpc MnetService2rpc[]

  @@map("mnet_service")
}

// Group functions or methods under a service
model MnetService2rpc {
  id BigInt @id @default(autoincrement()) // Required ID field
  serviceid BigInt @default(0) // Unique service ID
  rpcid BigInt @default(0) // Unique Function ID

  Service MnetService @relation(fields: [serviceid], references: [id])

  @@map("mnet_service2rpc")
}

// Store session data from users migrating to other sites
model MnetSession {
  id BigInt @id @default(autoincrement()) // Required ID field
  userid BigInt @default(0) // Unique user ID
  username String @default("") // Unique username
  token String @default("") // Unique SHA1 Token
  mnethostid BigInt @default(0) // Unique remote host ID
  useragent String @default("") // SHA1 hash of User Agent
  confirm_timeout BigInt @default(0) // UNIX timestamp for expiry of session
  session_id String @default("") // The PHP Session ID
  expires BigInt @default(0) // Expire time of session on peer

  User User @relation(fields: [userid], references: [id])

  @@map("mnet_session")
}

// Users by host permitted (or not) to login from a remote prov
model MnetSsoAccessControl {
  id BigInt @id @default(autoincrement()) // Required ID field
  username String @default("") // Username
  mnet_host_id BigInt @default(0) // id of mnet host
  accessctrl String @default("allow") // Whether or not this user/host can login

  @@map("mnet_sso_access_control")
}

// Caches the information fetched via XML-RPC about courses on
model MnetserviceEnrolCourses {
  id BigInt @id @default(autoincrement()) // Unique remote-course ID
  hostid BigInt // The id of the remote MNet host
  remoteid BigInt // ID of course on its home server
  categoryid BigInt // The id of the category on the remote server
  categoryname String @default("")
  sortorder BigInt @default(0)
  fullname String @default("")
  shortname String @default("")
  idnumber String @default("")
  summary String
  summaryformat Int? @default(0) // Format of the summary field
  startdate BigInt
  roleid BigInt // The ID of the role at the remote server that our users will get when we enrol them there
  rolename String @default("") // The name of the role at the remote server that our users will get when we enrol them there

  Role Role @relation(fields: [roleid], references: [id])

  @@map("mnetservice_enrol_courses")
}

// Caches the information about enrolments of our local users i
model MnetserviceEnrolEnrolments {
  id BigInt @id @default(autoincrement()) // Unique enrollment ID
  hostid BigInt // ID of the remote MNet host
  userid BigInt // ID of our local user on this server
  remotecourseid BigInt // ID of the course at the remote server. Note that this may and may not be cached in our mnetservice_enrol_courses table, depends of whether the course is opened for remote enrolments or our student is the enrolled there via other plugin
  rolename String @default("")
  enroltime BigInt @default(0)
  enroltype String @default("") // The name of the enrol plugin at the remote server that was used to enrol our student into their course

  Host MnetHost @relation(fields: [hostid], references: [id])
  User User @relation(fields: [userid], references: [id])

  @@map("mnetservice_enrol_enrolments")
}

// modules available in the site
model Modules {
  id BigInt @id @default(autoincrement())
  name String @default("")
  cron BigInt @default(0)
  lastcron BigInt @default(0)
  search String @default("")
  visible Boolean @default(true)

  CourseCompletionDefaults CourseCompletionDefaults[]

  @@map("modules")
}

// Extra user pages for the My Moodle system
model MyPages {
  id BigInt @id @default(autoincrement())
  userid BigInt? @default(0) // The user who owns this page or 0 for system defaults
  name String @default("") // The page name (freeform text)
  private Boolean @default(true) // Whether or not the page is private (dashboard) or public (profile)
  sortorder Int @default(0) // The order of the pages for a user

  User User? @relation(fields: [userid], references: [id])

  @@map("my_pages")
}

// Stores all notifications
model Notifications {
  id BigInt @id @default(autoincrement())
  useridfrom BigInt
  useridto BigInt
  subject String? // The message subject
  fullmessage String?
  fullmessageformat Boolean @default(false)
  fullmessagehtml String?
  smallmessage String?
  component String?
  eventtype String?
  contexturl String?
  contexturlname String?
  timeread BigInt?
  timecreated BigInt
  customdata String? // Custom data to be passed to the message processor. Must be serialisable using json_encode()

  Useridto User @relation(fields: [useridto], references: [id])

  MessagePopupNotifications MessagePopupNotifications[]

  @@map("notifications")
}

// Stores access tokens for system accounts in order to be able
model Oauth2AccessToken {
  id BigInt @id @default(autoincrement())
  timecreated BigInt // Time this record was created.
  timemodified BigInt // Time this record was modified.
  usermodified BigInt // The user who modified this record.
  issuerid BigInt // Corresponding oauth2 issuer
  token String // access token
  expires BigInt // Expiry timestamp (according to the issuer)
  scope String

  Issuer Oauth2Issuer @relation(fields: [issuerid], references: [id])

  @@map("oauth2_access_token")
}

// Describes the named endpoint for an oauth2 service.
model Oauth2Endpoint {
  id BigInt @id @default(autoincrement())
  timecreated BigInt // The time this record was created.
  timemodified BigInt // The time this record was modified.
  usermodified BigInt // The user who modified this record.
  name String @default("") // The service name.
  url String // The url to the endpoint
  issuerid BigInt // The identity provider this service belongs to.

  Issuer Oauth2Issuer @relation(fields: [issuerid], references: [id])

  @@map("oauth2_endpoint")
}

// Details for an oauth 2 connect identity issuer.
model Oauth2Issuer {
  id BigInt @id @default(autoincrement())
  timecreated BigInt // Time this record was created.
  timemodified BigInt // Time this record was modified.
  usermodified BigInt // The user who modified this record
  name String @default("") // The name of this identity issuer
  image String
  baseurl String // The base url to the issuer
  clientid String // The client id used to connect to this oauth2 service.
  clientsecret String // The secret used to connect to this oauth2 service.
  loginscopes String // The scopes requested for a normal login attempt.
  loginscopesoffline String // The scopes requested for a login attempt to generate a refresh token.
  loginparams String // Additional parameters sent for a login attempt.
  loginparamsoffline String // Additional parameters sent for a login attempt to generate a refresh token.
  alloweddomains String // Allowed domains for this issuer.
  scopessupported String? // The list of scopes this service supports.
  enabled Int @default(1)
  showonloginpage Int @default(1)
  basicauth Int @default(0) // Use HTTP Basic authentication scheme when sending client ID and password
  sortorder BigInt // The defined sort order.
  requireconfirmation Int @default(1)
  servicetype String? // Issuer service type, such as 'google' or 'facebook'.
  loginpagename String?

  AuthOauth2LinkedLogin AuthOauth2LinkedLogin[]
  BadgeBackpackOauth2 BadgeBackpackOauth2[]
  BadgeExternalBackpack BadgeExternalBackpack[]
  Oauth2AccessToken Oauth2AccessToken[]
  Oauth2Endpoint Oauth2Endpoint[]
  Oauth2RefreshToken Oauth2RefreshToken[]
  Oauth2SystemAccount Oauth2SystemAccount[]
  Oauth2UserFieldMapping Oauth2UserFieldMapping[]

  @@map("oauth2_issuer")
}

// Stores refresh tokens which can be exchanged for access toke
model Oauth2RefreshToken {
  id BigInt @id @default(autoincrement())
  timecreated BigInt // Time this record was created.
  timemodified BigInt // Time this record was modified.
  userid BigInt // The user to whom this refresh token belongs.
  issuerid BigInt // Corresponding oauth2 issuer
  token String // refresh token
  scopehash String @default("") // sha1 hash of the scopes used when requesting the refresh token

  User User @relation(fields: [userid], references: [id])
  Issuer Oauth2Issuer @relation(fields: [issuerid], references: [id])

  @@map("oauth2_refresh_token")
}

// Stored details used to get an access token as a system user
model Oauth2SystemAccount {
  id BigInt @id @default(autoincrement())
  timecreated BigInt // Time this record was created.
  timemodified BigInt // Time this record was modified.
  usermodified BigInt // The user who modified this record.
  issuerid BigInt // The id of the oauth 2 identity issuer
  refreshtoken String // The refresh token used to request access tokens.
  grantedscopes String // The scopes that this system account has been granted access to.
  email String? // The email that was connected to this issuer.
  username String // The username that was connected as a system account to this issue.

  Issuer Oauth2Issuer @relation(fields: [issuerid], references: [id])

  @@map("oauth2_system_account")
}

// Mapping of oauth user fields to moodle fields.
model Oauth2UserFieldMapping {
  id BigInt @id @default(autoincrement())
  timemodified BigInt // The time this record was modified
  timecreated BigInt // The time this record was created.
  usermodified BigInt // The user who modified this record.
  issuerid BigInt // The oauth issuer.
  externalfield String @default("") // The fieldname returned by the userinfo endpoint.
  internalfield String @default("") // The name of the Moodle field this user field maps to.

  Issuer Oauth2Issuer @relation(fields: [issuerid], references: [id])

  @@map("oauth2_user_field_mapping")
}

// Each record is one page and its config data
model Page {
  id BigInt @id @default(autoincrement())
  course BigInt @default(0)
  name String @default("")
  intro String?
  introformat Int @default(0)
  content String?
  contentformat Int @default(0)
  legacyfiles Int @default(0)
  legacyfileslast BigInt?
  display Int @default(0)
  displayoptions String?
  revision BigInt @default(0) // incremented when after each file changes, solves browser caching issues
  timemodified BigInt @default(0)

  Course Course @relation(fields: [course], references: [id])

  @@map("page")
}

// Stores PayPal related information
model PaygwPaypal {
  id BigInt @id @default(autoincrement())
  paymentid BigInt
  pp_orderid String @default("The ID of the order in PayPal")

  Payment Payments @relation(fields: [paymentid], references: [id])

  @@map("paygw_paypal")
}

// Payment accounts
model PaymentAccounts {
  id BigInt @id @default(autoincrement())
  name String @default("")
  idnumber String?
  contextid BigInt
  enabled Boolean @default(false)
  archived Boolean @default(false)
  timecreated BigInt?
  timemodified BigInt?

  Context Context @relation(fields: [contextid], references: [id])

  PaymentGateways PaymentGateways[]
  Payments Payments[]

  @@map("payment_accounts")
}

// Configuration for one gateway for one payment account
model PaymentGateways {
  id BigInt @id @default(autoincrement())
  accountid BigInt
  gateway String @default("")
  enabled Boolean @default(true)
  config String?
  timecreated BigInt
  timemodified BigInt

  Account PaymentAccounts @relation(fields: [accountid], references: [id])

  @@map("payment_gateways")
}

// Stores information about payments
model Payments {
  id BigInt @id @default(autoincrement())
  component String @default("") // The plugin this payment belongs to.
  paymentarea String @default("") // The name of payable area
  itemid BigInt
  userid BigInt
  amount String @default("")
  currency String @default("")
  accountid BigInt
  gateway String @default("")
  timecreated BigInt @default(0)
  timemodified BigInt @default(0)

  User User @relation(fields: [userid], references: [id])
  Account PaymentAccounts @relation(fields: [accountid], references: [id])

  PaygwPaypal PaygwPaypal[]

  @@map("payments")
}

// base table (not including config data) for instances of port
model PortfolioInstance {
  id BigInt @id @default(autoincrement())
  plugin String @default("") // fk to plugin
  name String @default("") // name of plugin instance
  visible Boolean @default(true) // whether this instance is visible or not

  PortfolioInstanceConfig PortfolioInstanceConfig[]
  PortfolioInstanceUser PortfolioInstanceUser[]
  PortfolioLog PortfolioLog[]
  PortfolioTempdata PortfolioTempdata[]

  @@map("portfolio_instance")
}

// config for portfolio plugin instances
model PortfolioInstanceConfig {
  id BigInt @id @default(autoincrement())
  instance BigInt // instance of plugin we're configurating
  name String @default("") // config field
  value String? // config value

  Instance PortfolioInstance @relation(fields: [instance], references: [id])

  @@map("portfolio_instance_config")
}

// user data for portfolio instances.
model PortfolioInstanceUser {
  id BigInt @id @default(autoincrement())
  instance BigInt // fk to instance table
  userid BigInt // fk to user table
  name String @default("") // name of config item
  value String? // value of config item

  Instance PortfolioInstance @relation(fields: [instance], references: [id])
  User User @relation(fields: [userid], references: [id])

  @@map("portfolio_instance_user")
}

// log of portfolio transfers (used to later check for duplicat
model PortfolioLog {
  id BigInt @id @default(autoincrement())
  userid BigInt // user who exported content
  time BigInt // time of transfer (in the case of a queued transfer this is the time the actual transfer ran, not when the user started)
  portfolio BigInt // fk to portfolio_instance
  caller_class String @default("") // the name of the class used to create the transfer
  caller_file String @default("") // path to file to include where the class definition lives. (relative to dirroot)
  caller_component String? // the component name responsible for exporting
  caller_sha1 String @default("") // sha1 of exported content as far as the caller is concerned (before the portfolio plugin gets a hold of it)
  tempdataid BigInt @default(0) // old id from portfolio_tempdata. This is so that we can gracefully catch a race condition between an external system requesting a file and causing the tempdata to be deleted, before the user gets the &quot;your transfer is requested&quot; page
  returnurl String @default("") // the original &quot;returnurl&quot; of the export - takes us to the moodle page we started from
  continueurl String @default("") // the url the external system has set to view the transfer

  User User @relation(fields: [userid], references: [id])
  Portfolio PortfolioInstance @relation(fields: [portfolio], references: [id])

  @@map("portfolio_log")
}

// maps mahara tokens to transfer ids
model PortfolioMaharaQueue {
  id BigInt @id @default(autoincrement())
  transferid BigInt // fk to portfolio_tempdata.id
  token String @default("") // the token mahara sent us to use for this transfer.

  Transfer PortfolioTempdata @relation(fields: [transferid], references: [id])

  @@map("portfolio_mahara_queue")
}

// stores temporary data for portfolio exports. the id of this
model PortfolioTempdata {
  id BigInt @id @default(autoincrement())
  data String? // dumping ground for portfolio callers to store their data in.
  expirytime BigInt // time this record will expire (used for cron cleanups) - the start of export + 24 hours
  userid BigInt // psuedo fk to user. this is stored in the serialised data structure in the data field, but added here for ease of lookups.
  instance BigInt? @default(0) // which portfolio plugin instance is being used
  queued Boolean @default(false) // Value 1 means the entry should be processed in cron.

  User User @relation(fields: [userid], references: [id])
  Instance PortfolioInstance? @relation(fields: [instance], references: [id])

  PortfolioMaharaQueue PortfolioMaharaQueue[]

  @@map("portfolio_tempdata")
}

// Generic post table to hold data blog entries etc in differen
model Post {
  id BigInt @id @default(autoincrement())
  module String @default("")
  userid BigInt @default(0)
  courseid BigInt @default(0)
  groupid BigInt @default(0)
  moduleid BigInt @default(0)
  coursemoduleid BigInt @default(0)
  subject String @default("")
  summary String?
  content String?
  uniquehash String @default("")
  rating BigInt @default(0)
  format BigInt @default(0)
  summaryformat Int @default(0)
  attachment String? // attachment
  publishstate String @default("draft")
  lastmodified BigInt @default(0)
  created BigInt @default(0)
  usermodified BigInt?

  User User @relation(name: "post_userid", fields: [userid], references: [id])
  Course Course @relation(name: "post_courseid", fields: [courseid], references: [id])
  Coursemodule Course @relation(name: "post_coursemoduleid", fields: [coursemoduleid], references: [id])
  Usermodified User? @relation(name: "post_usermodified", fields: [usermodified], references: [id])

  BlogAssociation BlogAssociation[]

  @@map("post")
}

// Stores the results of all the profiling runs
model Profiling {
  id BigInt @id @default(autoincrement())
  runid String @default("") // the unique id for this run (as generated by xhprof)
  url String @default("") // the url this profiling record is about (without wwwroot nor query params)
  data String // the raw data gathered by xhprof
  totalexecutiontime BigInt // time (in microseconds) spent by the run
  totalcputime BigInt // time (in microseconds) spent by the CPU in this run
  totalcalls BigInt // Total number of calls performed by the run
  totalmemory BigInt // Total memory used byt the run
  runreference Int @default(0) // Is this run a reference one
  runcomment String @default("") // Brief comment for this run
  timecreated BigInt // unix timestap of the creation of this run

  @@map("profiling")
}

// Defines drag and drop (text or images onto a background imag
model QtypeDdimageortext {
  id BigInt @id @default(autoincrement())
  questionid BigInt @default(0)
  shuffleanswers Int @default(1)
  correctfeedback String // Feedback shown for any correct response.
  correctfeedbackformat Int @default(0)
  partiallycorrectfeedback String // Feedback shown for any partially correct response.
  partiallycorrectfeedbackformat Int @default(0)
  incorrectfeedback String // Feedback shown for any incorrect response.
  incorrectfeedbackformat Int @default(0)
  shownumcorrect Int @default(0)

  Question Question @relation(fields: [questionid], references: [id])

  @@map("qtype_ddimageortext")
}

// Images to drag. Actual file names are not stored here we use
model QtypeDdimageortextDrags {
  id BigInt @id @default(autoincrement())
  questionid BigInt @default(0)
  no BigInt @default(0) // drag no
  draggroup BigInt @default(0)
  infinite Int @default(0)
  label String // Alt text label for drag-able image.

  Question Question @relation(fields: [questionid], references: [id])

  @@map("qtype_ddimageortext_drags")
}

// Drop boxes
model QtypeDdimageortextDrops {
  id BigInt @id @default(autoincrement())
  questionid BigInt @default(0)
  no BigInt @default(0) // drop number
  xleft BigInt @default(0)
  ytop BigInt @default(0)
  choice BigInt @default(0)
  label String // Alt label for drop box

  Question Question @relation(fields: [questionid], references: [id])

  @@map("qtype_ddimageortext_drops")
}

// Defines drag and drop (text or images onto a background imag
model QtypeDdmarker {
  id BigInt @id @default(autoincrement())
  questionid BigInt @default(0)
  shuffleanswers Int @default(1)
  correctfeedback String // Feedback shown for any correct response.
  correctfeedbackformat Int @default(0)
  partiallycorrectfeedback String // Feedback shown for any partially correct response.
  partiallycorrectfeedbackformat Int @default(0)
  incorrectfeedback String // Feedback shown for any incorrect response.
  incorrectfeedbackformat Int @default(0)
  shownumcorrect Int @default(0)
  showmisplaced Int @default(0)

  Question Question @relation(fields: [questionid], references: [id])

  @@map("qtype_ddmarker")
}

// Labels for markers to drag.
model QtypeDdmarkerDrags {
  id BigInt @id @default(autoincrement())
  questionid BigInt @default(0)
  no BigInt @default(0) // drag no
  label String // Alt text label for drag-able image.
  infinite Int @default(0)
  noofdrags BigInt @default(1) // No of drag items, ignored if drag is infinite.

  Question Question @relation(fields: [questionid], references: [id])

  @@map("qtype_ddmarker_drags")
}

// drop regions
model QtypeDdmarkerDrops {
  id BigInt @id @default(autoincrement())
  questionid BigInt @default(0)
  no BigInt @default(0) // drop number
  shape String? // circle, rectangle, polygon
  coords String
  choice BigInt @default(0)

  Question Question @relation(fields: [questionid], references: [id])

  @@map("qtype_ddmarker_drops")
}

// Extra options for essay questions.
model QtypeEssayOptions {
  id BigInt @id @default(autoincrement())
  questionid BigInt // Foreign key linking to the question table.
  responseformat String @default("editor") // The type of input area students should be given for their response.
  responserequired Int @default(1) // Nonzero if an online text response is optional
  responsefieldlines Int @default(15) // Approximate height, in lines, of the input box the students should be given for their response.
  minwordlimit BigInt? // Minimum number of words
  maxwordlimit BigInt? // Maximum number of words
  attachments Int @default(0) // Whether, and how many, attachments a student is allowed to include with their response. -1 means unlimited.
  attachmentsrequired Int @default(0) // The number of attachments that should be required
  graderinfo String? // Information shown to people with permission to manually grade the question, when they are grading.
  graderinfoformat Int @default(0) // The text format for graderinfo.
  responsetemplate String? // The template to pre-populate student's response field during attempt.
  responsetemplateformat Int @default(0) // The text format for responsetemplate.
  maxbytes BigInt @default(0) // Maximum size of attached files in bytes.
  filetypeslist String? // What attachment file type a student is allowed to include with their response. * or empty means unlimited.

  Question Question @relation(fields: [questionid], references: [id])

  @@map("qtype_essay_options")
}

// Defines the question-type specific options for matching ques
model QtypeMatchOptions {
  id BigInt @id @default(autoincrement())
  questionid BigInt @default(0) // Foreign key link to question.id.
  shuffleanswers Int @default(1)
  correctfeedback String // Feedback shown for any correct response.
  correctfeedbackformat Int @default(0)
  partiallycorrectfeedback String // Feedback shown for any partially correct response.
  partiallycorrectfeedbackformat Int @default(0)
  incorrectfeedback String // Feedback shown for any incorrect response.
  incorrectfeedbackformat Int @default(0)
  shownumcorrect Int @default(0) // If true, then when the user gets the question partially correct, tell them how many choices they got correct alongside the feedback.

  Question Question @relation(fields: [questionid], references: [id])

  @@map("qtype_match_options")
}

// The subquestions that make up a matching question
model QtypeMatchSubquestions {
  id BigInt @id @default(autoincrement())
  questionid BigInt @default(0) // Foreign key link to question.id.
  questiontext String
  questiontextformat Int @default(0)
  answertext String @default("")

  Question Question @relation(fields: [questionid], references: [id])

  @@map("qtype_match_subquestions")
}

// Options for multiple choice questions
model QtypeMultichoiceOptions {
  id BigInt @id @default(autoincrement())
  questionid BigInt @default(0) // Foreign key references question.id
  layout Int @default(0) // Not used. Was intended for a vertical/horizontal layout option. See MDL-18445.
  single Int @default(0) // If 0 it multiple response (checkboxes). Otherwise it is radio buttons.
  shuffleanswers Int @default(1) // Whether the choices can be randomly shuffled.
  correctfeedback String // Feedback shown for any correct response.
  correctfeedbackformat Int @default(0)
  partiallycorrectfeedback String // Feedback shown for any partially correct response.
  partiallycorrectfeedbackformat Int @default(0)
  incorrectfeedback String // Feedback shown for any incorrect response.
  incorrectfeedbackformat Int @default(0)
  answernumbering String @default("abc") // Indicates how and whether the choices should be numbered.
  shownumcorrect Int @default(0) // If true, then when the user gets a multiple-response question partially correct, tell them how many choices they got correct alongside the feedback.
  showstandardinstruction Int @default(1) // Whether standard instruction ('Select one:' or 'Select one or more:') is displayed

  Question Question @relation(fields: [questionid], references: [id])

  @@map("qtype_multichoice_options")
}

// Info about a random short-answer matching question
model QtypeRandomsamatchOptions {
  id BigInt @id @default(autoincrement())
  questionid BigInt @default(0) // Foreign key references question.id.
  choose BigInt @default(4) // Number of subquestions to randomly generate.
  subcats Int @default(1) // Whether to include or not the subcategories.
  correctfeedback String // Feedback shown for any correct response.
  correctfeedbackformat Int @default(0)
  partiallycorrectfeedback String // Feedback shown for any partially correct response.
  partiallycorrectfeedbackformat Int @default(0)
  incorrectfeedback String // Feedback shown for any incorrect response.
  incorrectfeedbackformat Int @default(0)
  shownumcorrect Int @default(0) // If true, then when the user gets the question partially correct, tell them how many choices they got correct alongside the feedback.

  Question Question @relation(fields: [questionid], references: [id])

  @@map("qtype_randomsamatch_options")
}

// Options for short answer questions
model QtypeShortanswerOptions {
  id BigInt @id @default(autoincrement())
  questionid BigInt @default(0) // Foreign key references question.id.
  usecase Int @default(0) // Whether answers are matched case-sensitively.

  Question Question @relation(fields: [questionid], references: [id])

  @@map("qtype_shortanswer_options")
}

// This table stores the definition of one version of a questio
model Question {
  id BigInt @id @default(autoincrement())
  parent BigInt @default(0)
  name String @default("")
  questiontext String
  questiontextformat Int @default(0)
  generalfeedback String // to store the question feedback
  generalfeedbackformat Int @default(0)
  defaultmark Decimal @default(1.0)
  penalty Decimal @default(0.3333333)
  qtype String @default("")
  length BigInt @default(1)
  stamp String @default("")
  timecreated BigInt @default(0) // time question was created
  timemodified BigInt @default(0) // time that question was last modified
  createdby BigInt? // userid of person who created this question
  modifiedby BigInt? // userid of person who last edited this question

  Parent Question @relation(name: "question_parent", fields: [parent], references: [id])
  Createdby User? @relation(name: "question_createdby", fields: [createdby], references: [id])
  Modifiedby User? @relation(name: "question_modifiedby", fields: [modifiedby], references: [id])

  QtypeDdimageortext QtypeDdimageortext[]
  QtypeDdimageortextDrags QtypeDdimageortextDrags[]
  QtypeDdimageortextDrops QtypeDdimageortextDrops[]
  QtypeDdmarker QtypeDdmarker[]
  QtypeDdmarkerDrags QtypeDdmarkerDrags[]
  QtypeDdmarkerDrops QtypeDdmarkerDrops[]
  QtypeEssayOptions QtypeEssayOptions[]
  QtypeMatchOptions QtypeMatchOptions[]
  QtypeMatchSubquestions QtypeMatchSubquestions[]
  QtypeMultichoiceOptions QtypeMultichoiceOptions[]
  QtypeRandomsamatchOptions QtypeRandomsamatchOptions[]
  QtypeShortanswerOptions QtypeShortanswerOptions[]
  QuestionByParent Question[] @relation(name: "question_parent")
  QuestionAnswers QuestionAnswers[]
  QuestionAttempts QuestionAttempts[]
  QuestionCalculated QuestionCalculated[]
  QuestionCalculatedOptions QuestionCalculatedOptions[]
  QuestionDatasets QuestionDatasets[]
  QuestionDdwtos QuestionDdwtos[]
  QuestionGapselect QuestionGapselect[]
  QuestionHints QuestionHints[]
  QuestionMultianswer QuestionMultianswer[]
  QuestionNumerical QuestionNumerical[]
  QuestionNumericalOptions QuestionNumericalOptions[]
  QuestionNumericalUnits QuestionNumericalUnits[]
  QuestionResponseAnalysis QuestionResponseAnalysis[]
  QuestionStatistics QuestionStatistics[]
  QuestionTruefalse QuestionTruefalse[]
  QuestionVersions QuestionVersions[]

  @@map("question")
}

// Answers, with a fractional grade (0-1) and feedback
model QuestionAnswers {
  id BigInt @id @default(autoincrement())
  question BigInt @default(0)
  answer String
  answerformat Int @default(0)
  fraction Decimal @default(0.0)
  feedback String
  feedbackformat Int @default(0)

  Question Question @relation(fields: [question], references: [id])

  @@map("question_answers")
}

// Each question_attempt_step has an associative array of the d
model QuestionAttemptStepData {
  id BigInt @id @default(autoincrement())
  attemptstepid BigInt // Foreign key, references question_attempt_steps.id
  name String @default("") // The name of this bit of data.
  value String? // The corresponding value

  Attemptstep QuestionAttemptSteps @relation(fields: [attemptstepid], references: [id])

  @@map("question_attempt_step_data")
}

// Stores one step in in a question attempt. As well as the dat
model QuestionAttemptSteps {
  id BigInt @id @default(autoincrement())
  questionattemptid BigInt // Foreign key, references question_attempt.id
  sequencenumber BigInt // Numbers the steps in a question attempt sequentially.
  state String @default("") // One of the constants defined by the question_state class, giving the state of the question at the end of this step.
  fraction Decimal? // The grade for this question, when graded out of 1. Needs to be multiplied by question_attempt.maxmark to get the actual mark for the question.
  timecreated BigInt // Time-stamp of the action that lead to this state being created.
  userid BigInt? // The user whose action lead to this state being created.

  Questionattempt QuestionAttempts @relation(fields: [questionattemptid], references: [id])
  User User? @relation(fields: [userid], references: [id])

  QuestionAttemptStepData QuestionAttemptStepData[]

  @@map("question_attempt_steps")
}

// Each row here corresponds to an attempt at one question, as
model QuestionAttempts {
  id BigInt @id @default(autoincrement())
  questionusageid BigInt @unique // Foreign key, references question_usages.id
  slot BigInt @unique // Used to number the questions in one attempt sequentially.
  behaviour String @default("") // The name of the question behaviour that is managing this question attempt.
  questionid BigInt // The id of the question being attempted. Foreign key references question.id.
  variant BigInt @default(1) // The variant of the qusetion being used.
  maxmark Decimal // The grade this question is marked out of in this attempt.
  minfraction Decimal // Some questions can award negative marks. This indicates the most negative mark that can be awarded, on the faction scale where the maximum positive mark is 1.
  maxfraction Decimal @default(1.0) // Some questions can give fractions greater than 1. This indicates the greatest fraction that can be awarded.
  flagged Boolean @default(false) // Whether this question has been flagged within the attempt.
  questionsummary String? // If this question uses randomisation, it should set this field to summarise what random version the student actually saw. This is a human-readable textual summary of the student's response which might, for example, be used in a report.
  rightanswer String? // This is a human-readable textual summary of the right answer to this question. Might be used, for example on the quiz preview, to help people who are testing the question. Or might be used in reports.
  responsesummary String? // This is a textual summary of the student's response (basically what you would expect to in the Quiz responses report).
  timemodified BigInt // The time this record was last changed.

  Questionusage QuestionUsages @relation(fields: [questionusageid], references: [id])
  Question Question @relation(fields: [questionid], references: [id])

  QuestionAttemptSteps QuestionAttemptSteps[]
  QuizOverviewRegradesByQuestionusage QuizOverviewRegrades[] @relation(name: "quiz_overview_regrades_questionusageid")
  QuizOverviewRegradesBySlot QuizOverviewRegrades[] @relation(name: "quiz_overview_regrades_slot")

  @@map("question_attempts")
}

// Each question bank entry. This table has one row for each qu
model QuestionBankEntries {
  id BigInt @id @default(autoincrement())
  questioncategoryid BigInt @default(0) // ID of the category this question is part of.
  idnumber String? // Unique identifier, useful especially for mapping to external entities.
  ownerid BigInt? // userid of person who owns this question bank entry.

  Questioncategory QuestionCategories @relation(fields: [questioncategoryid], references: [id])
  Owner User? @relation(fields: [ownerid], references: [id])

  QuestionReferences QuestionReferences[]
  QuestionVersions QuestionVersions[]

  @@map("question_bank_entries")
}

// Options for questions of type calculated
model QuestionCalculated {
  id BigInt @id @default(autoincrement())
  question BigInt @default(0)
  answer BigInt @default(0)
  tolerance String @default("0.0")
  tolerancetype BigInt @default(1)
  correctanswerlength BigInt @default(2)
  correctanswerformat BigInt @default(2)

  Question Question @relation(fields: [question], references: [id])

  @@map("question_calculated")
}

// Options for questions of type calculated
model QuestionCalculatedOptions {
  id BigInt @id @default(autoincrement())
  question BigInt @default(0)
  synchronize Int @default(0)
  single Int @default(0) // If 0 it multiple response (checkboxes). Otherwise it is radio buttons.
  shuffleanswers Int @default(0) // Whether the choices can be randomly shuffled.
  correctfeedback String? // Feedback shown for any correct response.
  correctfeedbackformat Int @default(0)
  partiallycorrectfeedback String? // Feedback shown for any partially correct response.
  partiallycorrectfeedbackformat Int @default(0)
  incorrectfeedback String? // Feedback shown for any incorrect response.
  incorrectfeedbackformat Int @default(0)
  answernumbering String @default("abc") // Indicates how and whether the choices should be numbered.
  shownumcorrect Int @default(0) // If true, then when the user gets a multiple-response question partially correct, tell them how many choices they got correct alongside the feedback.

  Question Question @relation(fields: [question], references: [id])

  @@map("question_calculated_options")
}

// Categories are for grouping questions
model QuestionCategories {
  id BigInt @id @default(autoincrement())
  name String @default("")
  contextid BigInt @default(0) // context that this category is shared in
  info String
  infoformat Int @default(0)
  stamp String @default("")
  parent BigInt @default(0)
  sortorder BigInt @default(999)
  idnumber String?

  Context Context @relation(fields: [contextid], references: [id])
  Parent QuestionCategories @relation(name: "question_categories_parent", fields: [parent], references: [id])

  QuestionBankEntries QuestionBankEntries[]
  QuestionCategoriesByParent QuestionCategories[] @relation(name: "question_categories_parent")
  QuestionDatasetDefinitions QuestionDatasetDefinitions[]

  @@map("question_categories")
}

// Organises and stores properties for dataset items
model QuestionDatasetDefinitions {
  id BigInt @id @default(autoincrement())
  category BigInt @default(0)
  name String @default("")
  type BigInt @default(0)
  options String @default("")
  itemcount BigInt @default(0)

  Category QuestionCategories @relation(fields: [category], references: [id])

  QuestionDatasets QuestionDatasets[]

  @@map("question_dataset_definitions")
}

// Individual dataset items
model QuestionDatasetItems {
  id BigInt @id @default(autoincrement())
  definition BigInt @default(0)
  itemnumber BigInt @default(0)
  value String @default("")

  @@map("question_dataset_items")
}

// Many-many relation between questions and dataset definitions
model QuestionDatasets {
  id BigInt @id @default(autoincrement())
  question BigInt @default(0)
  datasetdefinition BigInt @default(0)

  Question Question @relation(fields: [question], references: [id])
  Datasetdefinition QuestionDatasetDefinitions @relation(fields: [datasetdefinition], references: [id])

  @@map("question_datasets")
}

// Defines drag and drop (words into sentences) questions
model QuestionDdwtos {
  id BigInt @id @default(autoincrement())
  questionid BigInt @default(0)
  shuffleanswers Int @default(1)
  correctfeedback String // Feedback shown for any correct response.
  correctfeedbackformat Int @default(0)
  partiallycorrectfeedback String // Feedback shown for any partially correct response.
  partiallycorrectfeedbackformat Int @default(0)
  incorrectfeedback String // Feedback shown for any incorrect response.
  incorrectfeedbackformat Int @default(0)
  shownumcorrect Int @default(0)

  Question Question @relation(fields: [questionid], references: [id])

  @@map("question_ddwtos")
}

// Defines select missing words questions
model QuestionGapselect {
  id BigInt @id @default(autoincrement())
  questionid BigInt @default(0)
  shuffleanswers Int @default(1)
  correctfeedback String // Feedback shown for any correct response.
  correctfeedbackformat Int @default(0)
  partiallycorrectfeedback String // Feedback shown for any partially correct response.
  partiallycorrectfeedbackformat Int @default(0)
  incorrectfeedback String // Feedback shown for any incorrect response.
  incorrectfeedbackformat Int @default(0)
  shownumcorrect Int @default(0)

  Question Question @relation(fields: [questionid], references: [id])

  @@map("question_gapselect")
}

// Stores the the part of the question definition that gives di
model QuestionHints {
  id BigInt @id @default(autoincrement())
  questionid BigInt
  hint String // The text of the feedback to be given.
  hintformat Int @default(0) // The format of the hint.
  shownumcorrect Boolean? // Whether the feedback should include a message about how many things the student got right. This is only applicable to certain question types (for example matching or multiple choice multiple-response).
  clearwrong Boolean? // Whether any wrong choices should be cleared before the next try. Whether this is applicable, and what it means, depends on the question type, as with the shownumright option.
  options String? // A space for any other question-type specific options.

  Question Question @relation(fields: [questionid], references: [id])

  @@map("question_hints")
}

// Options for multianswer questions
model QuestionMultianswer {
  id BigInt @id @default(autoincrement())
  question BigInt @default(0)
  sequence String

  Question Question @relation(fields: [question], references: [id])

  @@map("question_multianswer")
}

// Options for numerical questions.
model QuestionNumerical {
  id BigInt @id @default(autoincrement())
  question BigInt @default(0) // Redundant, because of the answer field. Foreign key references question.id.
  answer BigInt @default(0) // Foreign key references question_answers.id.
  tolerance String @default("0.0") // Allowed error when matching a response to this answer. I don't know why this is stored as a string.

  Question Question @relation(fields: [question], references: [id])

  @@map("question_numerical")
}

// Options for questions of type numerical This table is also u
model QuestionNumericalOptions {
  id BigInt @id @default(autoincrement())
  question BigInt @default(0)
  showunits Int @default(0) // How units are handled: 3) Not used at all, 0) Optional, or 1) must be right or penalty applied.
  unitsleft Int @default(0) // display the unit at left as in $1.00
  unitgradingtype Int @default(0) // 0 no penalty, 1 fraction response grade, 2 fraction total grade
  unitpenalty Decimal @default(0.1) // Penalty for getting the unit wrong, when they are being graded.

  Question Question @relation(fields: [question], references: [id])

  @@map("question_numerical_options")
}

// Optional unit options for numerical questions. This table is
model QuestionNumericalUnits {
  id BigInt @id @default(autoincrement())
  question BigInt @default(0) // Foreign key references question.id
  multiplier Decimal @default(1.0) // The multiplier for this unit. For example, if the first unit is (1.0, 'cm'), another unit might be (0.1, 'mm') or (100.0, 'm').
  unit String @default("") // The unit. For example 'm' or 'kg'.

  Question Question @relation(fields: [question], references: [id])

  @@map("question_numerical_units")
}

// Records where a specific question is used.
model QuestionReferences {
  id BigInt @id @default(autoincrement())
  usingcontextid BigInt @default(0) // Context where question is used.
  component String? // Component (e.g. mod_quiz or core_question)
  questionarea String? // Depending on the component, which area the question is used in (e.g. slot for quiz).
  itemid BigInt? // Plugin specific id (e.g. slotid for quiz) where its used.
  questionbankentryid BigInt @default(0) // ID of the question bank entry this question is part of.
  version BigInt? // Version number for the question where NULL means use the latest ready version.

  Usingcontext Context @relation(fields: [usingcontextid], references: [id])
  Questionbankentry QuestionBankEntries @relation(fields: [questionbankentryid], references: [id])

  @@map("question_references")
}

// Analysis of student responses given to questions.
model QuestionResponseAnalysis {
  id BigInt @id @default(autoincrement())
  hashcode String @default("") // sha1 hash of serialized qubaids_condition class. Unique for every combination of class name and property.
  whichtries String @default("")
  timemodified BigInt
  questionid BigInt
  variant BigInt?
  subqid String @default("")
  aid String?
  response String?
  credit Decimal

  Question Question @relation(fields: [questionid], references: [id])

  QuestionResponseCount QuestionResponseCount[]

  @@map("question_response_analysis")
}

// Count for each responses for each try at a question.
model QuestionResponseCount {
  id BigInt @id @default(autoincrement())
  analysisid BigInt
  try BigInt
  rcount BigInt

  Analysis QuestionResponseAnalysis @relation(fields: [analysisid], references: [id])

  @@map("question_response_count")
}

// Records where groups of questions are used.
model QuestionSetReferences {
  id BigInt @id @default(autoincrement())
  usingcontextid BigInt @default(0) // Context where question is used.
  component String? // Component (e.g. mod_quiz)
  questionarea String? // Depending on the component, which area the question is used in (e.g. slot for quiz).
  itemid BigInt? // Plugin specific id (e.g. slotid for quiz) where its used.
  questionscontextid BigInt @default(0) // Context questions come from.
  filtercondition String? // Filter expression in json format

  Usingcontext Context @relation(name: "question_set_references_usingcontextid", fields: [usingcontextid], references: [id])
  Questionscontext Context @relation(name: "question_set_references_questionscontextid", fields: [questionscontextid], references: [id])

  @@map("question_set_references")
}

// Statistics for individual questions used in an activity.
model QuestionStatistics {
  id BigInt @id @default(autoincrement())
  hashcode String @default("") // sha1 hash of serialized qubaids_condition class. Unique for every combination of class name and property.
  timemodified BigInt
  questionid BigInt
  slot BigInt? // The position in the quiz where this question appears
  subquestion Int
  variant BigInt?
  s BigInt @default(0)
  effectiveweight Decimal?
  negcovar Int @default(0)
  discriminationindex Decimal?
  discriminativeefficiency Decimal?
  sd Decimal?
  facility Decimal?
  subquestions String?
  maxmark Decimal?
  positions String? // positions in which this item appears. Only used for random questions.
  randomguessscore Decimal? // An estimate of the score a student would get by guessing randomly.

  Question Question @relation(fields: [questionid], references: [id])

  @@map("question_statistics")
}

// Options for True-False questions
model QuestionTruefalse {
  id BigInt @id @default(autoincrement())
  question BigInt @default(0) // Foreign key references question.id.
  trueanswer BigInt @default(0) // Foreign key references question_answers.id. The 'True' choice.
  falseanswer BigInt @default(0) // Foreign key references question_answers.id. The 'False' choice.

  Question Question @relation(fields: [question], references: [id])

  @@map("question_truefalse")
}

// This table's main purpose it to assign a unique id to each a
model QuestionUsages {
  id BigInt @id @default(autoincrement())
  contextid BigInt // Every question usage must be associated with some context.
  component String @default("") // The plugin this attempt belongs to, e.g. 'mod_quiz', 'block_questionoftheday', 'filter_embedquestion'.
  preferredbehaviour String @default("") // The archetypal behaviour that should be used for question attempts in this usage.

  Context Context @relation(fields: [contextid], references: [id])

  QuestionAttempts QuestionAttempts[]
  QuizAttempts QuizAttempts[]

  @@map("question_usages")
}

// A join table linking the different question version definiti
model QuestionVersions {
  id BigInt @id @default(autoincrement())
  questionbankentryid BigInt @default(0) // ID of the question bank entry this question version is part of.
  version BigInt @default(1) // Version number for the question where the first version is always 1.
  questionid BigInt @default(0) // The question ID.
  status String @default("ready") // If the question is ready, hidden or draft

  Questionbankentry QuestionBankEntries @relation(fields: [questionbankentryid], references: [id])
  Question Question @relation(fields: [questionid], references: [id])

  @@map("question_versions")
}

// The settings for each quiz.
model Quiz {
  id BigInt @id @default(autoincrement()) // Standard Moodle primary key.
  course BigInt @default(0) // Foreign key reference to the course this quiz is part of.
  name String @default("") // Quiz name.
  intro String // Quiz introduction text.
  introformat Int @default(0) // Quiz intro text format.
  timeopen BigInt @default(0) // The time when this quiz opens. (0 = no restriction.)
  timeclose BigInt @default(0) // The time when this quiz closes. (0 = no restriction.)
  timelimit BigInt @default(0) // The time limit for quiz attempts, in seconds.
  overduehandling String @default("autoabandon") // The method used to handle overdue attempts. 'autosubmit', 'graceperiod' or 'autoabandon'.
  graceperiod BigInt @default(0) // The amount of time (in seconds) after the time limit runs out during which attempts can still be submitted, if overduehandling is set to allow it.
  preferredbehaviour String @default("") // The behaviour to ask questions to use.
  canredoquestions Int @default(0) // Allows students to redo any completed question within a quiz attempt.
  attempts Int @default(0) // The maximum number of attempts a student is allowed.
  attemptonlast Int @default(0) // Whether subsequent attempts start from teh answer to the previous attempt (1) or start blank (0).
  grademethod Int @default(1) // One of the values QUIZ_GRADEHIGHEST, QUIZ_GRADEAVERAGE, QUIZ_ATTEMPTFIRST or QUIZ_ATTEMPTLAST.
  decimalpoints Int @default(2) // Number of decimal points to use when displaying grades.
  questiondecimalpoints Int @default(-1) // Number of decimal points to use when displaying question grades. (-1 means use decimalpoints.)
  reviewattempt Int @default(0) // Whether users are allowed to review their quiz attempts at various times. This is a bit field, decoded by the mod_quiz_display_options class. It is formed by ORing together the constants defined there.
  reviewcorrectness Int @default(0) // Whether users are allowed to review their quiz attempts at various times. A bit field, like reviewattempt.
  reviewmarks Int @default(0) // Whether users are allowed to review their quiz attempts at various times. A bit field, like reviewattempt.
  reviewspecificfeedback Int @default(0) // Whether users are allowed to review their quiz attempts at various times. A bit field, like reviewattempt.
  reviewgeneralfeedback Int @default(0) // Whether users are allowed to review their quiz attempts at various times. A bit field, like reviewattempt.
  reviewrightanswer Int @default(0) // Whether users are allowed to review their quiz attempts at various times. A bit field, like reviewattempt.
  reviewoverallfeedback Int @default(0) // Whether users are allowed to review their quiz attempts at various times. A bit field, like reviewattempt.
  questionsperpage BigInt @default(0) // How often to insert a page break when editing the quiz, or when shuffling the question order.
  navmethod String @default("free") // Any constraints on how the user is allowed to navigate around the quiz. Currently recognised values are 'free' and 'seq'.
  shuffleanswers Int @default(0) // Whether the parts of the question should be shuffled, in those question types that support it.
  sumgrades Decimal @default(0.0) // The total of all the question instance maxmarks.
  grade Decimal @default(0.0) // The total that the quiz overall grade is scaled to be out of.
  timecreated BigInt @default(0) // The time when the quiz was added to the course.
  timemodified BigInt @default(0) // Last modified time.
  password String @default("") // A password that the student must enter before starting or continuing a quiz attempt.
  subnet String @default("") // Used to restrict the IP addresses from which this quiz can be attempted. The format is as requried by the address_in_subnet function.
  browsersecurity String @default("") // Restriciton on the browser the student must use. E.g. 'securewindow'.
  delay1 BigInt @default(0) // Delay that must be left between the first and second attempt, in seconds.
  delay2 BigInt @default(0) // Delay that must be left between the second and subsequent attempt, in seconds.
  showuserpicture Int @default(0) // Option to show the user's picture during the attempt and on the review page.
  showblocks Int @default(0) // Whether blocks should be shown on the attempt.php and review.php pages.
  completionattemptsexhausted Boolean? @default(false)
  completionminattempts BigInt @default(0)
  allowofflineattempts Boolean? @default(false) // Whether to allow the quiz to be attempted offline in the mobile app

  QuizAttempts QuizAttempts[]
  QuizFeedback QuizFeedback[]
  QuizGrades QuizGrades[]
  QuizOverrides QuizOverrides[]
  QuizSections QuizSections[]
  QuizSlots QuizSlots[]
  QuizaccessSebQuizsettings QuizaccessSebQuizsettings[]

  @@map("quiz")
}

// Stores users attempts at quizzes.
model QuizAttempts {
  id BigInt @id @default(autoincrement()) // Standard Moodle primary key.
  quiz BigInt @default(0) // Foreign key reference to the quiz that was attempted.
  userid BigInt @default(0) // Foreign key reference to the user whose attempt this is.
  attempt Int @default(0) // Sequentially numbers this student's attempts at this quiz.
  uniqueid BigInt @default(0) // Foreign key reference to the question_usage that holds the details of the the question_attempts that make up this quiz attempt.
  layout String
  currentpage BigInt @default(0)
  preview Int @default(0)
  state String @default("inprogress") // The current state of the attempts. 'inprogress', 'overdue', 'finished' or 'abandoned'.
  timestart BigInt @default(0) // Time when the attempt was started.
  timefinish BigInt @default(0) // Time when the attempt was submitted. 0 if the attempt has not been submitted yet.
  timemodified BigInt @default(0) // Last modified time.
  timemodifiedoffline BigInt @default(0) // Last modified time via web services.
  timecheckstate BigInt? @default(0) // Next time quiz cron should check attempt for state changes. NULL means never check.
  sumgrades Decimal? // Total marks for this attempt.
  gradednotificationsenttime BigInt? // The timestamp when the 'graded' notification was sent.

  Quiz Quiz @relation(fields: [quiz], references: [id])
  User User @relation(fields: [userid], references: [id])
  Unique QuestionUsages @relation(fields: [uniqueid], references: [id])

  @@map("quiz_attempts")
}

// Feedback given to students based on which grade band their o
model QuizFeedback {
  id BigInt @id @default(autoincrement())
  quizid BigInt @default(0) // Foreign key references quiz.id.
  feedbacktext String // The feedback to show for a attempt where mingrade &lt;= attempt grade &lt; maxgrade. See function quiz_feedback_for_grade in mod/quiz/locallib.php.
  feedbacktextformat Int @default(0)
  mingrade Decimal @default(0.0) // The lower limit of this grade band. Inclusive.
  maxgrade Decimal @default(0.0) // The upper limit of this grade band. Exclusive.

  Quiz Quiz @relation(fields: [quizid], references: [id])

  @@map("quiz_feedback")
}

// Stores the overall grade for each user on the quiz, based on
model QuizGrades {
  id BigInt @id @default(autoincrement())
  quiz BigInt @default(0) // Foreign key references quiz.id.
  userid BigInt @default(0) // Foreign key references user.id.
  grade Decimal @default(0.0) // The overall grade from the quiz. Not affected by overrides in the gradebook.
  timemodified BigInt @default(0) // The last time this grade changed.

  Quiz Quiz @relation(fields: [quiz], references: [id])
  User User @relation(fields: [userid], references: [id])

  @@map("quiz_grades")
}

// The overrides to quiz settings on a per-user and per-group b
model QuizOverrides {
  id BigInt @id @default(autoincrement())
  quiz BigInt @default(0) // Foreign key references quiz.id
  groupid BigInt? // Foreign key references groups.id. Can be null if this is a per-user override.
  userid BigInt? // Foreign key references user.id. Can be null if this is a per-group override.
  timeopen BigInt? // Time at which students may start attempting this quiz. Can be null, in which case the quiz default is used.
  timeclose BigInt? // Time by which students must have completed their attempt. Can be null, in which case the quiz default is used.
  timelimit BigInt? // Time limit in seconds. Can be null, in which case the quiz default is used.
  attempts Int?
  password String? // Quiz password. Can be null, in which case the quiz default is used.

  Quiz Quiz @relation(fields: [quiz], references: [id])
  Group Groups? @relation(fields: [groupid], references: [id])
  User User? @relation(fields: [userid], references: [id])

  @@map("quiz_overrides")
}

// This table records which question attempts need regrading an
model QuizOverviewRegrades {
  id BigInt @id @default(autoincrement())
  questionusageid BigInt // Foreign key references question_usages.id, or equivalently quiz_attempt.uniqueid.
  slot BigInt // Foreign key, references question_attempts.slot
  newfraction Decimal? // The new fraction for this question_attempt after regrading.
  oldfraction Decimal? // The previous fraction for this question_attempt.
  regraded Int // set to 0 if element has just been regraded. Set to 1 if element has been marked as needing regrading.
  timemodified BigInt // Timestamp of when this row was last modified.

  Questionusage QuestionAttempts @relation(name: "quiz_overview_regrades_questionusageid", fields: [questionusageid], references: [questionusageid])
  Slot QuestionAttempts @relation(name: "quiz_overview_regrades_slot", fields: [slot], references: [slot])

  @@map("quiz_overview_regrades")
}

// Lists all the installed quiz reports and their display order
model QuizReports {
  id BigInt @id @default(autoincrement())
  name String? // name of the report, same as the directory name
  displayorder BigInt // display order for report tabs
  capability String? // Capability required to see this report. May be blank which means use the default of mod/quiz:viewreport. This is used when deciding which tabs to render.

  @@map("quiz_reports")
}

// Stores sections of a quiz with section name (heading), from
model QuizSections {
  id BigInt @id @default(autoincrement())
  quizid BigInt // Foreign key references quiz.id.
  firstslot BigInt // Number of the first slot in the section. The section runs from here to the start of the next section, or the end of the quiz.
  heading String? // The text of the heading. May be an empty string/null. Multilang format.
  shufflequestions Int @default(0) // Whether the question order within this section should be shuffled for each attempt.

  Quiz Quiz @relation(fields: [quizid], references: [id])

  @@map("quiz_sections")
}

// Stores the question used in a quiz, with the order, and for
model QuizSlots {
  id BigInt @id @default(autoincrement())
  slot BigInt // Where this question comes in order in the list of questions in this quiz. Like question_attempts.slot.
  quizid BigInt @default(0) // Foreign key references quiz.id.
  page BigInt // The page number that this questions appears on. If the question in slot n appears on page p, then the question in slot n+1 must appear on page p or p+1. Well, except that when a quiz is being created, there may be empty pages, which would cause the page number to jump here.
  requireprevious Int @default(0) // Set to 1 when current question requires previous one to be answered first.
  maxmark Decimal @default(0.0) // How many marks this question contributes to quiz.sumgrades.

  Quiz Quiz @relation(fields: [quizid], references: [id])

  @@map("quiz_slots")
}

// table to cache results from analysis done in statistics repo
model QuizStatistics {
  id BigInt @id @default(autoincrement())
  hashcode String @default("") // sha1 hash of serialized qubaids_condition class. Unique for every combination of class name and property.
  whichattempts Int // bool used to indicate whether these stats are for all attempts or just for the first.
  timemodified BigInt
  firstattemptscount BigInt
  highestattemptscount BigInt
  lastattemptscount BigInt
  allattemptscount BigInt
  firstattemptsavg Decimal?
  highestattemptsavg Decimal?
  lastattemptsavg Decimal?
  allattemptsavg Decimal?
  median Decimal?
  standarddeviation Decimal?
  skewness Decimal?
  kurtosis Decimal?
  cic Decimal?
  errorratio Decimal?
  standarderror Decimal?

  @@map("quiz_statistics")
}

// Stores the quiz level Safe Exam Browser configuration.
model QuizaccessSebQuizsettings {
  id BigInt @id @default(autoincrement())
  quizid BigInt // Foreign key to quiz id.
  cmid BigInt // Foreign key to course module id.
  templateid BigInt // Foreign key to quizaccess_seb_template.id.
  requiresafeexambrowser Boolean // Bool whether to require SEB.
  showsebtaskbar Boolean? // Bool to show SEB task bar
  showwificontrol Boolean? // Bool to allow user to control networking.
  showreloadbutton Boolean? // Bool to show reload button.
  showtime Boolean? // Bool to show the clock.
  showkeyboardlayout Boolean? // Bool to show keyboard layout.
  allowuserquitseb Boolean? // Bool to show quit button.
  quitpassword String? // Quit password to exit SEB.
  linkquitseb String? // Link to exit SEB.
  userconfirmquit Boolean? // Bool whether confirm quit popup should appear.
  enableaudiocontrol Boolean? // Bool to show volume and audio controls.
  muteonstartup Boolean? // Bool whether browser starts muted.
  allowspellchecking Boolean? // Bool whether spell checking will happen in SEB.
  allowreloadinexam Boolean? // Bool whether user can reload.
  activateurlfiltering Boolean? // Bool whether URLs will be filtered.
  filterembeddedcontent Boolean? // Bool wither embedded content will be filtered
  expressionsallowed String? // Comma or newline separated list of allowed expressions
  regexallowed String? // Regex of allowed URLs
  expressionsblocked String? // Comma or newline separated list of blocked expressions
  regexblocked String? // Regex of blocked URLs
  allowedbrowserexamkeys String? // List of allowed browser exam keys.
  showsebdownloadlink Boolean? // Bool whether SEB download link should appear
  usermodified BigInt @default(0)
  timecreated BigInt @default(0)
  timemodified BigInt @default(0)

  Quiz Quiz @relation(fields: [quizid], references: [id])
  Cm CourseModules @relation(fields: [cmid], references: [id])
  Template QuizaccessSebTemplate @relation(fields: [templateid], references: [id])
  Usermodified User @relation(fields: [usermodified], references: [id])

  @@map("quizaccess_seb_quizsettings")
}

// Templates for Safe Exam Browser configuration.
model QuizaccessSebTemplate {
  id BigInt @id @default(autoincrement())
  name String @default("") // Name of the template
  description String
  content String // Content of the template
  enabled Boolean
  sortorder BigInt
  usermodified BigInt @default(0)
  timecreated BigInt @default(0)
  timemodified BigInt @default(0)

  Usermodified User @relation(fields: [usermodified], references: [id])

  QuizaccessSebQuizsettings QuizaccessSebQuizsettings[]

  @@map("quizaccess_seb_template")
}

// moodle ratings
model Rating {
  id BigInt @id @default(autoincrement())
  contextid BigInt
  component String @default("")
  ratingarea String @default("")
  itemid BigInt
  scaleid BigInt
  rating BigInt
  userid BigInt
  timecreated BigInt
  timemodified BigInt

  Context Context @relation(fields: [contextid], references: [id])
  Scale Scale @relation(fields: [scaleid], references: [id])
  User User @relation(fields: [userid], references: [id])

  @@map("rating")
}

// hub where the site is registered on with their associated to
model RegistrationHubs {
  id BigInt @id @default(autoincrement())
  token String @default("") // the token to communicate with the hub by web service
  hubname String @default("")
  huburl String @default("")
  confirmed Boolean @default(false)
  secret String? // the unique site identifier for this hub
  timemodified BigInt @default(0)

  @@map("registration_hubs")
}

// Defines report audience
model ReportbuilderAudience {
  id BigInt @id @default(autoincrement())
  reportid BigInt
  heading String?
  classname String @default("")
  configdata String
  usercreated BigInt @default(0)
  usermodified BigInt @default(0)
  timecreated BigInt @default(0)
  timemodified BigInt @default(0)

  Report ReportbuilderReport @relation(fields: [reportid], references: [id])
  Usercreated User @relation(name: "reportbuilder_audience_usercreated", fields: [usercreated], references: [id])
  Usermodified User @relation(name: "reportbuilder_audience_usermodified", fields: [usermodified], references: [id])

  @@map("reportbuilder_audience")
}

// Table to represent a report column
model ReportbuilderColumn {
  id BigInt @id @default(autoincrement())
  reportid BigInt @default(0)
  uniqueidentifier String @default("")
  aggregation String?
  heading String?
  columnorder BigInt
  sortenabled Boolean @default(false)
  sortdirection Boolean
  sortorder BigInt?
  usercreated BigInt @default(0)
  usermodified BigInt @default(0)
  timecreated BigInt @default(0)
  timemodified BigInt @default(0)

  Report ReportbuilderReport @relation(fields: [reportid], references: [id])
  Usercreated User @relation(name: "reportbuilder_column_usercreated", fields: [usercreated], references: [id])
  Usermodified User @relation(name: "reportbuilder_column_usermodified", fields: [usermodified], references: [id])

  @@map("reportbuilder_column")
}

// Table to represent a report filter/condition
model ReportbuilderFilter {
  id BigInt @id @default(autoincrement())
  reportid BigInt @default(0)
  uniqueidentifier String @default("")
  heading String?
  iscondition Boolean @default(false)
  filterorder BigInt
  usercreated BigInt @default(0)
  usermodified BigInt @default(0)
  timecreated BigInt @default(0)
  timemodified BigInt @default(0)

  Report ReportbuilderReport @relation(fields: [reportid], references: [id])
  Usercreated User @relation(name: "reportbuilder_filter_usercreated", fields: [usercreated], references: [id])
  Usermodified User @relation(name: "reportbuilder_filter_usermodified", fields: [usermodified], references: [id])

  @@map("reportbuilder_filter")
}

// Table to represent a report
model ReportbuilderReport {
  id BigInt @id @default(autoincrement())
  name String?
  source String @default("")
  type Int @default(0)
  uniquerows Boolean @default(false)
  conditiondata String?
  settingsdata String?
  contextid BigInt
  component String @default("")
  area String @default("")
  itemid BigInt @default(0)
  usercreated BigInt @default(0)
  usermodified BigInt @default(0)
  timecreated BigInt @default(0)
  timemodified BigInt @default(0)

  Context Context @relation(fields: [contextid], references: [id])
  Usercreated User @relation(name: "reportbuilder_report_usercreated", fields: [usercreated], references: [id])
  Usermodified User @relation(name: "reportbuilder_report_usermodified", fields: [usermodified], references: [id])

  ReportbuilderAudience ReportbuilderAudience[]
  ReportbuilderColumn ReportbuilderColumn[]
  ReportbuilderFilter ReportbuilderFilter[]
  ReportbuilderSchedule ReportbuilderSchedule[]

  @@map("reportbuilder_report")
}

// Table to represent a report schedule
model ReportbuilderSchedule {
  id BigInt @id @default(autoincrement())
  reportid BigInt @default(0)
  name String @default("")
  enabled Boolean @default(true)
  audiences String
  format String @default("")
  subject String @default("")
  message String
  messageformat BigInt
  userviewas BigInt @default(0)
  timescheduled BigInt @default(0)
  recurrence BigInt @default(0)
  reportempty BigInt @default(0)
  timelastsent BigInt @default(0)
  timenextsend BigInt @default(0)
  usercreated BigInt @default(0)
  usermodified BigInt @default(0)
  timecreated BigInt @default(0)
  timemodified BigInt @default(0)

  Report ReportbuilderReport @relation(fields: [reportid], references: [id])
  Userviewas User @relation(name: "reportbuilder_schedule_userviewas", fields: [userviewas], references: [id])
  Usercreated User @relation(name: "reportbuilder_schedule_usercreated", fields: [usercreated], references: [id])
  Usermodified User @relation(name: "reportbuilder_schedule_usermodified", fields: [usermodified], references: [id])

  @@map("reportbuilder_schedule")
}

// This table contains one entry for every configured external
model Repository {
  id BigInt @id @default(autoincrement())
  type String @default("")
  visible Boolean? @default(true)
  sortorder BigInt @default(0)

  @@map("repository")
}

// The config for intances
model RepositoryInstanceConfig {
  id BigInt @id @default(autoincrement())
  instanceid BigInt
  name String @default("")
  value String?

  Instance RepositoryInstances @relation(fields: [instanceid], references: [id])

  @@map("repository_instance_config")
}

// This table contains one entry for every configured external
model RepositoryInstances {
  id BigInt @id @default(autoincrement())
  name String @default("")
  typeid BigInt
  userid BigInt @default(0)
  contextid BigInt
  username String?
  password String?
  timecreated BigInt?
  timemodified BigInt?
  readonly Boolean @default(false)

  User User @relation(fields: [userid], references: [id])
  Context Context @relation(fields: [contextid], references: [id])

  FilesReference FilesReference[]
  RepositoryInstanceConfig RepositoryInstanceConfig[]

  @@map("repository_instances")
}

// List of temporary access grants.
model RepositoryOnedriveAccess {
  id BigInt @id @default(autoincrement())
  timemodified BigInt
  timecreated BigInt
  usermodified BigInt
  permissionid String @default("") // The permission id in OneDrive.
  itemid String @default("") // The item id in OneDrive.

  Usermodified User @relation(fields: [usermodified], references: [id])

  @@map("repository_onedrive_access")
}

// Each record is one resource and its config data
model Resource {
  id BigInt @id @default(autoincrement())
  course BigInt @default(0)
  name String @default("")
  intro String?
  introformat Int @default(0)
  tobemigrated Int @default(0)
  legacyfiles Int @default(0)
  legacyfileslast BigInt?
  display Int @default(0)
  displayoptions String?
  filterfiles Int @default(0)
  revision BigInt @default(0) // incremented when after each file changes, solves browser caching issues
  timemodified BigInt @default(0)

  Course Course @relation(fields: [course], references: [id])

  EnrolLtiResourceLink EnrolLtiResourceLink[]

  @@map("resource")
}

// backup of all old resource instances from 1.9
model ResourceOld {
  id BigInt @id @default(autoincrement())
  course BigInt @default(0)
  name String @default("")
  type String @default("")
  reference String @default("")
  intro String?
  introformat Int @default(0)
  alltext String
  popup String
  options String @default("")
  timemodified BigInt @default(0)
  oldid BigInt
  cmid BigInt?
  newmodule String?
  newid BigInt?
  migrated BigInt @default(0)

  @@map("resource_old")
}

// moodle roles
model Role {
  id BigInt @id @default(autoincrement())
  name String @default("") // Empty names are automatically localised
  shortname String @default("")
  description String // Empty descriptions may be automatically localised
  sortorder BigInt @default(0)
  archetype String @default("") // Role archetype is used during install and role reset, marks admin role and helps in site settings

  BadgeManualAward BadgeManualAward[]
  Enrol Enrol[]
  EnrolFlatfile EnrolFlatfile[]
  MnetserviceEnrolCourses MnetserviceEnrolCourses[]
  RoleAllowAssignByRole RoleAllowAssign[] @relation(name: "role_allow_assign_roleid")
  RoleAllowAssignByAllowassign RoleAllowAssign[] @relation(name: "role_allow_assign_allowassign")
  RoleAllowOverrideByRole RoleAllowOverride[] @relation(name: "role_allow_override_roleid")
  RoleAllowOverrideByAllowoverride RoleAllowOverride[] @relation(name: "role_allow_override_allowoverride")
  RoleAllowSwitchByRole RoleAllowSwitch[] @relation(name: "role_allow_switch_roleid")
  RoleAllowSwitchByAllowswitch RoleAllowSwitch[] @relation(name: "role_allow_switch_allowswitch")
  RoleAllowViewByRole RoleAllowView[] @relation(name: "role_allow_view_roleid")
  RoleAllowViewByAllowview RoleAllowView[] @relation(name: "role_allow_view_allowview")
  RoleAssignments RoleAssignments[]
  RoleCapabilities RoleCapabilities[]
  RoleContextLevels RoleContextLevels[]
  RoleNames RoleNames[]
  StatsDaily StatsDaily[]
  StatsMonthly StatsMonthly[]
  StatsUserDaily StatsUserDaily[]
  StatsUserMonthly StatsUserMonthly[]
  StatsUserWeekly StatsUserWeekly[]
  StatsWeekly StatsWeekly[]
  ToolCohortroles ToolCohortroles[]
  ToolDataprivacyPurposerole ToolDataprivacyPurposerole[]

  @@map("role")
}

// this defines what role can assign what role
model RoleAllowAssign {
  id BigInt @id @default(autoincrement())
  roleid BigInt @default(0)
  allowassign BigInt @default(0)

  Role Role @relation(name: "role_allow_assign_roleid", fields: [roleid], references: [id])
  Allowassign Role @relation(name: "role_allow_assign_allowassign", fields: [allowassign], references: [id])

  @@map("role_allow_assign")
}

// this defines what role can override what role
model RoleAllowOverride {
  id BigInt @id @default(autoincrement())
  roleid BigInt @default(0)
  allowoverride BigInt @default(0)

  Role Role @relation(name: "role_allow_override_roleid", fields: [roleid], references: [id])
  Allowoverride Role @relation(name: "role_allow_override_allowoverride", fields: [allowoverride], references: [id])

  @@map("role_allow_override")
}

// This table stores which which other roles a user is allowed
model RoleAllowSwitch {
  id BigInt @id @default(autoincrement())
  roleid BigInt // The role the user has.
  allowswitch BigInt // The id of a role that the user is allowed to switch to as a result of having this role.

  Role Role @relation(name: "role_allow_switch_roleid", fields: [roleid], references: [id])
  Allowswitch Role @relation(name: "role_allow_switch_allowswitch", fields: [allowswitch], references: [id])

  @@map("role_allow_switch")
}

// This table stores which which other roles a user is allowed
model RoleAllowView {
  id BigInt @id @default(autoincrement())
  roleid BigInt // The role the user has.
  allowview BigInt // The id of a role that the user is allowed to view to as a result of having this role.

  Role Role @relation(name: "role_allow_view_roleid", fields: [roleid], references: [id])
  Allowview Role @relation(name: "role_allow_view_allowview", fields: [allowview], references: [id])

  @@map("role_allow_view")
}

// assigning roles in different context
model RoleAssignments {
  id BigInt @id @default(autoincrement())
  roleid BigInt @default(0)
  contextid BigInt @default(0)
  userid BigInt @default(0)
  timemodified BigInt @default(0)
  modifierid BigInt @default(0)
  component String @default("") // plugin responsible responsible for role assignment, empty when manually assigned
  itemid BigInt @default(0) // Id of enrolment/auth instance responsible for this role assignment
  sortorder BigInt @default(0)

  Role Role @relation(fields: [roleid], references: [id])
  Context Context @relation(fields: [contextid], references: [id])
  User User @relation(fields: [userid], references: [id])

  @@map("role_assignments")
}

// permission has to be signed, overriding a capability for a p
model RoleCapabilities {
  id BigInt @id @default(autoincrement())
  contextid BigInt @default(0)
  roleid BigInt @default(0)
  capability String @default("")
  permission BigInt @default(0)
  timemodified BigInt @default(0)
  modifierid BigInt @default(0)

  Context Context @relation(fields: [contextid], references: [id])
  Role Role @relation(fields: [roleid], references: [id])
  Capability Capabilities @relation(fields: [capability], references: [name])
  Modifier User @relation(fields: [modifierid], references: [id])

  @@map("role_capabilities")
}

// Lists which roles can be assigned at which context levels. T
model RoleContextLevels {
  id BigInt @id @default(autoincrement())
  roleid BigInt
  contextlevel BigInt

  Role Role @relation(fields: [roleid], references: [id])

  @@map("role_context_levels")
}

// role names in native strings
model RoleNames {
  id BigInt @id @default(autoincrement())
  roleid BigInt @default(0)
  contextid BigInt @default(0)
  name String @default("")

  Role Role @relation(fields: [roleid], references: [id])
  Context Context @relation(fields: [contextid], references: [id])

  @@map("role_names")
}

// Defines grading scales
model Scale {
  id BigInt @id @default(autoincrement())
  courseid BigInt @default(0)
  userid BigInt @default(0)
  name String @default("")
  scale String
  description String
  descriptionformat Int @default(0)
  timemodified BigInt @default(0)

  Course Course @relation(fields: [courseid], references: [id])
  User User @relation(fields: [userid], references: [id])

  Competency Competency[]
  CompetencyFramework CompetencyFramework[]
  GradeGrades GradeGrades[]
  GradeGradesHistory GradeGradesHistory[]
  GradeItems GradeItems[]
  GradeItemsHistory GradeItemsHistory[]
  GradeOutcomes GradeOutcomes[]
  GradeOutcomesHistory GradeOutcomesHistory[]
  Rating Rating[]
  ScaleHistory ScaleHistory[]

  @@map("scale")
}

// History table
model ScaleHistory {
  id BigInt @id @default(autoincrement())
  action BigInt @default(0) // created/modified/deleted constants
  oldid BigInt
  source String? // What caused the modification? manual/module/import/...
  timemodified BigInt? // The last time this grade_item was modified
  loggeduser BigInt? // the userid of the person who last modified this outcome
  courseid BigInt @default(0)
  userid BigInt @default(0)
  name String @default("")
  scale String
  description String

  Old Scale @relation(fields: [oldid], references: [id])
  Loggeduser User? @relation(name: "scale_history_loggeduser", fields: [loggeduser], references: [id])
  Course Course @relation(fields: [courseid], references: [id])
  User User @relation(name: "scale_history_userid", fields: [userid], references: [id])

  @@map("scale_history")
}

// each table is one SCORM module and its configuration
model Scorm {
  id BigInt @id @default(autoincrement())
  course BigInt @default(0)
  name String @default("")
  scormtype String @default("local") // local, external or repository
  reference String @default("")
  intro String
  introformat Int @default(0)
  version String @default("")
  maxgrade Float @default(0.0)
  grademethod Int @default(0)
  whatgrade BigInt @default(0)
  maxattempt BigInt @default(1)
  forcecompleted Boolean @default(false)
  forcenewattempt Boolean @default(false)
  lastattemptlock Boolean @default(false)
  masteryoverride Boolean @default(true)
  displayattemptstatus Boolean @default(true)
  displaycoursestructure Boolean @default(false)
  updatefreq Boolean @default(false) // Define when the package must be automatically update
  sha1hash String? // package content or ext path hash
  md5hash String @default("") // MD5 Hash of package file
  revision BigInt @default(0) // revison number
  launch BigInt @default(0)
  skipview Boolean @default(true)
  hidebrowse Boolean @default(false)
  hidetoc Boolean @default(false)
  nav Boolean @default(true)
  navpositionleft BigInt? @default(-100)
  navpositiontop BigInt? @default(-100)
  auto Boolean @default(false)
  popup Boolean @default(false)
  options String @default("")
  width BigInt @default(100)
  height BigInt @default(600)
  timeopen BigInt @default(0)
  timeclose BigInt @default(0)
  timemodified BigInt @default(0)
  completionstatusrequired Boolean?
  completionscorerequired BigInt?
  completionstatusallscos Boolean?
  autocommit Boolean @default(false)

  ScormAiccSession ScormAiccSession[]
  ScormScoes ScormScoes[]
  ScormScoesTrack ScormScoesTrack[]

  @@map("scorm")
}

// Used by AICC HACP to store session information
model ScormAiccSession {
  id BigInt @id @default(autoincrement())
  userid BigInt @default(0) // id from user table
  scormid BigInt @default(0) // id from scorm table
  hacpsession String @default("") // sessionid used to authenticate AICC HACP communication
  scoid BigInt? @default(0) // id from scorm_scoes table
  scormmode String?
  scormstatus String?
  attempt BigInt?
  lessonstatus String?
  sessiontime String?
  timecreated BigInt @default(0) // time this session was created
  timemodified BigInt @default(0) // time this session was last used

  User User @relation(fields: [userid], references: [id])
  Scorm Scorm @relation(fields: [scormid], references: [id])

  @@map("scorm_aicc_session")
}

// each SCO part of the SCORM module
model ScormScoes {
  id BigInt @id @default(autoincrement())
  scorm BigInt @default(0)
  manifest String @default("")
  organization String @default("")
  parent String @default("")
  identifier String @default("")
  launch String
  scormtype String @default("")
  title String @default("")
  sortorder BigInt @default(0) // order of scoes

  Scorm Scorm @relation(fields: [scorm], references: [id])

  ScormScoesData ScormScoesData[]
  ScormScoesTrack ScormScoesTrack[]
  ScormSeqMapinfo ScormSeqMapinfo[]
  ScormSeqObjective ScormSeqObjective[]
  ScormSeqRolluprule ScormSeqRolluprule[]
  ScormSeqRolluprulecond ScormSeqRolluprulecond[]
  ScormSeqRulecond ScormSeqRulecond[]
  ScormSeqRuleconds ScormSeqRuleconds[]

  @@map("scorm_scoes")
}

// Contains variable data get from packages
model ScormScoesData {
  id BigInt @id @default(autoincrement())
  scoid BigInt @default(0)
  name String @default("")
  value String

  Sco ScormScoes @relation(fields: [scoid], references: [id])

  @@map("scorm_scoes_data")
}

// to track SCOes
model ScormScoesTrack {
  id BigInt @id @default(autoincrement())
  userid BigInt @default(0)
  scormid BigInt @default(0)
  scoid BigInt @default(0)
  attempt BigInt @default(1)
  element String @default("")
  value String
  timemodified BigInt @default(0)

  User User @relation(fields: [userid], references: [id])
  Scorm Scorm @relation(fields: [scormid], references: [id])
  Sco ScormScoes @relation(fields: [scoid], references: [id])

  @@map("scorm_scoes_track")
}

// SCORM2004 objective mapinfo description
model ScormSeqMapinfo {
  id BigInt @id @default(autoincrement())
  scoid BigInt @default(0)
  objectiveid BigInt @default(0)
  targetobjectiveid BigInt @default(0)
  readsatisfiedstatus Boolean @default(true)
  readnormalizedmeasure Boolean @default(true)
  writesatisfiedstatus Boolean @default(false)
  writenormalizedmeasure Boolean @default(false)

  Sco ScormScoes @relation(fields: [scoid], references: [id])
  Objective ScormSeqObjective @relation(fields: [objectiveid], references: [id])

  @@map("scorm_seq_mapinfo")
}

// SCORM2004 objective description
model ScormSeqObjective {
  id BigInt @id @default(autoincrement())
  scoid BigInt @default(0)
  primaryobj Boolean @default(false)
  objectiveid String @default("")
  satisfiedbymeasure Boolean @default(true)
  minnormalizedmeasure Float @default(0.0)

  Sco ScormScoes @relation(fields: [scoid], references: [id])

  ScormSeqMapinfo ScormSeqMapinfo[]

  @@map("scorm_seq_objective")
}

// SCORM2004 sequencing rule
model ScormSeqRolluprule {
  id BigInt @id @default(autoincrement())
  scoid BigInt @default(0)
  childactivityset String @default("")
  minimumcount BigInt @default(0)
  minimumpercent Float @default(0.0)
  conditioncombination String @default("all")
  action String @default("")

  Sco ScormScoes @relation(fields: [scoid], references: [id])

  ScormSeqRolluprulecond ScormSeqRolluprulecond[]

  @@map("scorm_seq_rolluprule")
}

// SCORM2004 sequencing rule
model ScormSeqRolluprulecond {
  id BigInt @id @default(autoincrement())
  scoid BigInt @default(0)
  rollupruleid BigInt @default(0)
  operator String @default("noOp")
  cond String @default("")

  Sco ScormScoes @relation(fields: [scoid], references: [id])
  Rolluprule ScormSeqRolluprule @relation(fields: [rollupruleid], references: [id])

  @@map("scorm_seq_rolluprulecond")
}

// SCORM2004 rule condition
model ScormSeqRulecond {
  id BigInt @id @default(autoincrement())
  scoid BigInt @default(0)
  ruleconditionsid BigInt @default(0)
  refrencedobjective String @default("")
  measurethreshold Float @default(0.0)
  operator String @default("noOp")
  cond String @default("always")

  Sco ScormScoes @relation(fields: [scoid], references: [id])
  Ruleconditions ScormSeqRuleconds @relation(fields: [ruleconditionsid], references: [id])

  @@map("scorm_seq_rulecond")
}

// SCORM2004 rule conditions
model ScormSeqRuleconds {
  id BigInt @id @default(autoincrement())
  scoid BigInt @default(0)
  conditioncombination String @default("all")
  ruletype Int @default(0)
  action String @default("")

  Sco ScormScoes @relation(fields: [scoid], references: [id])

  ScormSeqRulecond ScormSeqRulecond[]

  @@map("scorm_seq_ruleconds")
}

// Records requests for (re)indexing of specific contexts. Entr
model SearchIndexRequests {
  id BigInt @id @default(autoincrement())
  contextid BigInt // Context ID that has been requested for reindexing.
  searcharea String @default("") // Set (e.g. 'forum-post') if a specific area is to be reindexed. Blank indicates all areas.
  timerequested BigInt // Time at which this index update was requested.
  partialarea String @default("") // If processing of this context partially completed, set to the area that needs processing next. Blank indicates not processed yet.
  partialtime BigInt // If processing partially completed, set to the timestamp within the next area where processing should start. 0 indicates not processed yet.
  indexpriority BigInt // Priority value so that important requests can be dealt with first; higher numbers are processed first

  Context Context @relation(fields: [contextid], references: [id])

  @@map("search_index_requests")
}

// search_simpledb table containing the index data.
model SearchSimpledbIndex {
  id BigInt @id @default(autoincrement())
  docid String @default("")
  itemid BigInt
  title String?
  content String?
  contextid BigInt
  areaid String @default("")
  type Boolean
  courseid BigInt
  owneruserid BigInt?
  modified BigInt
  userid BigInt?
  description1 String?
  description2 String?

  Context Context @relation(fields: [contextid], references: [id])
  Course Course @relation(fields: [courseid], references: [id])
  User User? @relation(fields: [userid], references: [id])

  @@map("search_simpledb_index")
}

// Database based session storage - now recommended
model Sessions {
  id BigInt @id @default(autoincrement())
  state BigInt @default(0) // 0 means normal session
  sid String @default("") // Session id
  userid BigInt
  sessdata String? // session content
  timecreated BigInt
  timemodified BigInt
  firstip String?
  lastip String?

  User User @relation(fields: [userid], references: [id])

  @@map("sessions")
}

// to accumulate daily stats
model StatsDaily {
  id BigInt @id @default(autoincrement())
  courseid BigInt @default(0)
  timeend BigInt @default(0)
  roleid BigInt @default(0) // id of role for the aggregates
  stattype String @default("activity") // type of stat
  stat1 BigInt @default(0) // stat1. usually used for reads
  stat2 BigInt @default(0) // stat2. usually used for writes.

  Course Course @relation(fields: [courseid], references: [id])
  Role Role @relation(fields: [roleid], references: [id])

  @@map("stats_daily")
}

// To accumulate monthly stats
model StatsMonthly {
  id BigInt @id @default(autoincrement())
  courseid BigInt @default(0)
  timeend BigInt @default(0)
  roleid BigInt @default(0) // id of role for the aggregates
  stattype String @default("activity") // type of stat
  stat1 BigInt @default(0) // stat1. usually used for reads
  stat2 BigInt @default(0) // stat2. usually used for writes.

  Course Course @relation(fields: [courseid], references: [id])
  Role Role @relation(fields: [roleid], references: [id])

  @@map("stats_monthly")
}

// To accumulate daily stats per course/user
model StatsUserDaily {
  id BigInt @id @default(autoincrement())
  courseid BigInt @default(0)
  userid BigInt @default(0)
  roleid BigInt @default(0)
  timeend BigInt @default(0)
  statsreads BigInt @default(0)
  statswrites BigInt @default(0)
  stattype String @default("")

  Course Course @relation(fields: [courseid], references: [id])
  User User @relation(fields: [userid], references: [id])
  Role Role @relation(fields: [roleid], references: [id])

  @@map("stats_user_daily")
}

// To accumulate monthly stats per course/user
model StatsUserMonthly {
  id BigInt @id @default(autoincrement())
  courseid BigInt @default(0)
  userid BigInt @default(0)
  roleid BigInt @default(0)
  timeend BigInt @default(0)
  statsreads BigInt @default(0)
  statswrites BigInt @default(0)
  stattype String @default("")

  Course Course @relation(fields: [courseid], references: [id])
  User User @relation(fields: [userid], references: [id])
  Role Role @relation(fields: [roleid], references: [id])

  @@map("stats_user_monthly")
}

// To accumulate weekly stats per course/user
model StatsUserWeekly {
  id BigInt @id @default(autoincrement())
  courseid BigInt @default(0)
  userid BigInt @default(0)
  roleid BigInt @default(0)
  timeend BigInt @default(0)
  statsreads BigInt @default(0)
  statswrites BigInt @default(0)
  stattype String @default("")

  Course Course @relation(fields: [courseid], references: [id])
  User User @relation(fields: [userid], references: [id])
  Role Role @relation(fields: [roleid], references: [id])

  @@map("stats_user_weekly")
}

// To accumulate weekly stats
model StatsWeekly {
  id BigInt @id @default(autoincrement())
  courseid BigInt @default(0)
  timeend BigInt @default(0)
  roleid BigInt @default(0) // id of role for the aggregates
  stattype String @default("activity") // type of stat
  stat1 BigInt @default(0) // stat1. usually used for reads
  stat2 BigInt @default(0) // stat2. usually used for writes.

  Course Course @relation(fields: [courseid], references: [id])
  Role Role @relation(fields: [roleid], references: [id])

  @@map("stats_weekly")
}

// Each record is one SURVEY module with its configuration
model Survey {
  id BigInt @id @default(autoincrement())
  course BigInt @default(0)
  template BigInt @default(0)
  days Int @default(0)
  timecreated BigInt @default(0)
  timemodified BigInt @default(0)
  name String @default("")
  intro String
  introformat Int @default(0) // intro text field format
  questions String @default("")
  completionsubmit Boolean @default(false) // If this field is set to 1, then the activity will be automatically marked as 'complete' once the user submits the survey.

  SurveyAnalysis SurveyAnalysis[]
  SurveyAnswers SurveyAnswers[]

  @@map("survey")
}

// text about each survey submission
model SurveyAnalysis {
  id BigInt @id @default(autoincrement())
  survey BigInt @default(0)
  userid BigInt @default(0)
  notes String

  Survey Survey @relation(fields: [survey], references: [id])
  User User @relation(fields: [userid], references: [id])

  @@map("survey_analysis")
}

// the answers to each questions filled by the users
model SurveyAnswers {
  id BigInt @id @default(autoincrement())
  userid BigInt @default(0)
  survey BigInt @default(0)
  question BigInt @default(0)
  time BigInt @default(0)
  answer1 String
  answer2 String

  User User @relation(fields: [userid], references: [id])
  Survey Survey @relation(fields: [survey], references: [id])
  Question SurveyQuestions @relation(fields: [question], references: [id])

  @@map("survey_answers")
}

// the questions conforming one survey
model SurveyQuestions {
  id BigInt @id @default(autoincrement())
  text String @default("")
  shorttext String @default("")
  multi String @default("")
  intro String @default("")
  type Int @default(0)
  options String?

  SurveyAnswers SurveyAnswers[]

  @@map("survey_questions")
}

// Tag table - this generic table will replace the old "tags" t
model Tag {
  id BigInt @id @default(autoincrement())
  userid BigInt
  tagcollid BigInt
  name String @default("")
  rawname String @default("") // The raw, unnormalised name for the tag as entered by users
  isstandard Boolean @default(false) // Whether this tag is standard
  description String?
  descriptionformat Int @default(0)
  flag Int? @default(0) // a tag can be 'flagged' as inappropriate
  timemodified BigInt?

  User User @relation(fields: [userid], references: [id])
  Tagcoll TagColl @relation(fields: [tagcollid], references: [id])

  TagCorrelation TagCorrelation[]
  TagInstance TagInstance[]

  @@map("tag")
}

// Defines various tag areas, one area is identified by compone
model TagArea {
  id BigInt @id @default(autoincrement())
  component String @default("")
  itemtype String @default("")
  enabled Boolean @default(true)
  tagcollid BigInt
  callback String?
  callbackfile String?
  showstandard Boolean @default(false)
  multiplecontexts Boolean @default(false) // Whether the tag area allows tag instances to be created in multiple contexts.

  Tagcoll TagColl @relation(fields: [tagcollid], references: [id])

  @@map("tag_area")
}

// Defines different set of tags
model TagColl {
  id BigInt @id @default(autoincrement())
  name String?
  isdefault Int @default(0)
  component String?
  sortorder Int @default(0)
  searchable Int @default(1) // Whether the tag collection is searchable
  customurl String? // Custom URL for the tag page instead of /tag/index.php

  Tag Tag[]
  TagArea TagArea[]

  @@map("tag_coll")
}

// The rationale for the 'tag_correlation' table is performance
model TagCorrelation {
  id BigInt @id @default(autoincrement())
  tagid BigInt
  correlatedtags String

  Tag Tag @relation(fields: [tagid], references: [id])

  @@map("tag_correlation")
}

// tag_instance table holds the information of associations bet
model TagInstance {
  id BigInt @id @default(autoincrement())
  tagid BigInt
  component String @default("") // Defines the Moodle component which the tag was added to
  itemtype String @default("")
  itemid BigInt
  contextid BigInt? // The context id of the item that was tagged
  tiuserid BigInt @default(0)
  ordering BigInt? // Maintains the order of the tag instances of an item
  timecreated BigInt @default(0)
  timemodified BigInt @default(0) // timemodified

  Tag Tag @relation(fields: [tagid], references: [id])
  Context Context? @relation(fields: [contextid], references: [id])

  @@map("tag_instance")
}

// List of adhoc tasks waiting to run.
model TaskAdhoc {
  id BigInt @id @default(autoincrement())
  component String @default("") // The component that triggered this adhoc task.
  classname String @default("") // The name of the class extending adhoc_task to run when this task is executed.
  nextruntime BigInt
  faildelay BigInt?
  customdata String? // Custom data to be passed to the adhoc task. Must be serialisable using json_encode()
  userid BigInt?
  blocking Int @default(0)
  timecreated BigInt @default(0) // Timestamp of adhoc task creation
  timestarted BigInt? // Time when the task was started
  hostname String? // Hostname where the task is running
  pid BigInt? // PHP process ID that is running the task

  User User? @relation(fields: [userid], references: [id])

  @@map("task_adhoc")
}

// The log table for all tasks
model TaskLog {
  id BigInt @id @default(autoincrement())
  type Int // The type of task. Scheduled task = 0; Adhoc task = 1.
  component String @default("") // The component that the task belongs to
  classname String @default("") // The class of the task being run
  userid BigInt // The userid that the task was configured to run as (Adhoc tasks only)
  timestart Decimal // The start time of the task
  timeend Decimal // The end time of the task
  dbreads BigInt // The number of DB reads performed during the task.
  dbwrites BigInt // The number of DB writes performed during the task.
  result Int // Whether the task was successful or not. 0 = pass; 1 = fail.
  output String
  hostname String? // Hostname where the task was executed
  pid BigInt? // PHP process ID that was running the task

  User User @relation(fields: [userid], references: [id])

  @@map("task_log")
}

// List of scheduled tasks to be run by cron.
model TaskScheduled {
  id BigInt @id @default(autoincrement())
  component String @default("") // The component this scheduled task belongs to.
  classname String @default("") // The class extending scheduled_task to be called when running this task.
  lastruntime BigInt?
  nextruntime BigInt?
  blocking Int @default(0) // Block the entire cron when this task is running.
  minute String @default("")
  hour String @default("")
  day String @default("")
  month String @default("")
  dayofweek String @default("")
  faildelay BigInt?
  customised Int @default(0) // Used on upgrades to prevent overwriting custom schedules.
  disabled Boolean @default(false) // 1 means do not run from cron
  timestarted BigInt? // Time when the task was started
  hostname String? // Hostname where the task is running
  pid BigInt? // PHP process ID that is running the task

  @@map("task_scheduled")
}

// Areas that have been checked for accessibility problems
model ToolBrickfieldAreas {
  id BigInt @id @default(autoincrement())
  type Int @default(0)
  contextid BigInt?
  component String?
  tablename String?
  fieldorarea String?
  itemid BigInt?
  filename String?
  reftable String?
  refid BigInt?
  cmid BigInt?
  courseid BigInt?
  categoryid BigInt?

  Context Context? @relation(fields: [contextid], references: [id])
  Cm CourseModules? @relation(fields: [cmid], references: [id])
  Course Course? @relation(fields: [courseid], references: [id])
  Category CourseCategories? @relation(fields: [categoryid], references: [id])

  ToolBrickfieldContent ToolBrickfieldContent[]

  @@map("tool_brickfield_areas")
}

// Contains accessibility summary information per activity.
model ToolBrickfieldCacheActs {
  id BigInt @id @default(autoincrement())
  courseid BigInt
  status Boolean?
  component String?
  totalactivities BigInt?
  failedactivities BigInt?
  passedactivities BigInt?
  errorcount BigInt?

  Course Course @relation(fields: [courseid], references: [id])

  @@map("tool_brickfield_cache_acts")
}

// Contains accessibility summary information per check.
model ToolBrickfieldCacheCheck {
  id BigInt @id @default(autoincrement())
  courseid BigInt
  status Boolean?
  checkid BigInt?
  checkcount BigInt?
  errorcount BigInt?

  Course Course @relation(fields: [courseid], references: [id])

  @@map("tool_brickfield_cache_check")
}

// Checks details
model ToolBrickfieldChecks {
  id BigInt @id @default(autoincrement())
  checktype String?
  shortname String?
  checkgroup BigInt? @default(0) // The group category identifier.
  status Int
  severity Int @default(0)

  ToolBrickfieldResults ToolBrickfieldResults[]

  @@map("tool_brickfield_checks")
}

// Content of an area at a particular time (recognised by a has
model ToolBrickfieldContent {
  id BigInt @id @default(autoincrement())
  areaid BigInt
  contenthash String @default("")
  iscurrent Boolean @default(false)
  status Int @default(0) // 0 - needs checking, -1 in progress, 1 checked
  timecreated BigInt
  timechecked BigInt?

  Area ToolBrickfieldAreas @relation(fields: [areaid], references: [id])

  ToolBrickfieldResults ToolBrickfieldResults[]

  @@map("tool_brickfield_content")
}

// Errors during the accessibility checks
model ToolBrickfieldErrors {
  id BigInt @id @default(autoincrement())
  resultid BigInt
  linenumber BigInt @default(0)
  errordata String?
  htmlcode String?

  Result ToolBrickfieldResults @relation(fields: [resultid], references: [id])

  @@map("tool_brickfield_errors")
}

// Queued records to initiate new processing of specific target
model ToolBrickfieldProcess {
  id BigInt @id @default(autoincrement())
  courseid BigInt
  item String? // The item for process action.
  contextid BigInt?
  innercontextid BigInt?
  timecreated BigInt?
  timecompleted BigInt?

  Course Course @relation(fields: [courseid], references: [id])
  Context Context? @relation(fields: [contextid], references: [id])

  @@map("tool_brickfield_process")
}

// Results of the accessibility checks
model ToolBrickfieldResults {
  id BigInt @id @default(autoincrement())
  contentid BigInt?
  checkid BigInt
  errorcount BigInt @default(0)

  Content ToolBrickfieldContent? @relation(fields: [contentid], references: [id])
  Check ToolBrickfieldChecks @relation(fields: [checkid], references: [id])

  ToolBrickfieldErrors ToolBrickfieldErrors[]

  @@map("tool_brickfield_results")
}

// Keeps the per course content analysis schedule.
model ToolBrickfieldSchedule {
  id BigInt @id @default(autoincrement())
  contextlevel BigInt @default(50) // The context level for this item. Defaults to CONTEXT_COURSE.
  instanceid BigInt // The id of the specific context instance. Course id for courses.
  contextid BigInt? // Id of the specific context record.
  status Int @default(0) // The schedule status for this item. 0 = not requested; 1 = requested; 2 = analyzed.
  timeanalyzed BigInt? @default(0) // The most recent time the item was analyzed by scheduler.
  timemodified BigInt? @default(0) // Time stamp of the last record update.

  Context Context? @relation(fields: [contextid], references: [id])

  @@map("tool_brickfield_schedule")
}

// Contains accessibility check results summary information.
model ToolBrickfieldSummary {
  id BigInt @id @default(autoincrement())
  courseid BigInt
  status Boolean?
  activities BigInt?
  activitiespassed BigInt?
  activitiesfailed BigInt?
  errorschecktype1 BigInt?
  errorschecktype2 BigInt?
  errorschecktype3 BigInt?
  errorschecktype4 BigInt?
  errorschecktype5 BigInt?
  errorschecktype6 BigInt?
  errorschecktype7 BigInt?
  failedchecktype1 BigInt?
  failedchecktype2 BigInt?
  failedchecktype3 BigInt?
  failedchecktype4 BigInt?
  failedchecktype5 BigInt?
  failedchecktype6 BigInt?
  failedchecktype7 BigInt?
  percentchecktype1 BigInt?
  percentchecktype2 BigInt?
  percentchecktype3 BigInt?
  percentchecktype4 BigInt?
  percentchecktype5 BigInt?
  percentchecktype6 BigInt?
  percentchecktype7 BigInt?

  Course Course @relation(fields: [courseid], references: [id])

  @@map("tool_brickfield_summary")
}

// Mapping of users to cohort role assignments.
model ToolCohortroles {
  id BigInt @id @default(autoincrement())
  cohortid BigInt // The cohort to sync
  roleid BigInt // The role to assign
  userid BigInt // The user to sync
  timecreated BigInt // The time this record was created
  timemodified BigInt // The time this record was modified.
  usermodified BigInt? // Who last modified this record?

  Cohort Cohort @relation(fields: [cohortid], references: [id])
  Role Role @relation(fields: [roleid], references: [id])
  User User @relation(fields: [userid], references: [id])

  @@map("tool_cohortroles")
}

// Contains the working checkout of all strings and their custo
model ToolCustomlang {
  id BigInt @id @default(autoincrement())
  lang String @default("") // The code of the language this string belongs to. Like en, cs or es
  componentid BigInt // The id of the component
  stringid String @default("") // The identifier of the string
  original String // English original of the string
  master String? // Master translation of the string as is distributed in the official lang pack, null if not translated
  local String? // Local customization of the string, null if not customized
  timemodified BigInt // The timestamp of when the original or master was recently modified
  timecustomized BigInt? // The timestamp of when the value of the local translation was recently modified, null if not customized yet
  outdated Int? @default(0) // Either the English original or the master translation changed and the customization may be outdated
  modified Int? @default(0) // Has the string been modified via the translator?

  Component ToolCustomlangComponents @relation(fields: [componentid], references: [id])

  @@map("tool_customlang")
}

// Contains the list of all installed plugins that provide thei
model ToolCustomlangComponents {
  id BigInt @id @default(autoincrement())
  name String @default("") // The normalized name of the plugin
  version String? // The checked out version of the plugin, null if the version is unknown

  ToolCustomlang ToolCustomlang[]

  @@map("tool_customlang_components")
}

// Data categories
model ToolDataprivacyCategory {
  id BigInt @id @default(autoincrement())
  name String @default("")
  description String?
  descriptionformat Boolean?
  usermodified BigInt
  timecreated BigInt
  timemodified BigInt

  ToolDataprivacyCtxinstance ToolDataprivacyCtxinstance[]
  ToolDataprivacyCtxlevel ToolDataprivacyCtxlevel[]

  @@map("tool_dataprivacy_category")
}

// Default comment for the table, please edit me
model ToolDataprivacyCtxexpired {
  id BigInt @id @default(autoincrement())
  contextid BigInt
  unexpiredroles String? // Roles which have explicitly not expired yet.
  expiredroles String? // Explicitly expires roles
  defaultexpired Boolean // The default retention period has passed.
  status Int @default(0)
  usermodified BigInt
  timecreated BigInt
  timemodified BigInt

  Context Context @relation(fields: [contextid], references: [id])

  @@map("tool_dataprivacy_ctxexpired")
}

// Default comment for the table, please edit me
model ToolDataprivacyCtxinstance {
  id BigInt @id @default(autoincrement())
  contextid BigInt
  purposeid BigInt?
  categoryid BigInt?
  usermodified BigInt
  timecreated BigInt
  timemodified BigInt

  Context Context @relation(fields: [contextid], references: [id])
  Purpose ToolDataprivacyPurpose? @relation(fields: [purposeid], references: [id])
  Category ToolDataprivacyCategory? @relation(fields: [categoryid], references: [id])

  @@map("tool_dataprivacy_ctxinstance")
}

// Default comment for the table, please edit me
model ToolDataprivacyCtxlevel {
  id BigInt @id @default(autoincrement())
  contextlevel Int
  purposeid BigInt?
  categoryid BigInt?
  usermodified BigInt
  timecreated BigInt
  timemodified BigInt

  Purpose ToolDataprivacyPurpose? @relation(fields: [purposeid], references: [id])
  Category ToolDataprivacyCategory? @relation(fields: [categoryid], references: [id])

  @@map("tool_dataprivacy_ctxlevel")
}

// Data purposes
model ToolDataprivacyPurpose {
  id BigInt @id @default(autoincrement())
  name String @default("")
  description String?
  descriptionformat Boolean?
  lawfulbases String // Comma-separated IDs matching records in tool_dataprivacy_lawfulbasis
  sensitivedatareasons String? // Comma-separated IDs matching records in tool_dataprivacy_sensitive
  retentionperiod String @default("")
  protected Boolean?
  usermodified BigInt
  timecreated BigInt
  timemodified BigInt

  ToolDataprivacyCtxinstance ToolDataprivacyCtxinstance[]
  ToolDataprivacyCtxlevel ToolDataprivacyCtxlevel[]
  ToolDataprivacyPurposerole ToolDataprivacyPurposerole[]

  @@map("tool_dataprivacy_purpose")
}

// Data purpose overrides for a specific role
model ToolDataprivacyPurposerole {
  id BigInt @id @default(autoincrement())
  purposeid BigInt
  roleid BigInt
  lawfulbases String?
  sensitivedatareasons String?
  retentionperiod String @default("")
  protected Boolean?
  usermodified BigInt
  timecreated BigInt
  timemodified BigInt

  Purpose ToolDataprivacyPurpose @relation(fields: [purposeid], references: [id])
  Role Role @relation(fields: [roleid], references: [id])

  @@map("tool_dataprivacy_purposerole")
}

// Table for data requests
model ToolDataprivacyRequest {
  id BigInt @id @default(autoincrement())
  type BigInt @default(0) // Data request type
  comments String? // More details about the request
  commentsformat Int @default(0)
  userid BigInt @default(0) // The user ID the request is being made for
  requestedby BigInt @default(0) // The user ID of the one making the request
  status Int @default(0) // The current status of the data request
  dpo BigInt? @default(0) // The user ID of the Data Protection Officer who is reviewing th request
  dpocomment String? // DPO's comments (e.g. reason for rejecting the request, etc.)
  dpocommentformat Int @default(0)
  systemapproved Int @default(0)
  usermodified BigInt @default(0) // The user who created/modified this request object
  timecreated BigInt @default(0) // The time this data request was created
  timemodified BigInt @default(0) // The last time this data request was updated
  creationmethod BigInt @default(0) // The type of the creation method of the data request

  User User @relation(name: "tool_dataprivacy_request_userid", fields: [userid], references: [id])
  Requestedby User @relation(name: "tool_dataprivacy_request_requestedby", fields: [requestedby], references: [id])
  Dpo User? @relation(name: "tool_dataprivacy_request_dpo", fields: [dpo], references: [id])
  Usermodified User @relation(name: "tool_dataprivacy_request_usermodified", fields: [usermodified], references: [id])

  @@map("tool_dataprivacy_request")
}

// A table that keeps a log of events related to subscriptions
model ToolMonitorEvents {
  id BigInt @id @default(autoincrement())
  eventname String @default("") // Event name
  contextid BigInt // Context id
  contextlevel BigInt // Context level
  contextinstanceid BigInt // Context instance id
  link String @default("") // Link to the event location
  courseid BigInt // course id
  timecreated BigInt // Time created

  Context Context @relation(name: "tool_monitor_events_contextid", fields: [contextid], references: [id])
  Contextinstance Context @relation(name: "tool_monitor_events_contextinstanceid", fields: [contextinstanceid], references: [id])
  Course Course @relation(fields: [courseid], references: [id])

  @@map("tool_monitor_events")
}

// Table to store history of message notifications sent
model ToolMonitorHistory {
  id BigInt @id @default(autoincrement())
  sid BigInt // Subscription id
  userid BigInt // User to whom this notification was sent
  timesent BigInt // Timestamp of when the message was sent.

  S ToolMonitorSubscriptions @relation(fields: [sid], references: [id])
  User User @relation(fields: [userid], references: [id])

  @@map("tool_monitor_history")
}

// Table to store rules
model ToolMonitorRules {
  id BigInt @id @default(autoincrement())
  description String? // Description of the rule
  descriptionformat Boolean // Description format
  name String @default("") // Name of the rule
  userid BigInt // Id of user who created the rule
  courseid BigInt // Id of course to which this rule belongs.
  plugin String @default("") // Frankenstlye name of the plguin
  eventname String @default("") // Fully qualified name of the event
  template String // Message template
  templateformat Boolean // Template format
  frequency Int // Frequency
  timewindow Int // Time window in seconds
  timemodified BigInt // Timestamp when this rule was last modified
  timecreated BigInt // Time stamp of when this rule was created

  User User @relation(fields: [userid], references: [id])
  Course Course @relation(fields: [courseid], references: [id])

  ToolMonitorSubscriptions ToolMonitorSubscriptions[]

  @@map("tool_monitor_rules")
}

// Table to store user subscriptions to various rules
model ToolMonitorSubscriptions {
  id BigInt @id @default(autoincrement())
  courseid BigInt // Course id of the subscription
  ruleid BigInt // Rule id
  cmid BigInt // Course module id
  userid BigInt // User id of the subscriber
  timecreated BigInt // Timestamp of when this subscription was created
  lastnotificationsent BigInt @default(0) // Timestamp of the time when a notification was last sent for this subscription.
  inactivedate BigInt @default(0)

  Course Course @relation(fields: [courseid], references: [id])
  Rule ToolMonitorRules @relation(fields: [ruleid], references: [id])
  User User @relation(fields: [userid], references: [id])

  ToolMonitorHistory ToolMonitorHistory[]

  @@map("tool_monitor_subscriptions")
}

// Contains the list of policy documents defined on the site.
model ToolPolicy {
  id BigInt @id @default(autoincrement())
  sortorder Int @default(999) // Defines the order in which policies should be presented to users
  currentversionid BigInt? // ID of the current policy version that applies on the site, NULL if the policy does not apply

  Currentversion ToolPolicyVersions? @relation(name: "tool_policy_currentversionid", fields: [currentversionid], references: [id])

  ToolPolicyVersionsByPolicy ToolPolicyVersions[] @relation(name: "tool_policy_versions_policyid")

  @@map("tool_policy")
}

// Tracks users accepting the policy versions
model ToolPolicyAcceptances {
  id BigInt @id @default(autoincrement())
  policyversionid BigInt // ID of the policy document version
  userid BigInt // ID of the user this acceptance is relevant to
  status Boolean? // Acceptance status: 1 - accepted, 0 - not accepted
  lang String @default("") // Code of the language the user had when the policy document was displayed
  usermodified BigInt // ID of the user who last modified the acceptance record
  timecreated BigInt // Timestamp of when the acceptance record was created
  timemodified BigInt // Timestamp of when the acceptance record was last modified
  note String? // Plain text note describing how the actual consent has been obtained if the policy has been accepted on other user's behalf.

  Policyversion ToolPolicyVersions @relation(fields: [policyversionid], references: [id])
  User User @relation(name: "tool_policy_acceptances_userid", fields: [userid], references: [id])
  Usermodified User @relation(name: "tool_policy_acceptances_usermodified", fields: [usermodified], references: [id])

  @@map("tool_policy_acceptances")
}

// Holds versions of the policy documents
model ToolPolicyVersions {
  id BigInt @id @default(autoincrement())
  name String @default("") // Name of the policy document
  type Int @default(0) // Type of the policy: 0 - Site policy, 1 - Privacy policy, 2 - Third party policy, 99 - Other
  audience Int @default(0) // Who is this policy targeted at: 0 - all users, 1 - logged in users only, 2 - guests only
  archived Int @default(0) // Should the version be considered as archived. All non-archived, non-current versions are considered to be drafts.
  usermodified BigInt // ID of the user who last edited this policy document version.
  timecreated BigInt // Timestamp of when the policy version was created.
  timemodified BigInt // Timestamp of when the policy version was last modified.
  policyid BigInt // ID of the policy document we are version of.
  agreementstyle Int @default(0) // How this agreement should flow: 0 - on the consent page, 1 - on a separate page before reaching the consent page.
  optional Int @default(0) // 0 - the policy must be accepted to use the site, 1 - accepting the policy is optional
  revision String @default("") // Human readable version of the policy document
  summary String // Policy text summary
  summaryformat Int // Format of the summary field
  content String // Full policy text
  contentformat Int // Format of the content field

  Usermodified User @relation(fields: [usermodified], references: [id])
  Policy ToolPolicy @relation(name: "tool_policy_versions_policyid", fields: [policyid], references: [id])

  ToolPolicyByCurrentversion ToolPolicy[] @relation(name: "tool_policy_currentversionid")
  ToolPolicyAcceptances ToolPolicyAcceptances[]

  @@map("tool_policy_versions")
}

// A list of items in the category recycle bin
model ToolRecyclebinCategory {
  id BigInt @id @default(autoincrement())
  categoryid BigInt
  shortname String @default("")
  fullname String @default("")
  timecreated BigInt

  Category CourseCategories @relation(fields: [categoryid], references: [id])

  @@map("tool_recyclebin_category")
}

// A list of items in the course recycle bin
model ToolRecyclebinCourse {
  id BigInt @id @default(autoincrement())
  courseid BigInt
  section BigInt
  module BigInt
  name String?
  timecreated BigInt @default(0)

  Course Course @relation(fields: [courseid], references: [id])

  @@map("tool_recyclebin_course")
}

// Steps in an tour
model ToolUsertoursSteps {
  id BigInt @id @default(autoincrement())
  tourid BigInt
  title String? // Title of the step
  content String? // Content of the user tour - allow for multilang tags
  contentformat Int @default(0)
  targettype Int // Type of the target (e.g. block, CSS selector, etc.)
  targetvalue String // The value for the specified target type.
  sortorder BigInt @default(0)
  configdata String

  Tour ToolUsertoursTours @relation(fields: [tourid], references: [id])

  @@map("tool_usertours_steps")
}

// List of tours
model ToolUsertoursTours {
  id BigInt @id @default(autoincrement())
  name String @default("") // Name of the user tour
  description String?
  pathmatch String?
  enabled Boolean @default(false)
  sortorder BigInt @default(0)
  endtourlabel String? // Custom label for the end tour button
  configdata String
  displaystepnumbers Boolean @default(false) // Setting to display step numbers of the tour

  ToolUsertoursSteps ToolUsertoursSteps[]

  @@map("tool_usertours_tours")
}

// Upgrade logging
model UpgradeLog {
  id BigInt @id @default(autoincrement())
  type BigInt // type: 0==info, 1==notice, 2==error
  plugin String?
  version String? // plugin or main version if known
  targetversion String? // version of plugin or core specified in version.php at the time of upgrade loggging
  info String @default("")
  details String?
  backtrace String?
  userid BigInt
  timemodified BigInt

  User User @relation(fields: [userid], references: [id])

  @@map("upgrade_log")
}

// each record is one url resource
model Url {
  id BigInt @id @default(autoincrement())
  course BigInt @default(0)
  name String @default("")
  intro String?
  introformat Int @default(0)
  externalurl String
  display Int @default(0)
  displayoptions String?
  parameters String?
  timemodified BigInt @default(0)

  Course Course @relation(fields: [course], references: [id])

  @@map("url")
}

// One record for each person
model User {
  id BigInt @id @default(autoincrement())
  auth String @default("manual")
  confirmed Boolean @default(false)
  policyagreed Boolean @default(false)
  deleted Boolean @default(false)
  suspended Boolean @default(false) // suspended flag prevents users to log in
  mnethostid BigInt @default(0)
  username String @default("")
  password String @default("")
  idnumber String @default("")
  firstname String @default("")
  lastname String @default("")
  email String @default("")
  emailstop Boolean @default(false)
  phone1 String @default("")
  phone2 String @default("")
  institution String @default("")
  department String @default("")
  address String @default("")
  city String @default("")
  country String @default("")
  lang String @default("en")
  calendartype String @default("gregorian")
  theme String @default("")
  timezone String @default("99")
  firstaccess BigInt @default(0)
  lastaccess BigInt @default(0)
  lastlogin BigInt @default(0)
  currentlogin BigInt @default(0)
  lastip String @default("")
  secret String @default("")
  picture BigInt @default(0) // 0 means no image uploaded, positive values are revisions thta prevent caching problems, negative values are reserved for future use
  description String?
  descriptionformat Int @default(1)
  mailformat Boolean @default(true)
  maildigest Boolean @default(false)
  maildisplay Int @default(2)
  autosubscribe Boolean @default(true)
  trackforums Boolean @default(false)
  timecreated BigInt @default(0)
  timemodified BigInt @default(0)
  trustbitmask BigInt @default(0)
  imagealt String? // alt tag for user uploaded image
  lastnamephonetic String? // Last name phonetic
  firstnamephonetic String? // First name phonetic
  middlename String? // Middle name
  alternatename String? // Alternate name - Useful for three-name countries.
  moodlenetprofile String? // Moodle.net profile information

