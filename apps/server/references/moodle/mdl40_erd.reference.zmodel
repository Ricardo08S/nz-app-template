  issuername String @default("")
  issuerurl String @default("")
  issueremail String @default("")
  claimid String?
  claimcomment String?
  dateissued BigInt @default(0)

  Badge Badge @relation(fields: [badgeid], references: [id])

  @@map("badge_endorsement")
}

// Setting for external badges display
model BadgeExternal {
