  duedate BigInt? // Time by which students must have completed their attempt. Can be null, in which case the assign default is used.
  cutoffdate BigInt? // Time by which students must have completed their attempt. Can be null, in which case the assign default is used.
  timelimit BigInt? // Time limit in seconds. Can be null, in which case the quiz default is used.

  Assign Assign @relation(fields: [assignid], references: [id])
  Group Groups? @relation(fields: [groupid], references: [id])
  User User? @relation(fields: [userid], references: [id])

  @@map("assign_overrides")
}

