// The overrides to assign settings.
model AssignOverrides {
  id BigInt @id @default(autoincrement())
  assignid BigInt @default(0) // Foreign key references assign.id
  groupid BigInt? // Foreign key references groups.id. Can be null if this is a per-user override.
