// To store the backup_controllers as they are used
model BackupControllers {
  id BigInt @id @default(autoincrement())
  backupid String @default("") @unique // unique id of the backup
  operation String @default("backup") // Type of operation (backup/restore)
  type String @default("") // Type of the backup (activity/section/course)
  itemid BigInt // id of the module/section/activity being backup
  format String @default("") // format of the backup (moodle/imscc...)
  interactive Int // is the backup interactive (1-yes/0-no)
  purpose Int // purpose (target) of the backup (general, import, hub...)
  userid BigInt // user that owns/performs the backup
  status Int // current status of the backup (configured, ui, running...)
  execution Int // type of execution (immediate/delayed)
  executiontime BigInt // epoch secs when the backup should be executed (for delayed backups only)
  checksum String @default("") // checksum of the backup_controller object
  timecreated BigInt // time the controller was created
  timemodified BigInt // last time the controller was modified
  progress Decimal @default(0.0) // The backup or restore progress as a floating point number
  controller String // serialised backup_controller object

  User User @relation(fields: [userid], references: [id])

  BackupLogs BackupLogs[]

  @@map("backup_controllers")
}

