  visible Boolean @default(false)
  issuernotified BigInt?

  Badge Badge @relation(fields: [badgeid], references: [id])
  User User @relation(fields: [userid], references: [id])

  BadgeCriteriaMet BadgeCriteriaMet[]

  @@map("badge_issued")
