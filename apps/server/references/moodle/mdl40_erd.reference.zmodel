  backpackid BigInt // ID of a backpack
  collectionid BigInt // Badge collection id in the backpack
  entityid String?
  assertion String? // Assertion of external badge

  Backpack BadgeBackpack @relation(fields: [backpackid], references: [id])

  @@map("badge_external")
}

// Defines settings for site level backpacks that a user can co
model BadgeExternalBackpack {
