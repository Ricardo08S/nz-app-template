  backpackweburl String @default("")
  apiversion String @default("1.0")
  sortorder BigInt @default(0)
  oauth2_issuerid BigInt? // OAuth 2 Issuer

  Oauth2Issuer Oauth2Issuer? @relation(fields: [oauth2_issuerid], references: [id])

  BadgeBackpack BadgeBackpack[]
  BadgeBackpackOauth2 BadgeBackpackOauth2[]

  @@map("badge_external_backpack")
}

