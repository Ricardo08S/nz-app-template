  issuerid BigInt
  externalbackpackid BigInt
  token String
  refreshtoken String
  expires BigInt?
  scope String?

  Usermodified User @relation(name: "badge_backpack_oauth2_usermodified", fields: [usermodified], references: [id])
  User User @relation(name: "badge_backpack_oauth2_userid", fields: [userid], references: [id])
  Issuer Oauth2Issuer @relation(fields: [issuerid], references: [id])
  Externalbackpack BadgeExternalBackpack @relation(fields: [externalbackpackid], references: [id])

  @@map("badge_backpack_oauth2")
}

// Defines criteria for issuing badges
model BadgeCriteria {
  id BigInt @id @default(autoincrement())
  badgeid BigInt @default(0)
  criteriatype BigInt? // The criteria type we are aggregating
  method Boolean @default(true) // 1 = all, 2 = any
  description String?
  descriptionformat Int @default(0)

  Badge Badge @relation(fields: [badgeid], references: [id])

  BadgeCriteriaMet BadgeCriteriaMet[]
  BadgeCriteriaParam BadgeCriteriaParam[]

  @@map("badge_criteria")
}

// Defines criteria that were met for an issued badge
model BadgeCriteriaMet {
  id BigInt @id @default(autoincrement())
  issuedid BigInt?
  critid BigInt
  userid BigInt
  datemet BigInt

  Issued BadgeIssued? @relation(fields: [issuedid], references: [id])
  Crit BadgeCriteria @relation(fields: [critid], references: [id])
  User User @relation(fields: [userid], references: [id])

  @@map("badge_criteria_met")
}

// Defines parameters for badges criteria
model BadgeCriteriaParam {
  id BigInt @id @default(autoincrement())
  critid BigInt
  name String @default("")
  value String?

  Crit BadgeCriteria @relation(fields: [critid], references: [id])

  @@map("badge_criteria_param")
}

// Defines endorsement for badge
model BadgeEndorsement {
