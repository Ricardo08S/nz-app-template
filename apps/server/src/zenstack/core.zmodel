import './app'

type ID {
  id String @id @default(cuid())
}

type Timestamps {
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

type Base with ID, Timestamps {
}

type AuthInfo {
  id          String
  username    String
  role        Role
  name        String?
  email       String?
  image       String?
  permissions String[]

  @@auth
}

enum Role {
  ADMIN
  USER
}

model RolePermission {
  role        Role     @id
  permissions String[]
}

model User with Base {
  username             String                 @unique
  passwordHash         String                 @allow('all', auth().id == id || auth().role == ADMIN)
  name                 String
  email                String?
  role                 Role
  permissions          String[]               @default([])

  oidc_issuer          String?                @allow('all', auth().id == id || auth().role == ADMIN)
  oidc_userInfo        Json?                  @allow('all', auth().id == id || auth().role == ADMIN)
  oidc_sub             String?                @unique

  RefreshToken         RefreshToken[]
  File                 File[]
  QuizAttempt          QuizAttempt[]
  ClassMember          ClassMember[]
  AssignmentSubmission AssignmentSubmission[]
  AssessmentScore      AssessmentScore[]
  ClassContentComment  ClassContentComment[]
  Report               Report[]

  @@allow('read', true)
  @@allow('create', auth().role == ADMIN)
  @@allow('all', auth().id == id || auth().role == ADMIN)
}

enum FileStatus {
  PENDING
  UPLOADED
  FAILED
}

model File with Timestamps {
  key                  String                 @id

  userId               String
  User                 User                   @relation(fields: [userId], references: [id])

  originalFilename     String
  filename             String
  contentType          String
  size                 Int?
  status               FileStatus

  AssignmentSubmission AssignmentSubmission[]
  Report               Report[]
  ClassAsset           ClassAsset[]

  @@allow('read', true)
  @@allow('all', auth().id == userId)
}

model RefreshToken with Base {
  userId  String
  User    User    @relation(fields: [userId], references: [id])

  revoked Boolean

  @@deny('all', true)
}
