# Required. APP_NAME feeds the bucket name, database name and deploy domains.
# Replace the "nz-app-template" placeholder throughout this template with your project's
# real name before using it for anything beyond local experimentation.
APP_NAME="nz-app-template"
APP_ENV="development"

DATABASE_URL="postgresql://postgres:nz-app-template-password-default@localhost:5432/$APP_NAME-$APP_ENV"
JWT_ACCESS_KEY="localonly--JlYkjj-cmXz9L-H0Hg2ADdGrMm2KkLpYROcHl9JUqQRb_k14XZGU6FzbTq1NH7qx3G4FBm33XEe7kQCLCPaS"
JWT_REFRESH_KEY="localonly--f12klowKsjZDtqRyE3KtHEe1e2O5njSK9mxjmt-cyMwSALL_JkxODp2SyHkcCxxnGv7bAn3YXbyiT3E_BO_5"
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="<AWS_ACCESS_KEY_ID>"
AWS_SECRET_ACCESS_KEY="<AWS_SECRET_ACCESS_KEY>"
AWS_S3_BUCKET="$APP_NAME-$APP_ENV"
# Signed operations. Must be the same host the browser uses: SigV4 binds to it.
AWS_S3_ENDPOINT="http://127.0.0.1:3900"
# Anonymous reads. Garage takes the bucket from the first label of the host.
PUBLIC_S3_ENDPOINT="http://$APP_NAME-$APP_ENV.web.localhost:3902"

# Values are expanded at load, so a literal $ inside a secret gets truncated.
# Generate secrets without one.

# Optional. Leave the four unset to run without OIDC login.
OIDC_ISSUER="https://your-oidc-provider.example.com/application/o/$APP_NAME/"
OIDC_CLIENT_ID="<OIDC_CLIENT_ID>"
OIDC_CLIENT_SECRET="<OIDC_CLIENT_SECRET>"
OIDC_REDIRECT_URI="http://localhost:5173/auth/callback"

# Optional. Unset means no log shipping.
# LOKI_URL="http://localhost:3100"
